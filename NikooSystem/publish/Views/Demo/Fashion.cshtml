@{
    Layout = null;
    var product = (NikooSystem.Models.Product)ViewBag.Product;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>دمو فروشگاه پوشاک - @product.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <style>
        body { font-family: Tahoma, sans-serif; background: #faf7f5; }
        .demo-banner { background: #1a1a1a; color: #fff; padding: .7rem 1rem; position: sticky; top: 0; z-index: 50; }
        .hero-demo { background: linear-gradient(120deg, #2c1810, #8b4513); color: #fff; padding: 4rem 0; }
        .item-card { background: #fff; border: none; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,.06); }
        .item-card img { height: 220px; object-fit: cover; width: 100%; }
        .price { color: #8b4513; font-weight: 700; }
    </style>
</head>
<body>
    <div class="demo-banner d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>این یک <strong>دمو فروشگاه آنلاین پوشاک</strong> است — محصول: @product.Title</span>
        <div>
            <a class="btn btn-sm btn-light" href="@Url.Action("Details","Products", new { id = product.Id })">جزئیات محصول</a>
            <a class="btn btn-sm btn-warning" href="@Url.Action("Buy","Checkout", new { productId = product.Id })">درخواست دمو این نرم‌افزار</a>
        </div>
    </div>
    <section class="hero-demo">
        <div class="container">
            <h1>Boutique Mode</h1>
            <p class="mb-0">نمونه فروشگاه پوشاک با دسته‌بندی، کارت محصول و سبد خرید نمایشی</p>
        </div>
    </section>
    <section class="py-5">
        <div class="container">
            <div class="row g-4">
                @{
                    var items = new[] {
                        new { t = "مانتو بهاره", p = "۱٬۲۸۰٬۰۰۰", img = "/Assets/img/portfolio/portfolio-1.jpg" },
                        new { t = "کفش اسپرت", p = "۹۸۰٬۰۰۰", img = "/Assets/img/portfolio/portfolio-7.jpg" },
                        new { t = "کیف چرمی", p = "۱٬۵۵۰٬۰۰۰", img = "/Assets/img/portfolio/portfolio-8.jpg" },
                        new { t = "شلوار جین", p = "۷۵۰٬۰۰۰", img = "/Assets/img/portfolio/portfolio-9.jpg" }
                    };
                }
                @foreach (var item in items)
                {
                    <div class="col-md-3 col-6">
                        <div class="item-card">
                            <img src="@item.img" alt="@item.t">
                            <div class="p-3">
                                <h6>@item.t</h6>
                                <div class="price">@item.p تومان</div>
                                <button class="btn btn-sm btn-dark mt-2 w-100" type="button">افزودن به سبد (دمو)</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-5">
                <a class="btn btn-lg btn-warning" href="@Url.Action("Buy","Checkout", new { productId = product.Id })">درخواست دمو این فروشگاه</a>
            </div>
        </div>
    </section>
</body>
</html>
