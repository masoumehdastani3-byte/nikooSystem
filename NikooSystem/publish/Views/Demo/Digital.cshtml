@{
    Layout = null;
    var product = (NikooSystem.Models.Product)ViewBag.Product;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>دمو فروشگاه دیجیتال - @product.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <style>
        body { font-family: Tahoma, sans-serif; background: #0f172a; color: #e2e8f0; }
        .demo-banner { background: #312e81; color: #fff; padding: .7rem 1rem; position: sticky; top: 0; z-index: 50; }
        .item-card { background: #1e293b; border-radius: 14px; padding: 1.25rem; height: 100%; border: 1px solid #334155; }
        .price { color: #a5b4fc; font-weight: 700; }
    </style>
</head>
<body>
    <div class="demo-banner d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>دمو <strong>فروشگاه محصولات دیجیتال</strong> — @product.Title</span>
        <div>
            <a class="btn btn-sm btn-light" href="@Url.Action("Details","Products", new { id = product.Id })">جزئیات</a>
            <a class="btn btn-sm btn-warning" href="@Url.Action("Buy","Checkout", new { productId = product.Id })">درخواست دمو</a>
        </div>
    </div>
    <div class="container py-5">
        <h2 class="mb-4">Digital Market</h2>
        <div class="row g-4">
            @{
                var items = new[] {
                    new { t = "قالب وردپرس فروشگاهی", p = "۳۹۰٬۰۰۰" },
                    new { t = "پکیج آیکون UI", p = "۱۹۰٬۰۰۰" },
                    new { t = "دوره آموزش ASP.NET", p = "۱٬۲۰۰٬۰۰۰" },
                    new { t = "لایسنس افزونه SEO", p = "۴۵۰٬۰۰۰" }
                };
            }
            @foreach (var item in items)
            {
                <div class="col-md-3 col-6">
                    <div class="item-card">
                        <div class="mb-3 display-6">💾</div>
                        <h6>@item.t</h6>
                        <div class="price mb-3">@item.p تومان</div>
                        <button class="btn btn-sm btn-outline-light w-100" type="button">دانلود پس از خرید (دمو)</button>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-5">
            <a class="btn btn-lg btn-warning" href="@Url.Action("Buy","Checkout", new { productId = product.Id })">درخواست دمو این پلتفرم</a>
        </div>
    </div>
</body>
</html>
