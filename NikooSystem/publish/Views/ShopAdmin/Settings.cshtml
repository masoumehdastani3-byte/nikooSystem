@model NikooSystem.Models.Store.StoreSettings
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "تنظیمات فروشگاه";
    var company = (string)ViewBag.CompanyCode;
}
<h2 class="mb-4">اطلاعات و ظاهر فروشگاه + درگاه پرداخت</h2>
@using (Html.BeginForm("Settings", "ShopAdmin", new { company }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">نام فروشگاه</label>@Html.TextBoxFor(m => m.StoreName, new { @class = "form-control" })</div>
        <div class="col-md-6"><label class="form-label">شعار</label>@Html.TextBoxFor(m => m.Tagline, new { @class = "form-control" })</div>
        <div class="col-12"><label class="form-label">درباره فروشگاه</label>@Html.TextAreaFor(m => m.About, 3, 1, new { @class = "form-control" })</div>
        <div class="col-md-4"><label class="form-label">تلفن</label>@Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })</div>
        <div class="col-md-4"><label class="form-label">ایمیل</label>@Html.TextBoxFor(m => m.Email, new { @class = "form-control" })</div>
        <div class="col-md-4"><label class="form-label">آدرس</label>@Html.TextBoxFor(m => m.Address, new { @class = "form-control" })</div>
        <div class="col-md-6"><label class="form-label">عنوان هیرو</label>@Html.TextBoxFor(m => m.HeroTitle, new { @class = "form-control" })</div>
        <div class="col-md-6"><label class="form-label">زیرعنوان هیرو</label>@Html.TextBoxFor(m => m.HeroSubtitle, new { @class = "form-control" })</div>
        <div class="col-md-6"><label class="form-label">تصویر هیرو (URL)</label>@Html.TextBoxFor(m => m.HeroImageUrl, new { @class = "form-control" })</div>
        <div class="col-md-3"><label class="form-label">رنگ اصلی</label><input class="form-control form-control-color w-100" type="color" name="PrimaryColor" id="PrimaryColor" value="@Model.PrimaryColor" /></div>
        <div class="col-md-3"><label class="form-label">رنگ فرعی</label><input class="form-control form-control-color w-100" type="color" name="SecondaryColor" id="SecondaryColor" value="@Model.SecondaryColor" /></div>
        <div class="col-md-8"><label class="form-label">متن فوتر</label>@Html.TextBoxFor(m => m.FooterText, new { @class = "form-control" })</div>

        <div class="col-12"><hr /><h5>قالب ظاهری فروشگاه</h5>
            <p class="text-muted small">یکی از قالب‌های آماده را انتخاب کنید. در صورت نیاز رنگ‌ها را هم دستی تغییر دهید.</p>
        </div>
        <div class="col-12">
            <input type="hidden" name="LayoutStyle" id="LayoutStyle" value="@NikooSystem.Helpers.StoreTemplates.Normalize(Model.LayoutStyle)" />
            <div class="template-grid">
                @foreach (var t in NikooSystem.Helpers.StoreTemplates.All)
                {
                    var active = NikooSystem.Helpers.StoreTemplates.Normalize(Model.LayoutStyle) == t.Id;
                    <label class="template-card @(active ? "active" : "")" data-id="@t.Id" data-primary="@t.PrimaryColor" data-secondary="@t.SecondaryColor">
                        <input type="radio" name="templatePick" value="@t.Id" @(active ? "checked" : null) />
                        <div class="template-preview">
                            <div class="bar" style="background:@t.PreviewGradient"></div>
                            <div class="body">
                                <div class="block"></div>
                                <div class="block"></div>
                            </div>
                        </div>
                        <div class="template-meta">
                            <strong>@t.Name</strong>
                            <span>@t.Description</span>
                        </div>
                    </label>
                }
            </div>
        </div>

        <div class="col-12"><hr /><h5>شبکه‌های اجتماعی</h5>
            <p class="text-muted small mb-0">لینک کامل هر شبکه را وارد کنید تا در فوتر نمایش داده شود.</p>
        </div>
        <div class="col-md-6"><label class="form-label">اینستاگرام</label>@Html.TextBoxFor(m => m.InstagramUrl, new { @class = "form-control", placeholder = "https://instagram.com/...", dir = "ltr" })</div>
        <div class="col-md-6"><label class="form-label">تلگرام</label>@Html.TextBoxFor(m => m.TelegramUrl, new { @class = "form-control", placeholder = "https://t.me/...", dir = "ltr" })</div>
        <div class="col-md-6"><label class="form-label">واتساپ</label>@Html.TextBoxFor(m => m.WhatsAppUrl, new { @class = "form-control", placeholder = "https://wa.me/98912...", dir = "ltr" })</div>
        <div class="col-md-6"><label class="form-label">لینکدین</label>@Html.TextBoxFor(m => m.LinkedInUrl, new { @class = "form-control", placeholder = "https://linkedin.com/...", dir = "ltr" })</div>
        <div class="col-md-6"><label class="form-label">توییتر / X</label>@Html.TextBoxFor(m => m.TwitterUrl, new { @class = "form-control", placeholder = "https://x.com/...", dir = "ltr" })</div>
        <div class="col-md-6"><label class="form-label">فیسبوک</label>@Html.TextBoxFor(m => m.FacebookUrl, new { @class = "form-control", placeholder = "https://facebook.com/...", dir = "ltr" })</div>
        <div class="col-md-6"><label class="form-label">آپارات</label>@Html.TextBoxFor(m => m.AparatUrl, new { @class = "form-control", placeholder = "https://aparat.com/...", dir = "ltr" })</div>
        <div class="col-md-6"><label class="form-label">یوتیوب</label>@Html.TextBoxFor(m => m.YouTubeUrl, new { @class = "form-control", placeholder = "https://youtube.com/...", dir = "ltr" })</div>

        <div class="col-12"><hr /><h5>اینماد</h5>
            <p class="text-muted small">کد HTML اینماد را از پنل enamad.ir کپی و اینجا قرار دهید. در فوتر سایت نمایش داده می‌شود.</p>
        </div>
        <div class="col-12">
            <label class="form-label">کد تگ اینماد</label>
            @Html.TextAreaFor(m => m.EnamadHtml, 6, 1, new { @class = "form-control", dir = "ltr", style = "font-family:Consolas,monospace;font-size:13px;", placeholder = "<a referrerpolicy=\"origin\" target=\"_blank\" href=\"https://trustseal.enamad.ir/...\"><img ... /></a>" })
        </div>

        <div class="col-12"><hr /><h5>درگاه پرداخت</h5></div>
        <div class="col-md-6"><label class="form-label">MerchantId</label>@Html.TextBoxFor(m => m.ZarinPalMerchantId, new { @class = "form-control" })</div>
        <div class="col-md-3 form-check mt-4 pt-2">
            <input class="form-check-input" type="checkbox" name="ZarinPalSandbox" value="true" @(Model.ZarinPalSandbox?"checked":"") />
            <input type="hidden" name="ZarinPalSandbox" value="false" />
            <label class="form-check-label">حالت تست (Sandbox)</label>
        </div>
        <div class="col-md-3 form-check mt-4 pt-2">
            <input class="form-check-input" type="checkbox" name="EnablePayment" value="true" @(Model.EnablePayment?"checked":"") />
            <input type="hidden" name="EnablePayment" value="false" />
            <label class="form-check-label">فعال بودن پرداخت</label>
        </div>
        <div class="col-12"><hr /><h5>مدیر فروشگاه</h5></div>
        <div class="col-md-4"><label class="form-label">نام کاربری ادمین</label>@Html.TextBoxFor(m => m.AdminUsername, new { @class = "form-control" })</div>
        <div class="col-md-4"><label class="form-label">رمز جدید (اختیاری)</label><input class="form-control" type="password" name="newPassword" /></div>
        <div class="col-12"><button class="btn-store" type="submit">ذخیره تنظیمات</button></div>
    </div>
}

@section scripts {
<link href="~/Content/storefront-themes.css" rel="stylesheet" />
<script>
(function () {
  var cards = document.querySelectorAll('.template-card');
  var hidden = document.getElementById('LayoutStyle');
  var primary = document.getElementById('PrimaryColor');
  var secondary = document.getElementById('SecondaryColor');
  cards.forEach(function (card) {
    card.addEventListener('click', function () {
      cards.forEach(function (c) { c.classList.remove('active'); });
      card.classList.add('active');
      var id = card.getAttribute('data-id');
      hidden.value = id;
      var radio = card.querySelector('input[type=radio]');
      if (radio) radio.checked = true;
      if (primary) primary.value = card.getAttribute('data-primary');
      if (secondary) secondary.value = card.getAttribute('data-secondary');
    });
  });
})();
</script>
}
