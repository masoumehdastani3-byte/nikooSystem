@model IEnumerable<NikooSystem.Models.Store.StoreOrder>
@using NikooSystem.Helpers
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "سفارش‌ها";
    var company = (string)ViewBag.CompanyCode;
}
<h2 class="mb-3">سفارش‌ها</h2>
<div class="panel-card">
<table class="table">
    <thead><tr><th>شماره</th><th>مشتری</th><th>مبلغ</th><th>وضعیت</th><th>تغییر وضعیت</th></tr></thead>
    <tbody>
    @foreach (var o in Model)
    {
        <tr>
            <td>@o.OrderNumber</td>
            <td>@o.CustomerName<br /><small>@o.CustomerMobile</small></td>
            <td>@o.Amount.ToToman()</td>
            <td>@o.Status</td>
            <td>
                @using (Html.BeginForm("UpdateOrderStatus", "ShopAdmin", new { company }, FormMethod.Post, new { @class = "d-flex gap-1" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@o.Id" />
                    <select class="form-select form-select-sm" name="status">
                        @foreach (NikooSystem.Models.Store.StoreOrderStatus s in Enum.GetValues(typeof(NikooSystem.Models.Store.StoreOrderStatus)))
                        {
                            <option value="@s" @(o.Status == s ? "selected" : "")>@s</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-dark" type="submit">OK</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
