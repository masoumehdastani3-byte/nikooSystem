@model NikooSystem.Models.Store.StoreAttributeDef
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = Model.Id > 0 ? "ویرایش خصوصیت" : "خصوصیت جدید";
    var company = (string)ViewBag.CompanyCode;
    var cats = (IEnumerable<NikooSystem.Models.Store.StoreCategory>)ViewBag.Categories;
    var selected = new HashSet<int>(Model.CategoryIds ?? new List<int>());
}
<h2 class="mb-3">@ViewBag.Title</h2>
@using (Html.BeginForm("SaveAttribute", "ShopAdmin", new { company }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="panel-card row g-3">
        <div class="col-md-6"><label class="form-label">نام</label>@Html.TextBoxFor(m => m.Name, new { @class = "form-control" })</div>
        <div class="col-md-6">
            <label class="form-label">نوع</label>
            <select class="form-select" name="InputType">
                <option value="text" @(Model.InputType=="text"?"selected":"")>متن</option>
                <option value="number" @(Model.InputType=="number"?"selected":"")>عدد</option>
                <option value="select" @(Model.InputType=="select"?"selected":"")>انتخابی</option>
            </select>
        </div>
        <div class="col-md-8"><label class="form-label">گزینه‌ها (با کاما برای نوع انتخابی)</label>@Html.TextBoxFor(m => m.Options, new { @class = "form-control", placeholder = "S,M,L" })</div>
        <div class="col-md-4"><label class="form-label">ترتیب</label>@Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number" })</div>
        <div class="col-12 form-check"><label><input type="checkbox" name="IsFilterable" value="true" @(Model.IsFilterable?"checked":"") /> قابل فیلتر در فروشگاه</label><input type="hidden" name="IsFilterable" value="false" /></div>
        <div class="col-12">
            <label class="form-label">اتصال به گروه‌های کالا</label>
            <div class="border rounded p-3" style="max-height:220px;overflow:auto;">
                <div class="text-muted small mb-2">اگر هیچ گروهی انتخاب نشود، خصوصیت برای همه گروه‌ها نمایش داده می‌شود.</div>
                @foreach (var c in cats.OrderBy(x => x.SortOrder))
                {
                    <div class="form-check">
                        <label class="form-check-label">
                            <input class="form-check-input" type="checkbox" name="categoryIds" value="@c.Id" @(selected.Contains(c.Id) ? "checked" : null) />
                            @(c.ParentId.HasValue ? "— " : "")@c.Title
                        </label>
                    </div>
                }
            </div>
        </div>
        <div class="col-12">
            <button class="btn-store" type="submit">ذخیره</button>
            <a class="btn-outline-store" href="@Url.Action("Attributes","ShopAdmin", new { company })">بازگشت</a>
        </div>
    </div>
}
