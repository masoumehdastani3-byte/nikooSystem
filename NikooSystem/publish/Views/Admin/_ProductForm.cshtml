@model NikooSystem.Models.Product
<div class="row g-3 mb-3">
    <div class="col-md-8">
        @Html.LabelFor(m => m.Title)
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.Price)
        @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number" })
        @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-6">
        @Html.LabelFor(m => m.Category)
        @Html.TextBoxFor(m => m.Category, new { @class = "form-control", placeholder = "مثلاً فروشگاه آنلاین" })
    </div>
    <div class="col-md-6">
        @Html.LabelFor(m => m.DemoSlug)
        @Html.TextBoxFor(m => m.DemoSlug, new { @class = "form-control", placeholder = "fashion / grocery / digital" })
    </div>
    <div class="col-12">
        @Html.LabelFor(m => m.ShortDescription)
        @Html.TextBoxFor(m => m.ShortDescription, new { @class = "form-control" })
    </div>
    <div class="col-12">
        @Html.LabelFor(m => m.Description)
        @Html.TextAreaFor(m => m.Description, 5, 1, new { @class = "form-control" })
    </div>
    <div class="col-md-6">
        @Html.LabelFor(m => m.ImageUrl)
        @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", placeholder = "/Assets/img/..." })
    </div>
    <div class="col-md-6">
        <label>آپلود تصویر جدید</label>
        <input type="file" name="imageFile" class="form-control" accept="image/*" />
    </div>
    <div class="col-md-3 form-check mt-4">
        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
        @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
    </div>
    <div class="col-md-3 form-check mt-4">
        @Html.CheckBoxFor(m => m.IsFeatured, new { @class = "form-check-input" })
        @Html.LabelFor(m => m.IsFeatured, new { @class = "form-check-label" })
    </div>
</div>
