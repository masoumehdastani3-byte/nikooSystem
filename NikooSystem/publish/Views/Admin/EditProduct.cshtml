@model NikooSystem.Models.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "ویرایش محصول";
}
<h2 class="mb-3">ویرایش محصول</h2>
<div class="card border-0 shadow-sm p-4">
    @using (Html.BeginForm("EditProduct", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.Partial("_ProductForm", Model)
        <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
        <a href="@Url.Action("Products","Admin")" class="btn btn-link">انصراف</a>
    }
</div>
