@model NikooSystem.Models.ContactViewModel
@{
    ViewBag.Title = "تماس با ما";
    ViewBag.Nav = "contact";
}
<main id="main">
    <div class="page-hero">
        <div class="container">
            <h1>تماس با ما</h1>
            <p class="text-muted">سوالی دارید؟ پیام بگذارید</p>
        </div>
    </div>
    <section class="contact">
        <div class="container">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            <div class="row gy-4">
                <div class="col-lg-5">
                    <div class="info-box mb-3"><i class="bi bi-geo-alt"></i><h3>آدرس</h3><p>تهران، نارمک، فرجام شرقی</p></div>
                    <div class="info-box mb-3"><i class="bi bi-telephone"></i><h3>تلفن</h3><p>۰۲۱-۷۷۰۰۰۰۰۰</p></div>
                    <div class="info-box"><i class="bi bi-envelope"></i><h3>ایمیل</h3><p>info@nikoooo.ir</p></div>
                </div>
                <div class="col-lg-7">
                    <div class="inner-card">
                        @using (Html.BeginForm("Contact", "Home", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="row gy-3">
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.Name)
                                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "نام و نام خانوادگی" })
                                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.Email)
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "ایمیل" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-12">
                                    @Html.LabelFor(m => m.Subject)
                                    @Html.TextBoxFor(m => m.Subject, new { @class = "form-control", placeholder = "موضوع" })
                                    @Html.ValidationMessageFor(m => m.Subject, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-12">
                                    @Html.LabelFor(m => m.Message)
                                    @Html.TextAreaFor(m => m.Message, 5, 1, new { @class = "form-control", placeholder = "پیام" })
                                    @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn-primary-shop">ارسال پیام</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
@section scripts {
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}