@model IEnumerable<NikooSystem.Models.Store.StoreMenuItem>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "منوها";
    var company = (string)ViewBag.CompanyCode;
}
<div class="d-flex justify-content-between mb-3">
    <h2>منوی درختی</h2>
    <a class="btn-store" href="@Url.Action("EditMenu","ShopAdmin", new { company })">آیتم جدید</a>
</div>
<div class="panel-card">
    <table class="table">
        <thead><tr><th>عنوان</th><th>محل</th><th>لینک</th><th>والد</th><th></th></tr></thead>
        <tbody>
        @foreach (var m in Model.OrderBy(x => x.Location).ThenBy(x => x.SortOrder))
        {
            var parent = Model.FirstOrDefault(p => p.Id == m.ParentId);
            <tr>
                <td>@(m.ParentId.HasValue ? "— " : "")@m.Title</td>
                <td>@m.Location</td>
                <td class="small">@m.Url</td>
                <td>@(parent?.Title ?? "—")</td>
                <td class="text-nowrap">
                    <a href="@Url.Action("EditMenu","ShopAdmin", new { company, id = m.Id })">ویرایش</a>
                    @using (Html.BeginForm("DeleteMenu", "ShopAdmin", new { company }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('حذف شود؟');" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@m.Id" />
                        <button class="btn btn-link text-danger p-0" type="submit">حذف</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
