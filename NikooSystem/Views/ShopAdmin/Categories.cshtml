@model IEnumerable<NikooSystem.Models.Store.StoreCategory>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "گروه‌های محصول";
    var company = (string)ViewBag.CompanyCode;
}
<div class="d-flex justify-content-between mb-3">
    <h2>گروه‌های محصول (درختی)</h2>
    <a class="btn-store" href="@Url.Action("EditCategory","ShopAdmin", new { company })">گروه جدید</a>
</div>
<div class="panel-card">
    <table class="table align-middle">
        <thead><tr><th>عنوان</th><th>والد</th><th>اسلاگ</th><th>ترتیب</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model.OrderBy(x => x.SortOrder))
        {
            var parent = Model.FirstOrDefault(p => p.Id == c.ParentId);
            <tr>
                <td>@(c.ParentId.HasValue ? "— " : "")@c.Title</td>
                <td>@(parent?.Title ?? "—")</td>
                <td>@c.Slug</td>
                <td>@c.SortOrder</td>
                <td class="text-nowrap">
                    <a href="@Url.Action("EditCategory","ShopAdmin", new { company, id = c.Id })">ویرایش</a>
                    @using (Html.BeginForm("DeleteCategory", "ShopAdmin", new { company }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('حذف این گروه و زیرمجموعه‌ها؟');" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <button class="btn btn-link text-danger p-0" type="submit">حذف</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
