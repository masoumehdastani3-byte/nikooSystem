@model NikooSystem.Models.Order
@using NikooSystem.Helpers
@{
    ViewBag.Title = "پرداخت موفق";
    ViewBag.Nav = "products";
}
<main id="main">
    <div class="page-hero">
        <div class="container text-center">
            <div class="success-icon"><i class="bi bi-check-circle"></i></div>
            <h1>پرداخت با موفقیت انجام شد</h1>
            <p class="text-muted">سفارش شما ثبت شد و تیم نیکو سیستم آفرین به‌زودی با شما تماس می‌گیرد</p>
        </div>
    </div>
    <section class="pb-5">
        <div class="container" style="max-width:640px;">
            <div class="checkout-box">
                <div class="d-flex justify-content-between mb-2"><span>شماره سفارش</span><strong>@Model.OrderNumber</strong></div>
                <div class="d-flex justify-content-between mb-2"><span>محصول</span><strong>@Model.ProductTitle</strong></div>
                <div class="d-flex justify-content-between mb-2"><span>مبلغ</span><strong>@Model.Amount.ToToman()</strong></div>
                <div class="d-flex justify-content-between mb-2"><span>کد پیگیری</span><strong>@(Model.RefId?.ToString() ?? "-")</strong></div>
                <div class="d-flex justify-content-between"><span>وضعیت</span><span class="badge @Model.Status.StatusBadgeClass()">@Model.Status.StatusText()</span></div>
                <hr />
                <a href="@Url.Action("Index","Home")" class="btn-primary-shop">بازگشت به خانه</a>
            </div>
        </div>
    </section>
</main>
