@model NikooSystem.Models.PayStartViewModel
@using NikooSystem.Helpers
@{
    ViewBag.Title = "پرداخت آنلاین";
    ViewBag.Nav = "";
    var payment = Model.Payment;
    var hasCustomer = !string.IsNullOrWhiteSpace(payment.CustomerName)
        && !string.IsNullOrWhiteSpace(payment.CustomerMobile)
        && !string.IsNullOrWhiteSpace(payment.CustomerEmail);
}
<main id="main">
    <div class="page-hero">
        <div class="container">
            <h1>پرداخت آنلاین</h1>
            <p class="text-muted">مبلغ و جزئیات را بررسی کنید و پرداخت را تکمیل کنید</p>
        </div>
    </div>
    <section class="pb-5">
        <div class="container" style="max-width:720px;">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            <div class="checkout-box mb-4">
                <h5 class="mb-3">جزئیات پرداخت</h5>
                <div class="d-flex justify-content-between mb-2"><span>شرح</span><strong>@payment.Description</strong></div>
                <div class="d-flex justify-content-between mb-2"><span>مبلغ</span><strong class="price">@payment.Amount.ToToman()</strong></div>
                @if (!string.IsNullOrWhiteSpace(payment.ExternalRef))
                {
                    <div class="d-flex justify-content-between"><span>کد پیگیری شما</span><strong>@payment.ExternalRef</strong></div>
                }
            </div>

            @if (hasCustomer)
            {
                <div class="checkout-box">
                    <h5 class="mb-3">اطلاعات پرداخت‌کننده</h5>
                    <div class="mb-2"><span class="text-muted">نام:</span> @payment.CustomerName</div>
                    <div class="mb-2"><span class="text-muted">موبایل:</span> @payment.CustomerMobile</div>
                    <div class="mb-3"><span class="text-muted">ایمیل:</span> @payment.CustomerEmail</div>
                    @using (Html.BeginForm("Confirm", "Pay", new { token = payment.Token }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-primary-shop">
                            <i class="bi bi-credit-card"></i> ادامه و پرداخت
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="checkout-box">
                    <h5 class="mb-3">اطلاعات پرداخت‌کننده</h5>
                    @using (Html.BeginForm("Start", "Pay", new { token = payment.Token }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row gy-3">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.CustomerName)
                                @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.CustomerMobile)
                                @Html.TextBoxFor(m => m.CustomerMobile, new { @class = "form-control", placeholder = "09121234567" })
                                @Html.ValidationMessageFor(m => m.CustomerMobile, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-12">
                                @Html.LabelFor(m => m.CustomerEmail)
                                @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn-primary-shop">
                                    <i class="bi bi-credit-card"></i> ادامه و پرداخت
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</main>
