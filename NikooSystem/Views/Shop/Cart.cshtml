@model IEnumerable<NikooSystem.Models.Store.StoreCartItem>
@using NikooSystem.Helpers
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = "سبد خرید";
    var company = (string)ViewBag.CompanyCode;
    var items = Model?.ToList() ?? new List<NikooSystem.Models.Store.StoreCartItem>();
    var total = items.Sum(x => x.UnitPrice * x.Quantity);
    var count = items.Sum(x => x.Quantity);
}
<section class="cart-page">
    <div class="container">
        <div class="cart-head">
            <div>
                <h1 class="section-title mb-1">سبد خرید</h1>
                @if (items.Any())
                {
                    <p class="cart-head-sub">@count قلم کالا در سبد شماست</p>
                }
            </div>
            <a class="cart-link-back" href="@Url.Action("Catalog","Shop", new { company })">
                <i class="bi bi-arrow-right"></i> ادامه خرید
            </a>
        </div>

        @if (!items.Any())
        {
            <div class="cart-empty">
                <div class="cart-empty-icon"><i class="bi bi-bag-x"></i></div>
                <h2>سبد خرید خالی است</h2>
                <p>هنوز محصولی اضافه نکرده‌اید. از فروشگاه دیدن کنید و خرید را شروع کنید.</p>
                <a class="btn-store" href="@Url.Action("Catalog","Shop", new { company })">
                    <i class="bi bi-shop"></i> مشاهده محصولات
                </a>
            </div>
        }
        else
        {
            <div class="cart-layout">
                <div class="cart-items">
                    @foreach (var item in items)
                    {
                        var line = item.UnitPrice * item.Quantity;
                        var slug = item.Slug;
                        if (string.IsNullOrWhiteSpace(slug))
                        {
                            var p = NikooSystem.Services.TenantStore.GetProduct(company, item.ProductId);
                            slug = p?.Slug;
                        }
                        <article class="cart-item">
                            @if (!string.IsNullOrWhiteSpace(slug))
                            {
                                <a class="cart-item-thumb" href="@Url.Action("Product","Shop", new { company, slug })">
                                    <img src="@(item.ImageUrl ?? "/Assets/img/portfolio/portfolio-1.jpg")" alt="@item.Title" />
                                </a>
                            }
                            else
                            {
                                <div class="cart-item-thumb">
                                    <img src="@(item.ImageUrl ?? "/Assets/img/portfolio/portfolio-1.jpg")" alt="@item.Title" />
                                </div>
                            }
                            <div class="cart-item-info">
                                <h3>
                                    @if (!string.IsNullOrWhiteSpace(slug))
                                    {
                                        <a href="@Url.Action("Product","Shop", new { company, slug })">@item.Title</a>
                                    }
                                    else
                                    {
                                        @item.Title
                                    }
                                </h3>
                                <div class="cart-item-price">
                                    <span>قیمت واحد: @item.UnitPrice.ToToman()</span>
                                    <strong>@line.ToToman()</strong>
                                </div>
                            </div>
                            <div class="cart-item-actions">
                                @using (Html.BeginForm("UpdateCart", "Shop", new { company }, FormMethod.Post, new { @class = "cart-qty-form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <div class="cart-qty">
                                        <button type="button" class="cart-qty-btn" data-delta="-1" aria-label="کاهش">−</button>
                                        <input class="cart-qty-input" type="number" name="quantity" value="@item.Quantity" min="0" max="999" />
                                        <button type="button" class="cart-qty-btn" data-delta="1" aria-label="افزایش">+</button>
                                    </div>
                                    <button class="btn-cart-secondary" type="submit">
                                        <i class="bi bi-arrow-repeat"></i> بروزرسانی
                                    </button>
                                }
                                @using (Html.BeginForm("RemoveFromCart", "Shop", new { company }, FormMethod.Post, new { @class = "cart-remove-form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button class="btn-cart-danger" type="submit" title="حذف از سبد">
                                        <i class="bi bi-trash3"></i>
                                        <span>حذف</span>
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>

                <aside class="cart-summary">
                    <h2>خلاصه سفارش</h2>
                    <div class="cart-summary-row">
                        <span>تعداد کالا</span>
                        <strong>@count</strong>
                    </div>
                    <div class="cart-summary-row">
                        <span>جمع جزء</span>
                        <strong>@total.ToToman()</strong>
                    </div>
                    <div class="cart-summary-row cart-summary-total">
                        <span>مبلغ قابل پرداخت</span>
                        <strong>@total.ToToman()</strong>
                    </div>
                    <a class="btn-store btn-cart-checkout" href="@Url.Action("Checkout","Shop", new { company })">
                        <i class="bi bi-credit-card"></i> ادامه و پرداخت
                    </a>
                    <a class="btn-cart-ghost" href="@Url.Action("Catalog","Shop", new { company })">بازگشت به فروشگاه</a>
                </aside>
            </div>
        }
    </div>
</section>

@section scripts {
<script>
(function () {
  document.querySelectorAll('.cart-qty').forEach(function (wrap) {
    var input = wrap.querySelector('.cart-qty-input');
    wrap.querySelectorAll('.cart-qty-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var delta = parseInt(btn.getAttribute('data-delta'), 10) || 0;
        var val = parseInt(input.value, 10) || 0;
        val = Math.max(0, val + delta);
        input.value = val;
      });
    });
  });
})();
</script>
}
