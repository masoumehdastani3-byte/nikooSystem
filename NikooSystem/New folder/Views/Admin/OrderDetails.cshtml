@model NikooSystem.Models.Order
@using NikooSystem.Helpers
@using NikooSystem.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "جزئیات سفارش";
}
<h2 class="mb-3">سفارش @Model.OrderNumber</h2>
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-4">
            <h5>اطلاعات مشتری</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">نام</dt><dd class="col-sm-8">@Model.CustomerName</dd>
                <dt class="col-sm-4">موبایل</dt><dd class="col-sm-8">@Model.CustomerMobile</dd>
                <dt class="col-sm-4">ایمیل</dt><dd class="col-sm-8">@Model.CustomerEmail</dd>
                <dt class="col-sm-4">آدرس</dt><dd class="col-sm-8">@(Model.CustomerAddress ?? "-")</dd>
                <dt class="col-sm-4">توضیحات</dt><dd class="col-sm-8">@(Model.Notes ?? "-")</dd>
            </dl>
            <hr />
            <h5>اطلاعات پرداخت</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">محصول</dt><dd class="col-sm-8">@Model.ProductTitle</dd>
                <dt class="col-sm-4">مبلغ</dt><dd class="col-sm-8">@Model.Amount.ToToman()</dd>
                <dt class="col-sm-4">Authority</dt><dd class="col-sm-8">@(Model.Authority ?? "-")</dd>
                <dt class="col-sm-4">کد پیگیری</dt><dd class="col-sm-8">@(Model.RefId?.ToString() ?? "-")</dd>
                <dt class="col-sm-4">پیام</dt><dd class="col-sm-8">@(Model.PaymentMessage ?? "-")</dd>
                <dt class="col-sm-4">وضعیت</dt><dd class="col-sm-8"><span class="badge @Model.Status.StatusBadgeClass()">@Model.Status.StatusText()</span></dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm p-4">
            <h5>تغییر وضعیت</h5>
            @using (Html.BeginForm("UpdateOrderStatus", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <select name="status" class="form-select mb-3">
                    @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                    {
                        <option value="@s" @(Model.Status == s ? "selected" : null)>@s.StatusText()</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">به‌روزرسانی</button>
                <a href="@Url.Action("Orders","Admin")" class="btn btn-link">بازگشت</a>
            }
        </div>
    </div>
</div>
