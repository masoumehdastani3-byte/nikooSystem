@{
    ViewBag.Title = "درباره ما";
    ViewBag.Nav = "about";
}
<main id="main">
    <div class="page-hero">
        <div class="container">
            <h1>درباره نیکو سیستم آفرین</h1>
            <p class="text-muted">فروشگاه تخصصی محصولات نرم‌افزاری</p>
        </div>
    </div>
    <section class="about">
        <div class="container">
            <div class="row gx-0 align-items-center">
                <div class="col-lg-6">
                    <div class="content">
                        <h3>ماموریت ما</h3>
                        <h2>نرم‌افزاری که کسب‌وکار شما را جلو می‌برد</h2>
                        <p>
                            نیکو سیستم آفرین از سال‌ها تجربه در طراحی و توسعه نرم‌افزار شکل گرفته است.
                            ما فروشگاه‌های آنلاین آماده، سامانه‌های سازمانی و محصولات دانلودی را با کیفیت بالا عرضه می‌کنیم
                            تا بتوانید سریع‌تر فروش آنلاین خود را آغاز کنید.
                        </p>
                        <ul>
                            <li>دموی واقعی قبل از خرید</li>
                            <li>پرداخت امن آنلاین</li>
                            <li>پشتیبانی راه‌اندازی پس از سفارش</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <img src="~/Assets/img/about.jpg" class="img-fluid rounded" alt="">
                </div>
            </div>
        </div>
    </section>
</main>