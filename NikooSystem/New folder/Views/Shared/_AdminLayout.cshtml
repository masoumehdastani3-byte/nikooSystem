@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - پنل نیکو سیستم آفرین</title>
    <link href="~/Assets/css/style.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Content/admin.css" rel="stylesheet">
    <link href="~/Content/admin-table.css" rel="stylesheet">
    <style>body,.admin-body{font-family:'Far_Yekan',Tahoma,sans-serif!important}</style>
</head>
<body class="admin-body">
    @if (Session["AdminUser"] != null)
    {
        <nav class="navbar navbar-expand-lg navbar-dark admin-nav">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index","Admin")">پنل نیکو سیستم آفرین</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="adminNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Admin")">داشبورد</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Products","Admin")">محصولات</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Orders","Admin")">سفارشات</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Home")" target="_blank">مشاهده سایت</a></li>
                    </ul>
                    <span class="navbar-text text-white-50 me-3">@Session["AdminUser"]</span>
                    <a class="btn btn-outline-light btn-sm" href="@Url.Action("Logout","Admin")">خروج</a>
                </div>
            </div>
        </nav>
    }
    <main class="container py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/admin-table.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
