@model NikooSystem.Models.Store.StoreCategory
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = Model.Id > 0 ? "ویرایش گروه" : "گروه جدید";
    var company = (string)ViewBag.CompanyCode;
    var cats = (IEnumerable<NikooSystem.Models.Store.StoreCategory>)ViewBag.Categories;
}
<h2 class="mb-3">@ViewBag.Title</h2>
@using (Html.BeginForm("SaveCategory", "ShopAdmin", new { company }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="panel-card row g-3">
        <div class="col-md-6"><label class="form-label">عنوان</label>@Html.TextBoxFor(m => m.Title, new { @class = "form-control" })</div>
        <div class="col-md-6"><label class="form-label">اسلاگ</label>@Html.TextBoxFor(m => m.Slug, new { @class = "form-control" })</div>
        <div class="col-md-6">
            <label class="form-label">گروه والد</label>
            <select class="form-select" name="ParentId">
                <option value="">بدون والد</option>
                @foreach (var c in cats.Where(x => x.Id != Model.Id && x.ParentId == null))
                {
                    <option value="@c.Id" @(Model.ParentId == c.Id ? "selected" : "")>@c.Title</option>
                }
            </select>
        </div>
        <div class="col-md-3"><label class="form-label">ترتیب</label>@Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number" })</div>
        <div class="col-md-3 form-check mt-4 pt-3"><label><input type="checkbox" name="IsActive" value="true" @(Model.IsActive?"checked":"") /> فعال</label><input type="hidden" name="IsActive" value="false" /></div>
        <div class="col-12"><label class="form-label">توضیحات</label>@Html.TextAreaFor(m => m.Description, 3, 1, new { @class = "form-control" })</div>
        <div class="col-12">
            <button class="btn-store" type="submit">ذخیره</button>
            <a class="btn-outline-store" href="@Url.Action("Categories","ShopAdmin", new { company })">بازگشت</a>
        </div>
    </div>
}
