@model NikooSystem.Models.Store.StoreRegisterVm
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = "ثبت‌نام";
    var company = (string)ViewBag.CompanyCode;
}
<section class="py-5">
    <div class="container" style="max-width:560px;">
        <div class="panel-card">
            <h2 class="section-title">ثبت‌نام مشتری</h2>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="mb-3"><label class="form-label">نام</label>@Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })</div>
                <div class="mb-3"><label class="form-label">موبایل</label>@Html.TextBoxFor(m => m.Mobile, new { @class = "form-control" })</div>
                <div class="mb-3"><label class="form-label">ایمیل</label>@Html.TextBoxFor(m => m.Email, new { @class = "form-control" })</div>
                <div class="mb-3"><label class="form-label">آدرس</label>@Html.TextBoxFor(m => m.Address, new { @class = "form-control" })</div>
                <div class="mb-3"><label class="form-label">رمز عبور</label>@Html.PasswordFor(m => m.Password, new { @class = "form-control" })</div>
                <button class="btn-store w-100" type="submit">ثبت‌نام</button>
            }
        </div>
    </div>
</section>
