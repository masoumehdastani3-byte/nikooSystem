@model IEnumerable<NikooSystem.Models.Store.StoreOrder>
@using NikooSystem.Helpers
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = "سفارش‌های من";
    var company = (string)ViewBag.CompanyCode;
    var customer = ViewBag.Customer as NikooSystem.Models.Store.StoreCustomer;
}
<section class="py-4">
    <div class="container" style="max-width:860px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="section-title mb-0">سفارش‌های @(customer?.FullName)</h1>
            <div>
                <a class="btn-outline-store" href="@Url.Action("Profile","ShopAccount", new { company })">پروفایل</a>
                <a class="btn-outline-store" href="@Url.Action("Logout","ShopAccount", new { company })">خروج</a>
            </div>
        </div>
        @foreach (var o in Model)
        {
            <div class="panel-card mb-2">
                <div class="d-flex justify-content-between">
                    <strong>@o.OrderNumber</strong>
                    <span>@o.Status</span>
                </div>
                <div class="text-muted small">@o.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                <div class="mt-2">@o.Amount.ToToman()</div>
                <ul class="mb-0 mt-2">
                    @foreach (var i in o.Items)
                    {
                        <li>@i.Title × @i.Quantity</li>
                    }
                </ul>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="panel-card">هنوز سفارشی ندارید. <a href="@Url.Action("Catalog","Shop", new { company })">خرید کنید</a></div>
        }
    </div>
</section>
