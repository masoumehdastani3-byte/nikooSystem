@model OwnerLoginVm
@{
    ViewBag.Title = "ورود مدیران کسب‌وکار";
}
<link href="@Url.Asset("~/Content/onboarding.css")" rel="stylesheet" />
<main id="main" class="ob-page">
    <div class="container" style="max-width:480px;">
        <div class="ob-card">
            <h1>ورود به پنل کسب‌وکار</h1>
            <p class="ob-sub">با شماره موبایل و رمزی که هنگام ساخت سایت انتخاب کردید وارد شوید.</p>
            <div class="alert alert-info small py-2 ob-alert-plain">این صفحه مخصوص <strong>مدیران کسب‌وکار</strong> است.</div>
            @using (Html.BeginForm("Login", "Signup", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                <div class="mb-3">
                    <label class="form-label" for="Mobile">شماره موبایل</label>
                    @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control", dir = "ltr", placeholder = "09121234567", inputmode = "numeric", autocomplete = "username" })
                    @Html.ValidationMessageFor(m => m.Mobile, "", new { @class = "text-danger small" })
                </div>
                <div class="mb-3">
                    <label class="form-label" for="Password">رمز عبور</label>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>
                <button type="submit" class="btn-primary-shop w-100 py-2"><i class="bi bi-box-arrow-in-left"></i> ورود</button>
            }
            <div class="text-center mt-3 small">
                هنوز سایت ندارید؟ <a href="@Url.Action("Index","Signup")">رایگان بسازید</a>
            </div>
            <div class="text-center mt-2 small text-muted">برای ورود مشتریان، لینک «ورود مشتری» فقط داخل همان سایت نمایش داده می‌شود.</div>
        </div>
    </div>
</main>
