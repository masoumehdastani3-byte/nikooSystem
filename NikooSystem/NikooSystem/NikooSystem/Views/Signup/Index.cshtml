@model StoreSignupVm
@{
    ViewBag.Title = "ساخت فروشگاه رایگان";
    var trialDays = NikooSystem.Services.TenantProvisioningService.TrialDays;
    var rootDomain = NikooSystem.Services.TenantProvisioningService.RootDomain;
    var codeSuffix = string.IsNullOrEmpty(rootDomain) ? null : "." + rootDomain;
    var lastCompany = (Request?.Cookies["nk_last_company"]?.Value ?? "").Trim();
    var businessLoginUrl = string.IsNullOrEmpty(lastCompany)
        ? Url.Action("Login", "Signup")
        : Url.Action("Login", "ShopAdmin", new { company = lastCompany });
    var prefilledType = (ViewBag.PrefilledStoreType as bool?) ?? false;
    var selectedKindId = StoreTypes.Get(Model.StoreType).Kind;
}
<link href="@Url.Asset("~/Content/onboarding.css")" rel="stylesheet" />
<main id="main" class="ob-page">
    <div class="container">
        <div class="ob-tabs-bar" id="siteTypeStep">
            <div class="ob-kind-tabs" role="tablist" aria-label="گروه‌های محصول">
                @foreach (var kind in SiteKinds.All)
                {
                    var tabActive = selectedKindId == kind.Id;
                    <button type="button" class="ob-kind-tab @(tabActive ? "active" : "")" data-kind-target="@kind.Id" role="tab" aria-selected="@(tabActive ? "true" : "false")">
                        <i class="bi @kind.Icon"></i>
                        <span>@kind.Name</span>
                    </button>
                }
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7 order-lg-2">
                <div class="ob-card">
                    @using (Html.BeginForm("Index", "Signup", FormMethod.Post, new { id = "signupForm", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                        <div class="ob-hp" aria-hidden="true">
                            <label for="Website">وب‌سایت</label>
                            @Html.TextBoxFor(m => m.Website, new { tabindex = "-1", autocomplete = "off" })
                        </div>

                        if (!string.IsNullOrEmpty(Model.Template))
                        {
                            var chosenTemplate = StoreTemplates.Get(Model.Template);
                            @Html.HiddenFor(m => m.Template)
                            <div class="alert alert-info d-flex align-items-center gap-2 mb-4 py-2 small">
                                <span class="d-inline-block rounded-circle flex-shrink-0" style="width:16px;height:16px;background:@chosenTemplate.PrimaryColor"></span>
                                <span>قالب انتخابی شما: <strong>@chosenTemplate.Name</strong>؛ سایت با همین قالب ساخته می‌شود (اگر نوع سایتی انتخاب کنید که این قالب را ندارد، قالب پیش‌فرض آن نوع گذاشته می‌شود).</span>
                            </div>
                        }

                        <div class="mb-4">
                            <span class="ob-label">۱. @(prefilledType ? "نوع سایت شما از صفحه قبلی انتخاب شد" : "نوع سایت را انتخاب کنید")</span>
                            @if (prefilledType)
                            {
                                <div class="ob-help mb-2">اگر لازم باشد، از همین بخش می‌توانید نوع سایت را تغییر دهید.</div>
                            }
                            @foreach (var kind in SiteKinds.All)
                            {
                                var panelActive = selectedKindId == kind.Id;
                                <div class="ob-kind-panel @(panelActive ? "active" : "")" data-kind-panel="@kind.Id" role="tabpanel">
                                    <div class="ob-types">
                                        @foreach (var t in StoreTypes.OfKind(kind.Id))
                                        {
                                            var active = Model.StoreType == t.Id;
                                            <label class="ob-type @(active ? "active" : "")" data-kind="@kind.Id">
                                                <input type="radio" name="StoreType" value="@t.Id" @(active ? "checked" : null) />
                                                <i class="bi @t.Icon"></i>
                                                <div><strong>@t.Name</strong><span>@t.Description</span></div>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="ob-help">نگران نباش؛ بعداً همه‌چیز از جمله قالب و دسته‌بندی‌ها قابل تغییر است.</div>
                        </div>

                        <div class="ob-form-section ob-form-section-store mb-4">
                            <span class="ob-label">۲. مشخصات فروشگاه</span>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="StoreName">نام فروشگاه</label>
                                    @Html.TextBoxFor(m => m.StoreName, new { @class = "form-control", placeholder = "مثلاً پوشاک آریا" })
                                    @Html.ValidationMessageFor(m => m.StoreName, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="StoreCode">آدرس فروشگاه (انگلیسی)</label>
                                    <div class="ob-code">
                                        @Html.TextBoxFor(m => m.StoreCode, new { @class = "form-control", placeholder = "aryashop", autocomplete = "off", spellcheck = "false" })
                                        @if (codeSuffix != null)
                                        {
                                            <span class="ob-code-suffix">@codeSuffix</span>
                                        }
                                    </div>
                                    <div class="ob-code-status" id="codeStatus"></div>
                                    @Html.ValidationMessageFor(m => m.StoreCode, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="ob-form-section">
                            <span class="ob-label">۳. مشخصات شما (مدیر فروشگاه)</span>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="FullName">نام و نام خانوادگی</label>
                                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="Mobile">شماره موبایل</label>
                                    @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control", placeholder = "09121234567", dir = "ltr", inputmode = "numeric" })
                                    <div class="ob-help">نام کاربری ورود به پنل شما همین شماره است.</div>
                                    @Html.ValidationMessageFor(m => m.Mobile, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="Password">رمز عبور</label>
                                    <div class="input-group" dir="ltr">
                                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password" })
                                        <button class="btn btn-outline-secondary" type="button" id="togglePass" title="نمایش رمز"><i class="bi bi-eye"></i></button>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="Email">ایمیل (اختیاری)</label>
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", dir = "ltr" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-12 form-check ms-1">
                                    @Html.CheckBoxFor(m => m.AcceptTerms, new { @class = "form-check-input" })
                                    <label class="form-check-label" for="AcceptTerms">
                                        <a href="@Url.Action("Terms","Home")" target="_blank">قوانین و مقررات</a> و <a href="@Url.Action("Privacy","Home")" target="_blank">حریم خصوصی</a> را خواندم و می‌پذیرم
                                    </label>
                                    @Html.ValidationMessageFor(m => m.AcceptTerms, "", new { @class = "text-danger small d-block" })
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn-primary-shop w-100 py-3">
                                        <i class="bi bi-rocket-takeoff"></i> شروع آزمایشی رایگان و ساخت سایت
                                    </button>
                                    <div class="text-center mt-3 small">
                                        قبلاً سایت ساخته‌اید؟ <a href="@businessLoginUrl">ورود مدیر کسب‌وکار</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-5 order-lg-1">
                <div class="ob-card mb-4">
                    <h1>فروشگاه، آکادمی یا سایت خبری خودت را بساز</h1>
                    <p class="ob-sub">@trialDays روز رایگان استفاده کن؛ اگر راضی بودی اشتراک را سه‌ماهه، شش‌ماهه یا یک‌ساله از داخل پنل تمدید کن.</p>
                    @foreach (var kind in SiteKinds.All)
                    {
                        var detailActive = selectedKindId == kind.Id;
                        <div class="ob-kind-detail-panel @(detailActive ? "active" : "")" data-kind-detail="@kind.Id">
                            <div class="ob-kind">
                                <div class="ob-kind-head">
                                    <i class="bi @kind.Icon"></i>
                                    <div>
                                        <strong>@kind.Name</strong>
                                        <span>@kind.Description</span>
                                    </div>
                                </div>
                                <ul class="ob-kind-features">
                                    @foreach (var f in kind.Features)
                                    {
                                        <li><i class="bi bi-check2"></i> @f</li>
                                    }
                                </ul>
                                <div class="ob-kind-modules">
                                    @foreach (var m in PlatformModules.For(kind).Where(m => m.Highlight))
                                    {
                                        <span><i class="bi @m.Icon"></i> @m.Name</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="ob-card">
                    <h5 class="mb-3">بعد از ثبت‌نام چه اتفاقی می‌افتد؟</h5>
                    <ul class="ob-benefits">
                        <li><i class="bi bi-lightning-charge"></i><div><strong>فروشگاه شما فوراً ساخته می‌شود</strong><span>با قالب آماده، منو، صفحات و چند محصول نمونه</span></div></li>
                        <li><i class="bi bi-signpost-split"></i><div><strong>راهنمای قدم‌به‌قدم</strong><span>لوگو، رنگ، اولین محصول، درگاه پرداخت و دامنه را در چند دقیقه تنظیم می‌کنید</span></div></li>
                        <li><i class="bi bi-palette"></i><div><strong>ظاهر دلخواه</strong><span>چند قالب آماده، رنگ‌ها، منوها و صفحات قابل تغییر</span></div></li>
                        <li><i class="bi bi-credit-card"></i><div><strong>درگاه پرداخت خودتان</strong><span>پول فروش مستقیم به حساب زرین‌پال شما واریز می‌شود</span></div></li>
                        <li><i class="bi bi-globe"></i><div><strong>دامنه اختصاصی</strong><span>دامنه خودتان را با راهنمای پنل وصل کنید؛ گواهی SSL را پشتیبانی نیکو فعال می‌کند</span></div></li>
                        <li><i class="bi bi-google"></i><div><strong>دیده شدن در گوگل و ترب</strong><span>سئوی خودکار همه صفحات و اتصال کالاهای فروشگاه به ترب با API رسمی</span></div></li>
                        <li><i class="bi bi-bell"></i><div><strong>خبر فوری در بله</strong><span>هر سفارش، نوبت یا پیام تازه همان لحظه در اپلیکیشن بله</span></div></li>
                    </ul>
                    <div class="alert alert-warning small mb-0">
                        دوره آزمایشی @trialDays روزه است. اگر تا پایان دوره اشتراک را تمدید نکنید، سایت و اطلاعات آن حذف می‌شود.
                        برای ادامه، اشتراک را به‌صورت سه‌ماهه، شش‌ماهه یا یک‌ساله از داخل پنل تمدید کنید.
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
@section scripts {
<script>
(function () {
  function activateKindTab(kindId) {
    if (!kindId) return;
    document.querySelectorAll('.ob-kind-tab').forEach(function (btn) {
      var active = btn.getAttribute('data-kind-target') === kindId;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });

    document.querySelectorAll('.ob-kind-panel').forEach(function (panel) {
      panel.classList.toggle('active', panel.getAttribute('data-kind-panel') === kindId);
    });

    document.querySelectorAll('.ob-kind-detail-panel').forEach(function (panel) {
      panel.classList.toggle('active', panel.getAttribute('data-kind-detail') === kindId);
    });
  }

  document.querySelectorAll('.ob-kind-tab').forEach(function (btn) {
    btn.addEventListener('click', function () {
      activateKindTab(btn.getAttribute('data-kind-target'));
    });
  });

  document.querySelectorAll('.ob-type').forEach(function (card) {
    card.addEventListener('click', function () {
      document.querySelectorAll('.ob-type').forEach(function (c) { c.classList.remove('active'); });
      card.classList.add('active');
      var input = card.querySelector('input');
      if (input) input.checked = true;
      activateKindTab(card.getAttribute('data-kind'));
    });
  });

  var toggle = document.getElementById('togglePass');
  var pass = document.getElementById('Password');
  toggle.addEventListener('click', function () {
    pass.type = pass.type === 'password' ? 'text' : 'password';
  });

  var codeInput = document.getElementById('StoreCode');
  var status = document.getElementById('codeStatus');
  var timer;
  codeInput.addEventListener('input', function () {
    var clean = codeInput.value.toLowerCase().replace(/[^a-z0-9]/g, '');
    if (clean !== codeInput.value) codeInput.value = clean;
    clearTimeout(timer);
    if (clean.length < 3) { status.textContent = ''; status.className = 'ob-code-status'; return; }
    timer = setTimeout(function () {
      fetch('@Url.Action("CheckCode","Signup")?code=' + encodeURIComponent(clean))
        .then(function (r) { return r.json(); })
        .then(function (d) {
          status.className = 'ob-code-status ' + (d.ok ? 'ok' : 'err');
          status.textContent = d.ok ? ('✓ ' + d.message + ' آدرس شما: ' + d.preview) : d.message;
        });
    }, 350);
  });
})();
</script>
}
