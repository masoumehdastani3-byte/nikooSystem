@model PagedList<NikooSystem.Models.SiteMessage>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "پیام‌های تماس";
    var statuses = new Dictionary<string, string> { { "unread", "خوانده‌نشده" }, { "read", "خوانده‌شده" } };
}
<div class="adm-head">
    <div>
        <h1>پیام‌های فرم «تماس با ما»</h1>
        <p>درخواست‌های مشاوره و سوال‌های بازدیدکنندگان سایت</p>
    </div>
    <div class="adm-head-actions">
        @Html.PostButton("MarkAllMessagesRead", null, "همه خوانده شد", "btn btn-outline-primary")
    </div>
</div>
<div class="adm-card">
    @Html.GridToolbar("جستجو در نام، ایمیل، تلفن، موضوع یا متن...", new GridSelect("status", "همه پیام‌ها", statuses))
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th></th>
                    @Html.SortHeader("subject", "موضوع")
                    @Html.SortHeader("name", "فرستنده")
                    @Html.SortHeader("created", "تاریخ")
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in Model)
            {
                <tr class="@(m.IsRead ? null : "fw-bold")">
                    <td style="width:2rem"><i class="bi @(m.IsRead ? "bi-envelope-open text-muted" : "bi-envelope-fill text-warning")" title="@(m.IsRead ? "خوانده‌شده" : "خوانده‌نشده")"></i></td>
                    <td>
                        <a class="text-decoration-none" href="@Url.Action("Message","Admin", new { id = m.Id })">@m.Subject</a>
                        <div class="small text-muted fw-normal text-truncate" style="max-width:420px">@m.Message</div>
                    </td>
                    <td>
                        @m.Name
                        <div class="small text-muted fw-normal" dir="ltr">@m.Email</div>
                    </td>
                    <td class="fw-normal">@m.CreatedAt.ToShamsi() @m.CreatedAt.ToString("HH:mm")</td>
                    <td class="row-actions">
                        @Html.IconLink(Url.Action("Message", "Admin", new { id = m.Id }), "bi-eye", "خواندن", "is-view")
                        @Html.DeleteButton("DeleteMessage", m.Id, "پیام «" + m.Subject + "» حذف شود؟")
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">پیامی یافت نشد</td></tr>
            }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
