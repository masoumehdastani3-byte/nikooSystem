@model PagedList<NikooSystem.Models.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "محصولات";
}
<div class="adm-head">
    <div>
        <h1>محصولات سایت</h1>
        <p>فروشگاه‌های آماده و نرم‌افزارهایی که در سایت معرفی و فروخته می‌شوند</p>
    </div>
    <div class="adm-head-actions">
        <a class="btn btn-primary" href="@Url.Action("CreateProduct","Admin")"><i class="bi bi-plus-lg"></i> محصول جدید</a>
    </div>
</div>
<div class="adm-card">
    @Html.GridToolbar("جستجو در عنوان، دسته یا دمو...")
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>تصویر</th>
                    @Html.SortHeader("title", "عنوان")
                    @Html.SortHeader("category", "دسته")
                    @Html.SortHeader("price", "قیمت")
                    <th>دمو</th>
                    <th>وضعیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><img class="thumb" src="@p.ImageUrl" alt=""></td>
                    <td>
                        <a class="fw-bold text-decoration-none" href="@Url.Action("EditProduct","Admin", new { id = p.Id })">@p.Title</a>
                        @if (p.IsFeatured)
                        {
                            <span class="adm-chip is-orange ms-1"><i class="bi bi-star-fill"></i> پیشنهادی</span>
                        }
                    </td>
                    <td>@(p.Category ?? "-")</td>
                    <td>@p.Price.ToToman()</td>
                    <td>
                        @if (string.IsNullOrEmpty(p.DemoSlug))
                        {
                            @:-
                        }
                        else
                        {
                            <a href="@Url.Action("Index","Demo", new { slug = p.DemoSlug })" target="_blank" rel="noopener">@NikooSystem.Helpers.StoreTypes.Get(p.DemoSlug).Name</a>
                        }
                    </td>
                    <td><span class="adm-chip @(p.IsActive ? "is-green" : "is-gray")">@(p.IsActive ? "فعال" : "غیرفعال")</span></td>
                    <td class="row-actions">
                        @Html.IconPost("ToggleProduct", new { id = p.Id, field = "featured" }, p.IsFeatured ? "bi-star-fill" : "bi-star", p.IsFeatured ? "خارج کردن از پیشنهادی‌ها" : "پیشنهادی کردن", "is-toggle")
                        @Html.IconPost("ToggleProduct", new { id = p.Id, field = "active" }, p.IsActive ? "bi-eye-slash" : "bi-eye", p.IsActive ? "غیرفعال کردن" : "فعال کردن", "is-view")
                        @Html.EditLink("EditProduct", p.Id)
                        @Html.DeleteButton("DeleteProduct", p.Id, "محصول «" + p.Title + "» حذف شود؟ (اگر سفارش داشته باشد فقط غیرفعال می‌شود)")
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">محصولی یافت نشد</td></tr>
            }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
