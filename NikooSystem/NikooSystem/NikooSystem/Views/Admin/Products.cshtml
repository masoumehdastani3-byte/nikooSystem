@model List<NikooSystem.Models.Product>
@using NikooSystem.Helpers
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "محصولات";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">مدیریت محصولات</h2>
    <a class="btn btn-primary" href="@Url.Action("CreateProduct","Admin")">محصول جدید</a>
</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>تصویر</th><th>عنوان</th><th>دسته</th><th>قیمت</th><th>دمو</th><th>فعال</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><img class="thumb" src="@p.ImageUrl" alt=""></td>
                    <td>@p.Title</td>
                    <td>@p.Category</td>
                    <td>@p.Price.ToToman()</td>
                    <td>@(p.DemoSlug ?? "-")</td>
                    <td>@(p.IsActive ? "بله" : "خیر")</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("EditProduct","Admin", new { id = p.Id })">ویرایش</a>
                        @using (Html.BeginForm("DeleteProduct", "Admin", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('حذف شود؟');" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
