@model PagedList<NikooSystem.Models.SupportTicket>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "تیکت‌های پشتیبانی";
    var state = (string)ViewBag.State;
    var awaiting = (int)ViewBag.Awaiting;
    var baleLinked = (int)ViewBag.BaleLinked;
    var botReady = (bool)ViewBag.BotReady;
    var company = Request.QueryString["company"];
    var tabs = new[]
    {
        new { Key = "active", Text = "جاری", Count = 0 },
        new { Key = "open", Text = "در انتظار پاسخ", Count = awaiting },
        new { Key = "answered", Text = "پاسخ داده شده", Count = 0 },
        new { Key = "closed", Text = "بسته شده", Count = 0 },
        new { Key = "all", Text = "همه", Count = 0 }
    };
}
<link href="@Url.Asset("~/Content/support.css")" rel="stylesheet" />
<div class="sp" style="--sp-accent:#4f46e5">
    <div class="adm-head">
        <div>
            <h1>تیکت‌های پشتیبانی</h1>
            <p>درخواست‌های صاحبان سایت‌ها؛ پاسخ شما در پنل آن‌ها و در بله‌شان فرستاده می‌شود.</p>
        </div>
        @if (!string.IsNullOrEmpty(company))
        {
            <div class="adm-head-actions">
                <a class="btn btn-outline-secondary" href="@Html.QueryUrl(new Dictionary<string, object> { ["company"] = null, ["page"] = null })"><i class="bi bi-x-circle"></i> همه سایت‌ها (اکنون: @company)</a>
            </div>
        }
    </div>

    @if (botReady)
    {
        <div class="sp-bale @(baleLinked > 0 ? "is-on" : null)">
            <span class="sp-bale-icon"><i class="bi @(baleLinked > 0 ? "bi-check2-all" : "bi-phone")"></i></span>
            <div class="sp-bale-text">
                @if (baleLinked > 0)
                {
                    <strong>پشتیبانی از بله فعال است</strong>
                    @:تیکت تازه و پاسخ مشتریان به @baleLinked.ToFa() حساب بله پشتیبانی می‌رسد. در بله روی پیام هر تیکت «پاسخ» بزنید، یا «#شماره متن» بفرستید؛ <code dir="ltr">/tickets</code> تیکت‌های بی‌پاسخ را فهرست می‌کند.
                }
                else
                {
                    <strong>تیکت‌ها را در بله بگیرید و جواب دهید</strong>
                    @:حساب بله پشتیبان‌ها را از «اطلاع‌رسانی بله» وصل کنید تا هر تیکت همان لحظه برسد و با «پاسخ» روی همان پیام جواب داده شود.
                }
            </div>
            <a class="btn @(baleLinked > 0 ? "btn-outline-primary" : "btn-primary")" href="@Url.Action("Notifications", "Admin")"><i class="bi bi-bell"></i> اطلاع‌رسانی بله</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> بازوی بله ثبت نشده است؛ تیکت‌ها فقط در پنل رد و بدل می‌شوند. توکن بازو را در <a href="@Url.Action("Notifications", "Admin")">اطلاع‌رسانی بله</a> وارد کنید.</div>
    }

    <nav class="sp-tabs" aria-label="وضعیت تیکت‌ها">
        @foreach (var tab in tabs)
        {
            var active = tab.Key == state;
            <a class="@(active ? "is-active" : null)" href="@Html.QueryUrl(new Dictionary<string, object> { ["state"] = tab.Key == "active" ? null : tab.Key, ["page"] = null })" @(active ? Html.Raw("aria-current=\"page\"") : null)>
                @tab.Text @if (tab.Count > 0) { <em>@tab.Count.ToFa()</em> }
            </a>
        }
    </nav>

    <div class="adm-card sp-list">
        @Html.GridToolbar("جستجو در موضوع، کد سایت یا شماره تیکت…")
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        @Html.SortHeader("id", "شماره")
                        @Html.SortHeader("subject", "موضوع")
                        @Html.SortHeader("company", "سایت")
                        <th>اولویت</th>
                        <th>وضعیت</th>
                        @Html.SortHeader("updated", "آخرین پیام")
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        var url = Url.Action("Ticket", "Admin", new { id = t.Id });
                        <tr class="@(t.UnreadBySupport ? "sp-row-unread" : null)">
                            <td class="sp-id">#@t.Id.ToFa()</td>
                            <td>
                                @if (t.UnreadBySupport) { <span class="sp-new-dot" title="پیام تازه"></span> }
                                <a class="sp-subject" href="@url">@t.Subject</a>
                                <div class="small text-muted">@SupportLabels.Category(t.Category) · @t.MessageCount.ToFa() پیام</div>
                            </td>
                            <td>
                                @NikooSystem.Services.BaleNotifier.SiteName(t.CompanyCode)
                                <div class="small"><a class="text-muted" href="@Html.QueryUrl(new Dictionary<string, object> { ["company"] = t.CompanyCode, ["page"] = null })" dir="ltr">@t.CompanyCode</a></div>
                            </td>
                            <td><span class="sp-pill is-plain @SupportLabels.PriorityTone(t.Priority)">@SupportLabels.Priority(t.Priority)</span></td>
                            <td><span class="sp-pill @SupportLabels.StatusTone(t.Status)">@SupportLabels.Status(t.Status, true)</span></td>
                            <td class="small text-muted">@t.UpdatedAt.ToShamsi() @t.UpdatedAt.ToString("HH:mm").ToFaDigits()</td>
                            <td class="row-actions">@Html.IconLink(url, "bi-chat-left-text", "مشاهده و پاسخ", "is-view")</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="sp-empty"><i class="bi bi-inbox"></i>@(state == "open" || state == "active" ? "تیکت بی‌پاسخی نمانده است." : "تیکتی پیدا نشد.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @Html.Pager(Model)
    </div>
</div>
