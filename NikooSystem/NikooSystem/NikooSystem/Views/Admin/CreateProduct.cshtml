@model NikooSystem.Models.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "افزودن محصول";
}
<div class="adm-head">
    <h1>افزودن محصول</h1>
    <div class="adm-head-actions">
        <button class="btn btn-primary" type="submit" form="adminCreateProductForm">ذخیره</button>
        <a href="@Url.Action("Products","Admin")" class="btn btn-link">انصراف</a>
    </div>
</div>
@using (Html.BeginForm("CreateProduct", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", id = "adminCreateProductForm" }))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_ProductForm", Model)
}
