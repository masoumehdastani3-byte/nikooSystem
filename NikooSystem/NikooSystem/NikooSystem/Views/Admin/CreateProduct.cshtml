@model NikooSystem.Models.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "افزودن محصول";
}
<div class="adm-head">
    <h1>افزودن محصول</h1>
</div>
@using (Html.BeginForm("CreateProduct", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_ProductForm", Model)
    <div class="mt-3">
        <button type="submit" class="btn btn-primary px-4">ذخیره</button>
        <a href="@Url.Action("Products","Admin")" class="btn btn-link">انصراف</a>
    </div>
}
