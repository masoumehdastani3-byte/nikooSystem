@model string
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var type = (StoreTypeInfo)ViewBag.Type;
    ViewBag.Title = "قالب ظاهری نمونه سایت " + type.Name;
    ViewBag.PickerSite = "نمونه سایت " + type.Name;
}
<div class="adm-head">
    <div>
        <h1>قالب ظاهری نمونه سایت «@type.Name»</h1>
        <p>قالب ظاهری‌ای را انتخاب کنید که این نمونه سایت برای همه بازدیدکننده‌ها با آن باز شود. رنگ‌های نمونه سایت هم رنگ‌های پیش‌فرض همان قالب ظاهری می‌شوند.</p>
    </div>
    <div class="adm-head-actions">
        <button class="btn btn-primary" type="submit" form="demoTemplateForm"><i class="bi bi-check2"></i> ذخیره و اعمال روی نمونه سایت</button>
        <a class="btn btn-outline-secondary" href="@Url.Action("DemoTemplates","Admin")"><i class="bi bi-arrow-right"></i> همه نمونه‌سایت‌ها</a>
        <a class="btn btn-outline-primary" href="@Url.Action("Index","Shop", new { company = ViewBag.CompanyCode })" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-left"></i> مشاهده نمونه سایت</a>
    </div>
</div>
@using (Html.BeginForm("DemoTemplate", "Admin", FormMethod.Post, new { id = "demoTemplateForm" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="slug" value="@ViewBag.Slug" />
    <div class="adm-card">
        @Html.Partial("~/Views/ShopAdmin/_TemplatePicker.cshtml", Model)
    </div>
}
