@model List<NikooSystem.Models.Order>
@using NikooSystem.Helpers
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "سفارشات";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">سفارشات خرید</h2>
    <div class="btn-group">
        <a class="btn btn-sm btn-outline-secondary @(ViewBag.Status==null?"active":"")" href="@Url.Action("Orders","Admin")">همه</a>
        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Orders","Admin", new { status = "Paid" })">پرداخت‌شده</a>
        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Orders","Admin", new { status = "PendingPayment" })">در انتظار</a>
        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Orders","Admin", new { status = "Failed" })">ناموفق</a>
    </div>
</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>شماره</th><th>تاریخ</th><th>مشتری</th><th>موبایل</th><th>محصول</th><th>مبلغ</th><th>وضعیت</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.OrderNumber</td>
                    <td>@o.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                    <td>@o.CustomerName</td>
                    <td>@o.CustomerMobile</td>
                    <td>@o.ProductTitle</td>
                    <td>@o.Amount.ToToman()</td>
                    <td><span class="badge @o.Status.StatusBadgeClass()">@o.Status.StatusText()</span></td>
                    <td><a href="@Url.Action("OrderDetails","Admin", new { id = o.Id })">جزئیات</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">سفارشی یافت نشد</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
