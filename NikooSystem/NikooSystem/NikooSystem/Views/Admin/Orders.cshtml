@model PagedList<NikooSystem.Models.Order>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "سفارشات";
    var statuses = Enum.GetValues(typeof(NikooSystem.Models.OrderStatus)).Cast<NikooSystem.Models.OrderStatus>()
        .ToDictionary(s => s.ToString(), s => s.StatusText());
}
<div class="adm-head">
    <div>
        <h1>سفارش‌ها</h1>
        <p>خرید محصولات سایت و پرداخت اشتراک فروشگاه‌های آزمایشی</p>
    </div>
</div>
<div class="adm-card">
    @Html.GridToolbar("جستجو در شماره، مشتری، موبایل یا محصول...", new GridSelect("status", "همه وضعیت‌ها", statuses))
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    @Html.SortHeader("number", "شماره")
                    @Html.SortHeader("created", "تاریخ")
                    @Html.SortHeader("customer", "مشتری")
                    <th>موبایل</th>
                    <th>محصول</th>
                    @Html.SortHeader("amount", "مبلغ")
                    <th>وضعیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td class="adm-ltr">@o.OrderNumber</td>
                    <td>@o.CreatedAt.ToShamsi() @o.CreatedAt.ToString("HH:mm")</td>
                    <td>@o.CustomerName</td>
                    <td class="adm-ltr">@o.CustomerMobile</td>
                    <td>
                        @o.ProductTitle
                        @if (!string.IsNullOrEmpty(o.CompanyCode))
                        {
                            <a class="adm-chip is-blue text-decoration-none" href="@Url.Action("Store","Admin", new { id = o.CompanyCode })" title="اشتراک فروشگاه"><i class="bi bi-shop"></i> @o.CompanyCode</a>
                        }
                    </td>
                    <td>@o.Amount.ToToman()</td>
                    <td><span class="badge @o.Status.StatusBadgeClass()">@o.Status.StatusText()</span></td>
                    <td class="row-actions">@Html.IconLink(Url.Action("OrderDetails", "Admin", new { id = o.Id }), "bi-eye", "جزئیات سفارش", "is-view")</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">سفارشی یافت نشد</td></tr>
            }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
