@model NikooSystem.Models.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "ویرایش محصول";
}
<div class="adm-head">
    <h1>ویرایش «@Model.Title»</h1>
    <div class="adm-head-actions">
        <a class="btn btn-outline-primary" href="@Url.Action("Details","Products", new { id = Model.Id })" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-left"></i> صفحه محصول</a>
    </div>
</div>
@using (Html.BeginForm("EditProduct", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.Partial("_ProductForm", Model)
    <div class="mt-3">
        <button type="submit" class="btn btn-primary px-4">ذخیره تغییرات</button>
        <a href="@Url.Action("Products","Admin")" class="btn btn-link">انصراف</a>
    </div>
}
