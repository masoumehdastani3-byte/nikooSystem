@model List<NikooSystem.Models.Product>
@using NikooSystem.Helpers
@{
    ViewBag.Title = "محصولات نرم‌افزاری";
    ViewBag.Nav = "products";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}
<main id="main">
    <div class="page-hero">
        <div class="container">
            <h1>محصولات نرم‌افزاری</h1>
            <p class="text-muted">سایت و پنل آماده برای فروش آنلاین یا حضوری، آموزش، شرکت، خبر، مطب، آرایشگاه، مشاوره، آموزشگاه و باشگاه ورزشی</p>
        </div>
    </div>
    <section class="pb-5">
        <div class="container">
            <header class="lf-section-head">
                <h2>معرفی محصولات</h2>
                <p>تصویر، کاربرد و مسیر شروع هر سایت</p>
            </header>
            <div class="mb-5">
                @Html.Partial("_ProductIntroCards", ProductLandings.All)
            </div>
            @if (Model.Any() || !string.IsNullOrEmpty(ViewBag.Category as string))
            {
            <h2 class="h4 mb-3">نرم‌افزارهای قابل سفارش</h2>
            <div class="mb-4 d-flex flex-wrap gap-2">
                <a class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.Category as string) ? "btn-primary-shop" : "btn-outline-shop")" href="@Url.Action("Index","Products")">همه</a>
                @foreach (var c in categories)
                {
                    <a class="btn btn-sm @(ViewBag.Category as string == c ? "btn-primary-shop" : "btn-outline-shop")" href="@Url.Action("Index","Products", new { category = c })">@c</a>
                }
            </div>
            <div class="row g-4">
                @foreach (var p in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="product-card">
                            <div class="product-img-wrap">
                                @if (p.IsFeatured) { <span class="badge-feat">ویژه</span> }
                                <img src="@p.ImageUrl" alt="@p.Title">
                            </div>
                            <div class="body">
                                <small class="text-muted">@p.Category</small>
                                <h4>@p.Title</h4>
                                <p class="small text-muted">@p.ShortDescription</p>
                                @if (!string.IsNullOrEmpty(p.DemoSlug))
                                {
                                    <a class="lf-tpl-count" href="@Url.Action("Details","Products", new { id = p.Id })#templates"><i class="bi bi-palette"></i> @StoreTemplates.ForKind(StoreTypes.Get(p.DemoSlug).Kind).Count().ToString().ToFaDigits() قالب آماده با پیش‌نمایش زنده</a>
                                }
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="price">@p.Price.ToToman()@if (!string.IsNullOrEmpty(p.DemoSlug)) {<small class="text-muted fw-normal"> / سه ماه</small>}</span>
                                    <div>
                                        @if (!string.IsNullOrEmpty(p.DemoSlug))
                                        {
                                            <a class="btn btn-sm btn-outline-shop" href="@Url.Action("Index","Demo", new { slug = p.DemoSlug })" target="_blank" rel="noopener">مشاهده دمو</a>
                                        }
                                        <a class="btn btn-sm btn-primary-shop" href="@Url.Action("Details","Products", new { id = p.Id })">جزئیات و قیمت</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            if (!Model.Any())
            {
                <div class="alert alert-info">محصولی یافت نشد.</div>
            }
            }
        </div>
    </section>
</main>
