@model NikooSystem.Models.Product
@using NikooSystem.Helpers
@{
    ViewBag.Title = Model.Title;
    ViewBag.Nav = "products";
    var related = ViewBag.Related as List<NikooSystem.Models.Product> ?? new List<NikooSystem.Models.Product>();
}
<main id="main">
    <div class="page-hero">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">خانه</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Products")">محصولات</a></li>
                    <li class="breadcrumb-item active">@Model.Title</li>
                </ol>
            </nav>
        </div>
    </div>
    <section class="pb-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-6">
                    <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm w-100" style="max-height:420px;object-fit:cover;" alt="@Model.Title">
                </div>
                <div class="col-lg-6">
                    <div class="inner-card h-100">
                        <span class="badge bg-primary mb-2">@Model.Category</span>
                        <h1 class="h3">@Model.Title</h1>
                        <p class="text-muted">@Model.ShortDescription</p>
                        <p class="price fs-4 mb-3">@Model.Price.ToToman()</p>
                        <p>@Model.Description</p>
                        <div class="d-flex flex-wrap gap-2 mt-4">
                            @if (!string.IsNullOrEmpty(Model.DemoSlug))
                            {
                                <a class="btn-outline-shop" href="@Url.Action("Index","Demo", new { slug = Model.DemoSlug })"><i class="bi bi-eye"></i> مشاهده دمو فروشگاه</a>
                            }
                            <a class="btn-primary-shop" href="@Url.Action("Buy","Checkout", new { productId = Model.Id })"><i class="bi bi-cart-check"></i> درخواست دمو</a>
                        </div>
                    </div>
                </div>
            </div>

            @if (related.Any())
            {
                <h3 class="mt-5 mb-3">محصولات مرتبط</h3>
                <div class="row g-4">
                    @foreach (var p in related)
                    {
                        <div class="col-md-4">
                            <div class="product-card">
                                <img src="@p.ImageUrl" alt="@p.Title">
                                <div class="body">
                                    <h5>@p.Title</h5>
                                    <span class="price">@p.Price.ToToman()</span>
                                    <a class="btn btn-sm btn-primary-shop mt-2" href="@Url.Action("Details","Products", new { id = p.Id })">جزئیات</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</main>
