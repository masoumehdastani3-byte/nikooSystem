@model NikooSystem.Models.HubPayment
@{
    var ok = Model != null && Model.Status == NikooSystem.Models.HubPaymentStatus.Paid;
    var expired = Model != null && Model.Status == NikooSystem.Models.HubPaymentStatus.Expired;
    ViewBag.Title = ok ? "پرداخت موفق" : "بررسی پرداخت";
    ViewBag.Nav = "";
}
<main id="main">
    <div class="page-hero">
        <div class="container text-center">
            @if (ok)
            {
                <div class="success-icon"><i class="bi bi-check-circle"></i></div>
                <h1>پرداخت با موفقیت انجام شد</h1>
                <p class="text-muted">می‌توانید به سایت مبدأ بازگردید</p>
            }
            else
            {
                <div class="fail-icon"><i class="bi bi-x-circle"></i></div>
                <h1>@(expired ? "مهلت پرداخت به پایان رسیده است" : "پرداخت تأیید نشد")</h1>
                <p class="text-muted">اگر مبلغی از حساب شما کسر شده، پیش از پرداخت مجدد وضعیت را با سایت مبدأ یا پشتیبانی بررسی کنید.</p>
                <p class="text-muted">برای تلاش مجدد به سایت مبدأ بازگردید و درخواست پرداخت جدید ثبت کنید.</p>
                <a href="@Url.Action("Contact", "Home")" class="btn-outline-shop">تماس با پشتیبانی نیکو</a>
            }
        </div>
    </div>
    @if (Model != null)
    {
        <section class="pb-5">
            <div class="container" style="max-width:640px;">
                <div class="checkout-box">
                    <div class="d-flex justify-content-between mb-2"><span>شناسه پرداخت</span><strong>@Model.Token</strong></div>
                    <div class="d-flex justify-content-between mb-2"><span>شرح</span><strong>@Model.Description</strong></div>
                    <div class="d-flex justify-content-between mb-2"><span>مبلغ</span><strong>@Model.Amount.ToToman()</strong></div>
                    @if (Model.RefId.HasValue)
                    {
                        <div class="d-flex justify-content-between mb-2"><span>کد پیگیری</span><strong>@Model.RefId</strong></div>
                    }
                    @{
                        var returnUrl = ViewBag.SignedReturnUrl as string ?? Model.ReturnUrl;
                    }
                    @if (!string.IsNullOrWhiteSpace(returnUrl))
                    {
                        <hr />
                        <a href="@returnUrl" class="btn-primary-shop">بازگشت به سایت مبدأ</a>
                    }
                </div>
            </div>
        </section>
    }
</main>
