@{
    ViewBag.Title = "راهنمای اتصال پرداخت";
    ViewBag.Nav = "";
    var baseUrl = (ViewBag.BaseUrl as string) ?? "https://nikoooo.ir";
}
<main id="main">
    <div class="page-hero">
        <div class="container">
            <h1>هاب پرداخت نیکو سیستم آفرین</h1>
            <p class="text-muted">پروژه‌های دیگر بدون اتصال مستقیم به درگاه، از nikoooo.ir برای پرداخت استفاده می‌کنند</p>
        </div>
    </div>
    <section class="pb-5">
        <div class="container" style="max-width:900px;">
            <div class="checkout-box mb-4">
                <h5 class="mb-3">۱) ثبت کلاینت</h5>
                <p class="text-muted">در سرور nikoooo.ir یک ردیف به جدول <code>PaymentClients</code> دیتابیس <code>nikoo</code> و دامنه‌های مجاز بازگشت را به <code>PaymentClientHosts</code> اضافه کنید:</p>
<pre class="bg-light p-3 rounded" style="direction:ltr;text-align:left;white-space:pre-wrap;">INSERT INTO PaymentClients (AppId, ApiKey, Name) VALUES (N'my-shop', N'your-secret-key', N'فروشگاه من');
INSERT INTO PaymentClientHosts (AppId, Position, Host) VALUES
  (N'my-shop', 0, N'myshop.ir'),
  (N'my-shop', 1, N'localhost');</pre>
            </div>

            <div class="checkout-box mb-4">
                <h5 class="mb-3">۲) ساخت پرداخت</h5>
                <p><code>POST @baseUrl/api/payments/create</code></p>
                <p class="text-muted mb-2">هدرها: <code>X-App-Id</code> ، <code>X-Api-Key</code> ، <code>Content-Type: application/json</code></p>
<pre class="bg-light p-3 rounded" style="direction:ltr;text-align:left;white-space:pre-wrap;">{
  "amount": 150000,
  "description": "سفارش ۱۲۳",
  "returnUrl": "https://myshop.ir/payment/return",
  "notifyUrl": "https://myshop.ir/payment/notify",
  "externalRef": "ORD-123",
  "customerName": "علی رضایی",
  "customerMobile": "09121234567",
  "customerEmail": "ali@example.com"
}</pre>
                <p class="mt-3 mb-1">پاسخ:</p>
<pre class="bg-light p-3 rounded" style="direction:ltr;text-align:left;white-space:pre-wrap;">{
  "success": true,
  "token": "...",
  "paymentUrl": "@baseUrl/Pay/Start/...",
  "amount": 150000
}</pre>
                <p class="mt-2 text-muted">کاربر را به <code>paymentUrl</code> هدایت کنید. صفحه پرداخت روی nikoooo.ir باز می‌شود.</p>
            </div>

            <div class="checkout-box mb-4">
                <h5 class="mb-3">۳) بازگشت کاربر (ReturnUrl)</h5>
                <p>بعد از پرداخت موفق/ناموفق، کاربر به <code>returnUrl</code> شما برمی‌گردد با این پارامترها:</p>
                <ul>
                    <li><code>token</code> — شناسه پرداخت</li>
                    <li><code>status</code> — <code>paid</code> یا <code>failed</code></li>
                    <li><code>amount</code> — مبلغ به تومان</li>
                    <li><code>externalRef</code> — کد سفارش شما</li>
                    <li><code>refId</code> — کد پیگیری درگاه (در صورت موفقیت)</li>
                    <li><code>timestamp</code> — زمان UTC به ثانیه</li>
                    <li><code>signature</code> — امضای HMAC-SHA256</li>
                </ul>
                <p class="mb-1">فرمول امضا (با همان ApiKey):</p>
<pre class="bg-light p-3 rounded" style="direction:ltr;text-align:left;white-space:pre-wrap;">token|status|amount|externalRef|refId|timestamp</pre>
            </div>

            <div class="checkout-box mb-4">
                <h5 class="mb-3">۴) وب‌هوک (NotifyUrl)</h5>
                <p class="text-muted">همان فیلدها به‌صورت JSON با متد POST به آدرس شما ارسال می‌شود. حتی اگر کاربر صفحه را ببندد، وضعیت از این مسیر می‌رسد.</p>
            </div>

            <div class="checkout-box mb-4">
                <h5 class="mb-3">۵) استعلام وضعیت</h5>
                <p><code>GET @baseUrl/api/payments/status/&#123;token&#125;</code></p>
                <p class="text-muted">با همان هدرهای <code>X-App-Id</code> و <code>X-Api-Key</code>.</p>
            </div>

            <div class="checkout-box">
                <h5 class="mb-3">نمونه کلاینت C#</h5>
                <p class="text-muted">فایل آماده کپی در پروژه شما:</p>
                <p><code>App_Data/NikooPaymentClient.sample.cs</code></p>
            </div>
        </div>
    </section>
</main>
