@model SitePost
@{
    ViewBag.Title = Model.Title;
    ViewBag.Nav = "blog";
    var related = ViewBag.Related as List<SitePost> ?? new List<SitePost>();
    var trialDays = NikooSystem.Services.TenantProvisioningService.TrialDays;
}
<main id="main">
    <div class="page-hero">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">خانه</a></li>
                    <li class="breadcrumb-item"><a href="@Url.RouteUrl("Blog")">وبلاگ</a></li>
                    <li class="breadcrumb-item active">@Model.Title</li>
                </ol>
            </nav>
        </div>
    </div>
    <section class="pb-5">
        <div class="container">
            <article class="lf-article">
                <header>
                    <h1>@Model.Title</h1>
                    <div class="lf-article-meta">
                        <span><i class="bi bi-calendar3"></i> <time datetime="@Model.PublishedAt.ToString("yyyy-MM-dd")">@Model.PublishedAt.ToShamsiText()</time></span>
                        @if (!string.IsNullOrWhiteSpace(Model.Author))
                        {
                            <span><i class="bi bi-person"></i> @Model.Author</span>
                        }
                        @if (Model.UpdatedAt.HasValue && Model.UpdatedAt.Value.Date > Model.PublishedAt.Date)
                        {
                            <span><i class="bi bi-arrow-repeat"></i> به‌روزرسانی: @Model.UpdatedAt.Value.ToShamsiText()</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Summary))
                    {
                        <p class="lf-article-lead">@Model.Summary</p>
                    }
                </header>
                @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                {
                    <img class="lf-article-cover" src="@Model.CoverImageUrl" alt="@Model.Title" fetchpriority="high" />
                }
                <div class="lf-article-body">@Html.Raw(Model.BodyHtml)</div>

                @if (Model.TagList().Any())
                {
                    <div class="lf-article-tags">
                        <i class="bi bi-tags"></i>
                        @foreach (var t in Model.TagList())
                        {
                            <a href="@Url.RouteUrl("Blog", new { tag = t })">@t</a>
                        }
                    </div>
                }

                <aside class="lf-article-cta">
                    <div>
                        <strong>سایت یا فروشگاه اینترنتی خودتان را همین حالا بسازید</strong>
                        <span>@trialDays.ToFa() روز رایگان، بدون نیاز به برنامه‌نویسی؛ با درگاه پرداخت، سئو و پشتیبانی</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="lf-btn lf-btn-warm" href="@Url.Action("Index","Signup")"><i class="bi bi-rocket-takeoff"></i> ساخت رایگان</a>
                        <a class="lf-btn lf-btn-primary" href="@Url.Action("Index","Products")"><i class="bi bi-eye"></i> دیدن نمونه‌ها</a>
                    </div>
                </aside>
            </article>

            @if (related.Any())
            {
                <section class="mt-5">
                    <header class="lf-section-head">
                        <h2>مقاله‌های دیگر</h2>
                        <p>بیشتر بخوانید</p>
                    </header>
                    <div class="lf-store-grid">
                        @foreach (var post in related)
                        {
                            @Html.Partial("_BlogCard", post)
                        }
                    </div>
                </section>
            }
        </div>
    </section>
</main>
