@model PagedList<SitePost>
@{
    var tag = ViewBag.Tag as string;
    ViewBag.Title = tag == null ? "وبلاگ" : "مقالات " + tag;
    ViewBag.Nav = "blog";
}
<main id="main">
    <div class="page-hero">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">خانه</a></li>
                    @if (tag != null)
                    {
                        <li class="breadcrumb-item"><a href="@Url.RouteUrl("Blog")">وبلاگ</a></li>
                        <li class="breadcrumb-item active">@tag</li>
                    }
                    else
                    {
                        <li class="breadcrumb-item active">وبلاگ</li>
                    }
                </ol>
            </nav>
            <h1>@(tag == null ? "وبلاگ و مقالات آموزشی" : "مقالات «" + tag + "»")</h1>
            <p class="text-muted mb-0">راهنمای راه‌اندازی فروشگاه اینترنتی، فروش آنلاین، سئو و دیده شدن در گوگل</p>
        </div>
    </div>
    <section class="pb-5">
        <div class="container">
            @if (Model.Any())
            {
                <div class="lf-store-grid">
                    @foreach (var post in Model)
                    {
                        @Html.Partial("_BlogCard", post)
                    }
                </div>
                if (Model.TotalPages > 1)
                {
                    <nav class="lf-blog-pager" aria-label="صفحه‌های وبلاگ">
                        @if (Model.Page > 1)
                        {
                            <a class="btn btn-outline-shop" rel="prev" href="@Url.RouteUrl("Blog", new { page = Model.Page == 2 ? (int?)null : Model.Page - 1, tag })"><i class="bi bi-arrow-right"></i> جدیدتر</a>
                        }
                        <span>صفحه @Model.Page.ToFa() از @Model.TotalPages.ToFa()</span>
                        @if (Model.HasNext)
                        {
                            <a class="btn btn-outline-shop" rel="next" href="@Url.RouteUrl("Blog", new { page = Model.Page + 1, tag })">قدیمی‌تر <i class="bi bi-arrow-left"></i></a>
                        }
                    </nav>
                }
            }
            else
            {
                <div class="alert alert-info">به‌زودی مقاله‌های آموزشی این‌جا منتشر می‌شود.</div>
            }
        </div>
    </section>
</main>
