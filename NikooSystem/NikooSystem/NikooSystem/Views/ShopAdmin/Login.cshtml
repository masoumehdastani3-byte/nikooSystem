@model StoreLoginVm
@{
    Layout = null;
    var settings = (StoreSettings)ViewBag.Settings;
    var company = (string)ViewBag.CompanyCode;
    var primary = string.IsNullOrWhiteSpace(settings.PrimaryColor) ? "#1b4332" : settings.PrimaryColor;
    var accent = string.IsNullOrWhiteSpace(settings.SecondaryColor) ? "#95d5b2" : settings.SecondaryColor;
    var tenant = ViewBag.Tenant as TenantInfo;
    var isShowcase = tenant == null || string.IsNullOrEmpty(tenant.OwnerMobile);
    var kind = (SiteKindInfo)ViewBag.Kind;
    var siteNoun = kind.SiteNoun;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ورود مدیر - @settings.StoreName</title>
    <meta name="robots" content="noindex, nofollow" />
    <link href="@Url.Asset("~/Assets/css/style.css")" rel="stylesheet" />
    <link href="~/Assets/vendor/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/Assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --p: @primary;
            --a: @accent;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Far_Yekan', Tahoma, sans-serif;
            background: #f4f7f5;
            color: #1b4332;
        }
        .login-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.05fr .95fr;
        }
        .login-brand {
            position: relative;
            overflow: hidden;
            color: #fff;
            background:
                radial-gradient(800px 500px at 10% 10%, color-mix(in srgb, var(--a) 45%, transparent), transparent),
                radial-gradient(700px 400px at 90% 90%, rgba(255,255,255,.12), transparent),
                linear-gradient(145deg, var(--p), color-mix(in srgb, var(--p) 75%, #000));
            padding: clamp(2rem, 5vw, 4rem);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .login-brand::after {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            border: 40px solid rgba(255,255,255,.06);
            left: -120px;
            bottom: -140px;
        }
        .brand-top { position: relative; z-index: 1; }
        .brand-logo {
            display: inline-flex;
            align-items: center;
            gap: .75rem;
            margin-bottom: 2.5rem;
        }
        .brand-logo img {
            width: 52px;
            height: 52px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }
        .brand-logo strong {
            font-family: 'Far_Yekan', Tahoma, sans-serif;
            font-size: 1.6rem;
            letter-spacing: .03em;
        }
        .brand-kicker {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: rgba(255,255,255,.14);
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 999px;
            padding: .4rem .85rem;
            font-size: .85rem;
            font-weight: 600;
            margin-bottom: 1.25rem;
        }
        .login-brand h1 {
            font-size: clamp(1.8rem, 3.5vw, 2.7rem);
            line-height: 1.3;
            font-weight: 800;
            max-width: 12ch;
            margin: 0 0 1rem;
        }
        .login-brand p {
            max-width: 34ch;
            opacity: .88;
            font-size: 1.02rem;
            line-height: 1.7;
            margin: 0;
        }
        .brand-stats {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .75rem;
            margin-top: 3rem;
        }
        .brand-stat {
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 14px;
            padding: .9rem;
            backdrop-filter: blur(8px);
        }
        .brand-stat strong { display: block; font-size: 1.05rem; margin-bottom: .2rem; }
        .brand-stat span { font-size: .78rem; opacity: .8; }

        .login-panel {
            display: grid;
            place-items: center;
            padding: 2rem 1.25rem;
            background:
                radial-gradient(500px 300px at 100% 0%, color-mix(in srgb, var(--a) 28%, transparent), transparent),
                #f7faf8;
        }
        .login-card {
            width: min(440px, 100%);
            background: #fff;
            border: 1px solid #e5efe9;
            border-radius: 22px;
            box-shadow: 0 24px 60px rgba(27, 67, 50, .08);
            padding: 2rem 1.75rem 1.75rem;
            animation: rise .45s ease both;
        }
        @@keyframes rise {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: none; }
        }
        .login-card .eyebrow {
            color: var(--p);
            font-weight: 800;
            font-size: .82rem;
            letter-spacing: .04em;
            margin-bottom: .5rem;
        }
        .login-card h2 {
            font-size: 1.55rem;
            font-weight: 800;
            margin: 0 0 .35rem;
            color: #14352a;
        }
        .login-card .sub {
            color: #6b7c74;
            margin-bottom: 1.5rem;
            font-size: .92rem;
        }
        .code-pill {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            background: #eef7f1;
            color: var(--p);
            border-radius: 999px;
            padding: .25rem .7rem;
            font-size: .78rem;
            font-weight: 700;
            margin-bottom: 1.25rem;
        }
        .form-label {
            font-weight: 700;
            font-size: .88rem;
            color: #23483b;
            margin-bottom: .4rem;
        }
        .input-wrap {
            position: relative;
            margin-bottom: 1rem;
        }
        .input-wrap i {
            position: absolute;
            right: .9rem;
            top: 50%;
            transform: translateY(-50%);
            color: #8aa397;
            pointer-events: none;
        }
        .form-control {
            border-radius: 12px;
            border-color: #d7e5dc;
            padding: .8rem 2.5rem .8rem 1rem;
            min-height: 48px;
            background: #fbfdfc;
        }
        .form-control:focus {
            border-color: var(--p);
            box-shadow: 0 0 0 .2rem color-mix(in srgb, var(--a) 45%, transparent);
            background: #fff;
        }
        .btn-login {
            width: 100%;
            border: 0;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--p), color-mix(in srgb, var(--p) 80%, #000));
            color: #fff;
            font-weight: 800;
            padding: .9rem 1rem;
            margin-top: .35rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .45rem;
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(27, 67, 50, .22);
            color: #fff;
        }
        .login-links {
            display: flex;
            justify-content: space-between;
            gap: .75rem;
            margin-top: 1.15rem;
            font-size: .88rem;
        }
        .login-links a {
            color: var(--p);
            text-decoration: none;
            font-weight: 700;
        }
        .login-links a:hover { text-decoration: underline; }
        .demo-hint {
            margin-top: 1.25rem;
            background: #f3faf6;
            border: 1px dashed #c7e2d2;
            border-radius: 12px;
            padding: .85rem 1rem;
            font-size: .82rem;
            color: #4d6a5c;
        }
        .demo-hint code {
            background: #fff;
            border-radius: 6px;
            padding: .1rem .35rem;
            color: var(--p);
            font-weight: 700;
        }
        .validation-summary-errors, .text-danger {
            color: #c1121f !important;
            font-size: .88rem;
        }
        @@media (max-width: 900px) {
            .login-shell { grid-template-columns: 1fr; }
            .login-brand { min-height: 280px; }
            .login-brand h1 { max-width: none; }
            .brand-stats { grid-template-columns: 1fr 1fr 1fr; }
        }
        @@media (max-width: 560px) {
            .brand-stats { grid-template-columns: 1fr; }
            .login-card { padding: 1.5rem 1.15rem; }
        }
    </style>
</head>
<body>
<div class="login-shell">
    <aside class="login-brand">
        <div class="brand-top">
            <div class="brand-logo">
                @if (!string.IsNullOrEmpty(settings.LogoUrl))
                {
                    <img src="@settings.LogoUrl" alt="@settings.StoreName" />
                }
                <strong>@settings.StoreName</strong>
            </div>
            <div class="brand-kicker"><i class="bi bi-shield-lock"></i> پنل مدیریت امن @siteNoun</div>
            <h1>مدیریت @siteNoun خود را از اینجا شروع کنید</h1>
            <p>@(kind.IsContent ? "خبرها، مقاله‌ها، نظرات، پیام‌ها، منوها و صفحات را از یک پنل یکپارچه کنترل کنید."
                 : kind.IsBooking ? "نوبت‌ها، تقویم، خدمات، ساعت کاری متخصصان و بیعانه آنلاین را از یک پنل یکپارچه کنترل کنید."
                 : kind.IsDigital ? "دوره‌ها، کتاب‌ها، فایل‌ها، سفارش‌ها و درگاه پرداخت را از یک پنل یکپارچه کنترل کنید."
                 : "محصولات، سفارش‌ها، منوها، گالری و درگاه پرداخت را از یک پنل یکپارچه کنترل کنید.")</p>
        </div>
        <div class="brand-stats">
            @if (kind.IsContent)
            {
                <div class="brand-stat"><strong>مطالب</strong><span>تیتر یک، خبر فوری و زمان‌بندی</span></div>
                <div class="brand-stat"><strong>نظرات</strong><span>تأیید و پاسخ به خوانندگان</span></div>
            }
            else if (kind.IsBooking)
            {
                <div class="brand-stat"><strong>تقویم نوبت‌ها</strong><span>نمای هفتگی و ثبت نوبت تلفنی</span></div>
                <div class="brand-stat"><strong>متخصصان</strong><span>ساعت کاری، تعطیلی و مرخصی</span></div>
            }
            else if (kind.IsDigital)
            {
                <div class="brand-stat"><strong>دوره‌ها و کتاب‌ها</strong><span>جلسه‌ها و فایل‌های محافظت‌شده</span></div>
                <div class="brand-stat"><strong>سفارش‌ها</strong><span>دسترسی فوری پس از پرداخت</span></div>
            }
            else
            {
                <div class="brand-stat"><strong>محصولات</strong><span>مدیریت موجودی و گالری</span></div>
                <div class="brand-stat"><strong>سفارش‌ها</strong><span>پیگیری و وضعیت پرداخت</span></div>
            }
            <div class="brand-stat"><strong>ظاهر @siteNoun</strong><span>رنگ، منو و صفحات</span></div>
        </div>
    </aside>

    <section class="login-panel">
        <div class="login-card">
            <div class="eyebrow">خوش آمدید</div>
            <h2>ورود به پنل مدیریت</h2>
            <p class="sub">برای ادامه، اطلاعات حساب مدیر @siteNoun را وارد کنید.</p>
            <div class="code-pill"><i class="bi bi-building"></i> کد شرکت: @company</div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <label class="form-label" for="Username">نام کاربری</label>
                <div class="input-wrap">
                    <i class="bi bi-person"></i>
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = isShowcase ? "مثلاً admin" : "شماره موبایل", autocomplete = "username" })
                </div>

                <label class="form-label" for="Password">رمز عبور</label>
                <div class="input-wrap">
                    <i class="bi bi-lock"></i>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "رمز عبور خود را وارد کنید", autocomplete = "current-password" })
                </div>

                <button class="btn-login" type="submit">
                    ورود به پنل <i class="bi bi-arrow-left"></i>
                </button>
            }

            <div class="login-links">
                <a href="@Url.Action("Index","Shop", new { company })"><i class="bi @(kind.Sells ? "bi-shop" : "bi-house")"></i> بازگشت به @siteNoun</a>
                <a href="@Url.Action("Index","Home")" target="_blank">نیکو سیستم آفرین</a>
            </div>

            @if (isShowcase)
            {
                <div class="demo-hint">
                    برای دمو می‌توانید با <code>admin</code> و <code>Admin&#64;123</code> وارد شوید.
                    <br />می‌خواهید @siteNoun خودتان را داشته باشید؟ <a href="@Url.Action("Index","Signup")">رایگان بسازید</a>
                </div>
            }
        </div>
    </section>
</div>
</body>
</html>
