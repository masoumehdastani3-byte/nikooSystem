@model StoreFixedAsset
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = Model.Id > 0 ? "ویرایش مال" : "مال جدید";
    var company = (string)ViewBag.CompanyCode;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@ViewBag.Title</h2>
    <a class="btn-outline-store" href="@Url.Action("Assets","ShopAdmin", new { company })">بازگشت به لیست</a>
</div>
@using (Html.BeginForm("EditAsset", "ShopAdmin", new { company }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="panel-card row g-3 m-0">
        <div class="col-md-3">
            <label class="form-label" for="Code">کد</label>
            @Html.TextBoxFor(m => m.Code, new { @class = "form-control", maxlength = "20", dir = "ltr", placeholder = "خودکار" })
        </div>
        <div class="col-md-5">
            <label class="form-label" for="Title">نام مال</label>
            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", maxlength = "150", required = "required", placeholder = "مثلاً دروازه فوتبال" })
        </div>
        <div class="col-md-4">
            <label class="form-label" for="boughtOn">تاریخ خرید</label>
            <input class="form-control" type="date" id="boughtOn" name="boughtOn" dir="ltr" value="@Model.BoughtOn.ToString("yyyy-MM-dd", invariant)" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="Cost">بهای تمام‌شده (تومان)</label>
            @Html.TextBoxFor(m => m.Cost, new { @class = "form-control", type = "number", min = "0", step = "1000", dir = "ltr" })
        </div>
        <div class="col-md-4">
            <label class="form-label" for="Location">محل نگهداری</label>
            @Html.TextBoxFor(m => m.Location, new { @class = "form-control", maxlength = "120" })
        </div>
        <div class="col-md-4 d-flex align-items-end">
            @Html.BoolField("IsActive", Model.IsActive, "در حال استفاده")
        </div>
        <div class="col-12">
            <label class="form-label" for="Note">یادداشت</label>
            @Html.TextAreaFor(m => m.Note, new { @class = "form-control", rows = "2", maxlength = "500" })
        </div>
        <div class="col-12">
            <button class="btn-store" type="submit">ذخیره</button>
        </div>
    </div>
}
