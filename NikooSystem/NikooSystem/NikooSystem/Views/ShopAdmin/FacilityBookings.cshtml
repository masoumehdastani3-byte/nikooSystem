@model List<StoreFacilityBooking>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "رزرو سالن‌ها";
    var company = (string)ViewBag.CompanyCode;
    var facilities = (List<StoreFacility>)ViewBag.Facilities;
    var days = (List<KeyValuePair<string, string>>)ViewBag.Days;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">رزرو ساعتی سالن‌ها</h2>
</div>
@if (facilities.Any())
{
    <div class="panel-card mb-3">
        <h5>رزرو تلفنی</h5>
        <p class="small text-muted">این رزرو می‌تواند خارج از ساعت کاری باشد، ولی روی رزرو دیگری با ظرفیت پر ثبت نمی‌شود.</p>
        @using (Html.BeginForm("ManualFacilityBooking", "ShopAdmin", new { company }, FormMethod.Post, new { @class = "row g-2 align-items-end" }))
        {
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">سالن</label>
                <select class="form-select" name="facilityId" required>
                    @foreach (var item in facilities.Where(f => f.IsActive))
                    {
                        <option value="@item.Id">@item.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">روز</label>
                <select class="form-select" name="date" required>
                    @foreach (var day in days)
                    {
                        <option value="@day.Key">@day.Value</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">ساعت</label>
                <input class="form-control" name="time" type="time" step="300" required dir="ltr" />
            </div>
            <div class="col-md-2">
                <label class="form-label">نام</label>
                <input class="form-control" name="customerName" maxlength="80" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">موبایل</label>
                <input class="form-control" name="customerMobile" dir="ltr" required placeholder="0912..." />
            </div>
            <div class="col-12">
                <button class="btn-store" type="submit">ثبت رزرو</button>
            </div>
        }
    </div>
}
<div class="panel-card">
    <table class="table align-middle">
        <thead><tr><th>زمان</th><th>سالن</th><th>رزروکننده</th><th>مبلغ</th><th>وضعیت</th><th></th></tr></thead>
        <tbody>
            @foreach (var item in Model.Take(200))
            {
                <tr>
                    <td>@item.StartAt.ToShamsiText()<div class="small">@BookingTime.Clock(item.StartAt) تا @BookingTime.Clock(item.EndAt)</div></td>
                    <td>@item.FacilityTitle<div class="small text-muted" dir="ltr">@item.Code</div></td>
                    <td>@item.CustomerName<div class="small text-muted" dir="ltr">@item.CustomerMobile</div></td>
                    <td>@(item.Price > 0 ? item.Price.ToToman() : "رایگان")</td>
                    <td><span class="badge @item.Status.StatusBadgeClass()">@item.Status.StatusText()</span></td>
                    <td class="row-actions">
                        @if (item.Status == AppointmentStatus.Confirmed)
                        {
                            @Html.IconPost("SetFacilityBookingStatus", new { id = item.Id, status = AppointmentStatus.Completed }, "bi-check2-circle", "انجام شد", "is-view")
                            @Html.IconPost("SetFacilityBookingStatus", new { id = item.Id, status = AppointmentStatus.NoShow }, "bi-person-x", "نیامد", "is-delete")
                            @Html.IconPost("SetFacilityBookingStatus", new { id = item.Id, status = AppointmentStatus.Cancelled }, "bi-x-lg", "لغو", "is-delete", "این رزرو لغو شود؟")
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr class="admin-empty-row"><td colspan="6">هنوز رزروی نیست.</td></tr>
            }
        </tbody>
    </table>
</div>
