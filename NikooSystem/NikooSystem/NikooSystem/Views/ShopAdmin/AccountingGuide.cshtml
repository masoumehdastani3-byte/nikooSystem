@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    var kind = (SiteKindInfo)ViewBag.Kind;
    ViewBag.Title = AccountingCopy.GuideTitle(kind);
    var company = (string)ViewBag.CompanyCode;
}
<link href="@Url.Asset("~/Content/accounting.css")" rel="stylesheet" />
<div class="acc-form-head">
    <div>
        <h2 class="mb-0">@ViewBag.Title</h2>
        <p class="lead mb-0">مسیر کوتاه برای ثبت پول ورودی و خروجی، بدون نیاز به حسابدار حرفه‌ای.</p>
    </div>
</div>
<div class="panel-card acc-guide-card mb-3">
    @if (kind.IsBooking)
    {
        <p>در نوبت‌دهی، بخش اصلی درآمد از خود نوبت می‌آید. فاکتور و صندوق برای فروش متفرقه (مثلاً محصول آرایشی یا خدمت خارج از نوبت) است.</p>
        <h5>قدم به قدم</h5>
        <ol class="mb-0">
            <li><b>نوبت و دریافت مانده.</b> از تقویم یا فهرست نوبت، جزئیات نوبت را باز کنید و مبلغ نقد یا بانکی را ثبت کنید؛ سند خودکار زده می‌شود.</li>
            <li><b>@AccountingCopy.Pos(kind).</b> برای فروش سریع حضوری از <a href="@Url.Action("Pos","ShopAdmin", new { company })">صندوق</a> ردیف دستی با شرح خدمت بزنید یا اگر لوازم دارید از فهرست انتخاب کنید.</li>
            <li><b>@AccountingCopy.SaleInvoice(kind).</b> برای فاکتور کامل‌تر (نسیه، چند ردیف) از <a href="@Url.Action("SaleInvoices","ShopAdmin", new { company })">فاکتورها</a> استفاده کنید؛ ردیف بدون موجودی فقط درآمد خدمت است.</li>
            <li><b>بانک و صندوق.</b> در <a href="@Url.Action("Banks","ShopAdmin", new { company })">بانک‌ها و درگاه</a> حساب‌ها را تعریف کنید تا دریافت‌ها درست بنشیند.</li>
            <li><b>@AccountingCopy.Parties(kind).</b> نام مشتریان و تامین‌کنندگان را یک‌بار در <a href="@Url.Action("Parties","ShopAdmin", new { company })">طرف‌حساب‌ها</a> ثبت کنید.</li>
            <li><b>تراز و دفاتر.</b> گردش حساب‌ها را در <a href="@Url.Action("Books","ShopAdmin", new { company })">تراز و دفاتر</a> ببینید.</li>
        </ol>
    }
    else if (kind.IsCampus)
    {
        <p>شهریه کلاس و رزرو سالن وقتی آنلاین پرداخت شوند خودشان سند می‌خورند. صندوق و فاکتور برای فروش حضوری متفرقه و لوازم است.</p>
        <h5>قدم به قدم</h5>
        <ol class="mb-0">
            <li><b>شهریه و رزرو آنلاین.</b> پرداخت موفق ثبت‌نام یا سالن خودکار در دفاتر می‌نشیند.</li>
            <li><b>جلسه خصوصی.</b> مانده نوبت خصوصی را از صفحه همان نوبت نقد یا بانکی بگیرید.</li>
            <li><b>@AccountingCopy.Pos(kind).</b> فروش حضوری سریع از <a href="@Url.Action("Pos","ShopAdmin", new { company })">صندوق</a>؛ ردیف دستی برای خدمت بدون کالا هم هست.</li>
            <li><b>@AccountingCopy.SaleInvoice(kind).</b> فاکتور کامل در <a href="@Url.Action("SaleInvoices","ShopAdmin", new { company })">فاکتورها</a>.</li>
            <li><b>@AccountingCopy.Inventory(kind).</b> توپ، لباس و لوازم مصرفی را در <a href="@Url.Action("Inventory","ShopAdmin", new { company })">موجودی</a> نگه دارید؛ خریدشان از فاکتور خرید.</li>
            <li><b>تراز و دفاتر.</b> از <a href="@Url.Action("Books","ShopAdmin", new { company })">تراز و دفاتر</a> وضعیت را کنترل کنید.</li>
        </ol>
    }
    else if (kind.IsDigital)
    {
        <p>فروش آنلاین دوره و فایل خودش سند می‌زند. فروش حضوری یا کارت‌به‌کارت را با اعطای دسترسی یا فاکتور ثبت کنید.</p>
        <h5>قدم به قدم</h5>
        <ol class="mb-0">
            <li><b>اعطای دسترسی.</b> بدون درگاه از منوی فروش، دسترسی دوره/فایل را فعال کنید تا سند صندوق/بانک بخورد.</li>
            <li><b>صندوق و فاکتور.</b> برای فروش حضوری از <a href="@Url.Action("Pos","ShopAdmin", new { company })">صندوق</a> یا <a href="@Url.Action("SaleInvoices","ShopAdmin", new { company })">فاکتور فروش</a>.</li>
            <li><b>بانک و درگاه.</b> حساب درگاه سایت را در <a href="@Url.Action("Banks","ShopAdmin", new { company })">بانک‌ها</a> مشخص کنید.</li>
            <li><b>تراز و دفاتر.</b> در <a href="@Url.Action("Books","ShopAdmin", new { company })">تراز و دفاتر</a> ببینید.</li>
        </ol>
    }
    else
    {
        <p>این بخش برای ثبت خرید، فروش، موجودی و سندهای روزمره است و بر پایه حسابداری دوطرفه کار می‌کند: هر سند بدهکار و بستانکار برابر دارد.</p>
        <h5>قدم به قدم</h5>
        <ol class="mb-0">
            <li class="mb-2"><b>سرفصل حساب‌ها.</b> در <a href="@Url.Action("Accounts","ShopAdmin", new { company })">سرفصل حساب‌ها</a> ساختار گروه، کل و معین آماده است.</li>
            <li class="mb-2"><b>بانک‌ها و درگاه.</b> در <a href="@Url.Action("Banks","ShopAdmin", new { company })">بانک‌ها و درگاه</a> هر حساب را تعریف کنید و حساب درگاه سایت را مشخص کنید.</li>
            <li class="mb-2"><b>طرف‌حساب‌ها.</b> در <a href="@Url.Action("Parties","ShopAdmin", new { company })">تامین‌کنندگان و مشتریان</a> نام‌ها را یک‌بار ثبت کنید.</li>
            <li class="mb-2"><b>فاکتور خرید.</b> از <a href="@Url.Action("Purchases","ShopAdmin", new { company })">فاکتور خرید</a> موجودی را زیاد کنید یا هزینه/اموال بزنید.</li>
            <li class="mb-2"><b>انبار.</b> در <a href="@Url.Action("Inventory","ShopAdmin", new { company })">انبار</a> موجودی را ببینید و تعدیل کنید.</li>
            <li class="mb-2"><b>صندوق فروش.</b> فروش حضوری سریع از <a href="@Url.Action("Pos","ShopAdmin", new { company })">صندوق فروش</a>؛ تخفیف و مالیات ارزش افزوده را همان‌جا وارد کنید.</li>
            <li class="mb-2"><b>فاکتور فروش.</b> فروش کامل‌تر از <a href="@Url.Action("SaleInvoices","ShopAdmin", new { company })">فاکتور فروش</a>؛ ردیف‌ها، تخفیف و درصد مالیات را تنظیم کنید. نرخ پیش‌فرض در <a href="@Url.Action("FiscalYear","ShopAdmin", new { company })">سال مالی</a> است.</li>
            <li class="mb-2"><b>دریافت و پرداخت.</b> ورودی و خروجی متفرقه از <a href="@Url.Action("Payments","ShopAdmin", new { company })">دریافت و پرداخت</a>.</li>
            <li><b>تراز و دفاتر.</b> در <a href="@Url.Action("Books","ShopAdmin", new { company })">تراز و دفاتر</a> تراز چهارستونی و دفتر معین را ببینید.</li>
        </ol>
    }
</div>
<div class="panel-card acc-guide-card mb-3">
    <h5 class="mt-0">ساختار حساب‌ها (برای همه)</h5>
    <ul class="mb-0">
        <li class="mb-1"><b>گروه.</b> مثل دارایی، بدهی، درآمد و هزینه.</li>
        <li class="mb-1"><b>کل و معین.</b> سندها فقط به معین می‌خورند؛ مانده کل از جمع معین‌هاست.</li>
        <li><b>تفصیلی.</b> برای اشخاص و مراکز هزینه؛ در سرفصل معین مشخص می‌کنید اختیاری است یا اجباری.</li>
    </ul>
</div>
<div class="panel-card acc-guide-card">
    <h5 class="mt-0">سال مالی</h5>
    <ul class="mb-0">
        <li class="mb-1">در <a href="@Url.Action("FiscalYear","ShopAdmin", new { company })">سال مالی</a> ماه شروع (معمولاً فروردین) و قفل تاریخ را تنظیم کنید.</li>
        <li class="mb-1">اسناد، فاکتورها، دریافت و پرداخت و تراز به‌طور پیش‌فرض روی سال جاری فیلتر می‌شوند.</li>
        <li class="mb-0">با بستن سال تمام‌شده، درآمد و هزینه به «سود و زیان انباشته» منتقل می‌شود و آن سال قفل می‌گردد.</li>
    </ul>
</div>
