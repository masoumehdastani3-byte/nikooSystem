@model PagedList<StoreDocumentType>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "انواع سند";
    var company = (string)ViewBag.CompanyCode;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">انواع سند</h2>
    <a class="btn-store" href="@Url.Action("EditDocumentType","ShopAdmin", new { company })"><i class="bi bi-plus-lg"></i> نوع جدید</a>
</div>
<div class="panel-card">
    @Html.GridToolbar("جستجو در کد یا عنوان نوع سند…")
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    @Html.SortHeader("code", "کد")
                    @Html.SortHeader("title", "عنوان")
                    <th>وضعیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td dir="ltr">@item.Code</td>
                        <td>
                            <div class="fw-bold">@item.Title</div>
                            @if (item.IsSystem)
                            {
                                <div class="small text-muted">پیش‌فرض</div>
                            }
                        </td>
                        <td>@(item.IsActive ? "فعال" : "غیرفعال")</td>
                        <td class="row-actions">
                            @Html.IconLink(Url.Action("EditDocumentType", "ShopAdmin", new { company, id = item.Id }), "bi-pencil", "ویرایش", "is-edit")
                            @if (!item.IsSystem)
                            {
                                @Html.IconPost("DeleteDocumentType", new { id = item.Id }, "bi-trash", "حذف", "is-delete", "این نوع سند حذف شود؟")
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="4"><i class="bi bi-bookmark fs-3 d-block mb-1"></i>نوع سندی پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
