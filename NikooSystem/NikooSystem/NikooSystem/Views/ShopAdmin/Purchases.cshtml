@model PagedList<StorePurchaseInvoice>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "فاکتورهای خرید";
    var company = (string)ViewBag.CompanyCode;
    var pays = Enum.GetValues(typeof(PayWith)).Cast<PayWith>();
    var bankTitles = (Dictionary<int, string>)ViewBag.BankTitles;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">فاکتور خرید</h2>
    <a class="btn-store" href="@Url.Action("EditPurchase","ShopAdmin", new { company })"><i class="bi bi-plus-lg"></i> فاکتور جدید</a>
</div>
<div class="panel-card">
    @Html.GridToolbar("جستجو در شماره، تامین‌کننده یا یادداشت…", new GridSelect("pay", "همه روش‌های پرداخت", GridHtml.Options(pays, p => p, p => AccountingText.Pay(p))))
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    @Html.SortHeader("number", "شماره")
                    @Html.SortHeader("date", "تاریخ")
                    @Html.SortHeader("party", "تامین‌کننده")
                    @Html.SortHeader("pay", "پرداخت")
                    @Html.SortHeader("total", "مبلغ")
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td dir="ltr">@item.Number</td>
                        <td>@item.InvoiceDate.ToShamsi()</td>
                        <td>@item.PartyName</td>
                        <td>@(bankTitles.ContainsKey(item.BankId) ? bankTitles[item.BankId] : AccountingText.Pay(item.PayWith))</td>
                        <td>@item.Total.ToToman()</td>
                        <td class="row-actions">
                            @Html.IconLink(Url.Action("EditPurchase", "ShopAdmin", new { company, id = item.Id }), "bi-pencil", "ویرایش", "is-edit")
                            @Html.IconPost("DeletePurchase", new { id = item.Id }, "bi-trash", "حذف", "is-delete", "فاکتور حذف شود و موجودی برگردد؟")
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="6"><i class="bi bi-receipt fs-3 d-block mb-1"></i>فاکتور خریدی پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
