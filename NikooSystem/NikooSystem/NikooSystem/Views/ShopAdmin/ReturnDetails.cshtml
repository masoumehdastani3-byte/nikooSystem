@model StoreReturnRequest
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "مرجوعی " + Model.OrderNumber;
    var company = (string)ViewBag.CompanyCode;
    var order = (StoreOrder)ViewBag.Order;
    var banks = (List<StoreBankAccount>)ViewBag.Banks ?? new List<StoreBankAccount>();
    var lines = Model.Lines ?? new List<StoreReturnLine>();
    var goods = lines.Sum(l => l.Amount);
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">مرجوعی سفارش <span dir="ltr">@Model.OrderNumber</span></h2>
    <div class="d-flex gap-2 flex-wrap">
        @if (order != null)
        {
            <a class="btn-outline-store" href="@Url.Action("OrderDetails","ShopAdmin", new { company, id = order.Id })"><i class="bi bi-receipt"></i> سفارش</a>
        }
        <a class="btn-outline-store" href="@Url.Action("Returns","ShopAdmin", new { company })">بازگشت</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="panel-card mb-3">
            <h5 class="mb-3">اقلام درخواستی</h5>
            <table class="table align-middle">
                <thead><tr><th>کالا</th><th>تعداد</th><th>مبلغ واحد</th><th>جمع</th></tr></thead>
                <tbody>
                    @foreach (var line in lines)
                    {
                        <tr>
                            <td>@line.Title</td>
                            <td>@line.Quantity.ToFa()</td>
                            <td>@line.UnitPrice.ToToman()</td>
                            <td>@line.Amount.ToToman()</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="3" class="text-end">جمع کالاها</td><td>@goods.ToToman()</td></tr>
                    @if (Model.RefundAmount > 0)
                    {
                        <tr class="fw-bold"><td colspan="3" class="text-end">مبلغ برگشتی</td><td>@Model.RefundAmount.ToToman()</td></tr>
                    }
                </tfoot>
            </table>
        </div>

        @if (Model.Status == ReturnRequestStatus.Pending)
        {
            <div class="panel-card">
                <h5 class="mb-3">رسیدگی</h5>
                @using (Html.BeginForm("DecideReturn", "ShopAdmin", new { company }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">یادداشت برای خودتان</label>
                        <textarea class="form-control" name="adminNote" rows="2" maxlength="500">@Model.AdminNote</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">بازگشت وجه از</label>
                        <select class="form-select" name="payFrom">
                            @foreach (var option in AccountingText.PayOptions(banks, true, "Cash"))
                            {
                                <option value="@option.Key">@(option.Key == "Credit" ? "نسیه (بدهی به مشتری — بعداً تسویه)" : option.Value)</option>
                            }
                        </select>
                        <div class="form-text">با تأیید، موجودی برمی‌گردد و سند حسابداری ثبت می‌شود. وجه را از همان حساب به مشتری برگردانید.</div>
                    </div>
                    if (order != null && order.ShippingCost > 0 && !NikooSystem.Services.TenantStore.ShippingAlreadyRefunded(company, order.Id))
                    {
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="refundShipping" value="true" id="refundShipping" />
                            <label class="form-check-label" for="refundShipping">هزینه ارسال (@order.ShippingCost.ToToman()) هم برگشت بخورد</label>
                        </div>
                    }
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn-store" type="submit" name="decision" value="approve"><i class="bi bi-check2-circle"></i> تأیید مرجوعی</button>
                        <button class="btn-outline-store text-danger" type="submit" name="decision" value="reject"><i class="bi bi-x-circle"></i> رد درخواست</button>
                    </div>
                }
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="panel-card mb-3">
            <h5 class="mb-3">وضعیت</h5>
            @if (Model.Status == ReturnRequestStatus.Pending) { <span class="badge bg-warning text-dark">در انتظار</span> }
            else if (Model.Status == ReturnRequestStatus.Approved) { <span class="badge bg-success">تأیید شده</span> }
            else { <span class="badge bg-secondary">رد شده</span> }
            <dl class="row small mt-3 mb-0">
                <dt class="col-5">ثبت</dt><dd class="col-7">@Model.CreatedAt.ToShamsi()</dd>
                <dt class="col-5">رسیدگی</dt><dd class="col-7">@(Model.ResolvedAt.HasValue ? Model.ResolvedAt.Value.ToShamsi() : "—")</dd>
                <dt class="col-5">مشتری</dt><dd class="col-7">@Model.CustomerName</dd>
            </dl>
        </div>
        <div class="panel-card">
            <h5 class="mb-2">دلیل مشتری</h5>
            <p class="mb-0">@Model.Reason</p>
            @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
            {
                <hr />
                <div class="small text-muted">یادداشت شما</div>
                <div>@Model.AdminNote</div>
            }
        </div>
    </div>
</div>
