@model PagedList<StoreProductReview>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "نظرات مشتریان";
    var company = (string)ViewBag.CompanyCode;
    var products = (Dictionary<int, StoreProduct>)ViewBag.Products;
}
@Html.PageHeader("نظرات مشتریان")
<div class="panel-card">
    @Html.GridToolbar("جستجو در متن نظر یا نام نویسنده…",
        new GridSelect("state", "همه نظرها", new Dictionary<string, string> { ["pending"] = "مخفی", ["approved"] = "تأییدشده" }))
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>محصول</th>
                    @Html.SortHeader("author", "نویسنده")
                    @Html.SortHeader("rating", "امتیاز")
                    <th>نظر</th>
                    @Html.SortHeader("date", "تاریخ")
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    StoreProduct product;
                    products.TryGetValue(r.ProductId, out product);
                    <tr>
                        <td>
                            @if (product != null)
                            {
                                <a href="@Url.Action("Product", "Shop", new { company, slug = product.Slug })" target="_blank" rel="noopener">@product.Title</a>
                            }
                            else
                            {
                                <span class="text-muted">محصول حذف‌شده</span>
                            }
                        </td>
                        <td>@r.AuthorName</td>
                        <td class="text-warning text-nowrap" title="@r.Rating از ۵">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                            }
                        </td>
                        <td>
                            @r.Comment
                            @if (!r.IsApproved) { <span class="badge bg-secondary">مخفی</span> }
                        </td>
                        <td class="small text-muted">@r.CreatedAt.ToShamsi()</td>
                        <td class="row-actions">
                            @if (r.IsApproved)
                            {
                                @Html.IconPost("ToggleReview", new { id = r.Id, approved = false }, "bi-eye-slash", "مخفی کردن", "is-toggle")
                            }
                            else
                            {
                                @Html.IconPost("ToggleReview", new { id = r.Id, approved = true }, "bi-check2-circle", "تأیید و نمایش", "is-ok")
                            }
                            @Html.DeleteButton("DeleteReview", r.Id, "این نظر حذف شود؟")
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="6"><i class="bi bi-chat-square-text fs-3 d-block mb-1"></i>نظری پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
