@model PagedList<TreeRow<StoreMenuItem>>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "منوها";
    var locations = new Dictionary<string, string> { ["main"] = "منوی اصلی", ["footer"] = "فوتر" };
}
@Html.PageHeader("منوی درختی", "آیتم جدید", "EditMenu")
<div class="panel-card">
    @Html.GridToolbar("جستجو در عنوان منو…", new GridSelect("location", "همه محل‌ها", locations))
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    @Html.SortHeader("title", "عنوان")
                    @Html.SortHeader("location", "محل")
                    @Html.SortHeader("link", "لینک")
                    <th>والد</th>
                    @Html.SortHeader("sort", "ترتیب")
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var m = row.Node;
                    <tr class="nk-tree-row" data-depth="@row.Depth" data-id="@m.Id">
                        <td>
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                @Html.TreeNode(m.Title, row.Depth, row.HasChildren, row.IsLast)
                                @if (!m.IsActive) { <span class="badge bg-secondary">غیرفعال</span> }
                            </div>
                        </td>
                        <td>@(locations.ContainsKey(m.Location ?? "") ? locations[m.Location] : m.Location)</td>
                        <td class="small" dir="ltr">@m.Url</td>
                        <td>@(row.Parent?.Title ?? "—")</td>
                        <td>@m.SortOrder</td>
                        <td class="row-actions">
                            @Html.IconLink(Url.Action("EditMenu", "ShopAdmin", new { company = ViewBag.CompanyCode, parent = m.Id }), "bi-plus-square", "افزودن زیرمنو", "is-ok")
                            @Html.EditLink("EditMenu", m.Id)
                            @Html.DeleteButton("DeleteMenu", m.Id, "«" + m.Title + "» و زیرمجموعه‌هایش حذف شوند؟")
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="6"><i class="bi bi-list-nested fs-3 d-block mb-1"></i>آیتمی پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
