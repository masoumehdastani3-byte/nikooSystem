@model NikooSystem.Models.Store.StoreProduct
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = Model.Id > 0 ? "ویرایش محصول" : "محصول جدید";
    var company = (string)ViewBag.CompanyCode;
    var cats = (IEnumerable<NikooSystem.Models.Store.StoreCategory>)ViewBag.Categories;
    var attrs = (IEnumerable<NikooSystem.Models.Store.StoreAttributeDef>)ViewBag.AttributeDefs;
    var tags = ((IEnumerable<NikooSystem.Models.Store.StoreCollection>)ViewBag.Collections)?.ToList() ?? new List<NikooSystem.Models.Store.StoreCollection>();
    var productTags = Model.CollectionIds ?? new List<int>();
}
<h2 class="mb-3">@ViewBag.Title</h2>
@using (Html.BeginForm("EditProduct", "ShopAdmin", new { company }, FormMethod.Post, new { enctype = "multipart/form-data", id = "productForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <input type="hidden" name="removeImageIds" id="removeImageIds" value="" />
    <div class="panel-card row g-3">
        <div class="col-md-8"><label class="form-label">عنوان</label>@Html.TextBoxFor(m => m.Title, new { @class = "form-control" })</div>
        <div class="col-md-4"><label class="form-label">اسلاگ</label>@Html.TextBoxFor(m => m.Slug, new { @class = "form-control" })</div>
        <div class="col-md-4">
            <label class="form-label">گروه</label>
            <select class="form-select" name="CategoryId" id="CategoryId">
                @foreach (var c in cats)
                {
                    <option value="@c.Id" @(Model.CategoryId == c.Id ? "selected" : "")>@(c.ParentId.HasValue ? "— " : "")@c.Title</option>
                }
            </select>
            <div class="form-text">خصوصیات بر اساس گروه کالا فیلتر می‌شوند.</div>
        </div>
        <div class="col-md-4"><label class="form-label">قیمت (تومان)</label>@Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number" })</div>
        <div class="col-md-4"><label class="form-label">موجودی</label>@Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number" })</div>
        <div class="col-12"><label class="form-label">توضیح کوتاه</label>@Html.TextBoxFor(m => m.ShortDescription, new { @class = "form-control" })</div>
        <div class="col-12"><label class="form-label">توضیحات</label>@Html.TextAreaFor(m => m.Description, 4, 1, new { @class = "form-control" })</div>

        <div class="col-12">
            <h5>گالری تصاویر محصول</h5>
            <p class="text-muted small">چند تصویر را همزمان انتخاب کنید. نسخه کوچک و بزرگ ساخته می‌شود و در صفحه جزئیات نمایش داده می‌شود.</p>
            <input class="form-control" type="file" name="imageFiles" accept="image/*" multiple />
            @if (Model.Images != null && Model.Images.Any())
            {
                <div class="d-flex flex-wrap gap-2 mt-3" id="galleryPreview">
                    @foreach (var img in Model.Images.OrderBy(i => i.SortOrder))
                    {
                        <div class="position-relative border rounded p-1" data-img-id="@img.Id" style="width:110px;">
                            <img src="@(img.ThumbUrl ?? img.LargeUrl)" class="w-100 rounded" style="height:90px;object-fit:cover;" alt="" />
                            <button type="button" class="btn btn-sm btn-danger w-100 mt-1" onclick="markRemove('@img.Id', this)">حذف</button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-md-3 form-check mt-4 pt-3"><label><input type="checkbox" name="IsActive" value="true" @(Model.IsActive?"checked":"") /> فعال</label><input type="hidden" name="IsActive" value="false" /></div>
        <div class="col-md-3 form-check mt-4 pt-3"><label><input type="checkbox" name="IsFeatured" value="true" @(Model.IsFeatured?"checked":"") /> ویژه</label><input type="hidden" name="IsFeatured" value="false" /></div>
        <div class="col-12">
            <h5>برچسب‌های ویژه</h5>
            @if (tags.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var t in tags)
                    {
                        <label class="tag-check">
                            <input type="checkbox" name="CollectionIds" value="@t.Id" @(productTags.Contains(t.Id) ? "checked" : "") />
                            <span><i class="bi bi-tag"></i> @t.Title@(t.IsActive ? "" : " (غیرفعال)")</span>
                        </label>
                    }
                </div>
                <div class="form-text">کالا در ردیف‌های صفحه اول و صفحه هر برچسب نمایش داده می‌شود.</div>
            }
            else
            {
                <div class="text-muted small">
                    هنوز برچسبی ندارید. با برچسب‌ها می‌توانید کالاهایی مثل «ویژه روز دختر» را در صفحه اول جدا نمایش دهید —
                    <a href="@Url.Action("EditCollection","ShopAdmin", new { company })">ساخت برچسب</a>
                </div>
            }
        </div>
        <div class="col-12">
            <h5>خصوصیات محصول (مرتبط با گروه)</h5>
            <div id="attrs">
                @foreach (var def in attrs)
                {
                    var val = Model.Attributes?.FirstOrDefault(a => a.AttributeId == def.Id)?.Value ?? "";
                    <div class="row g-2 mb-2 attr-row" data-id="@def.Id" data-name="@def.Name">
                        <div class="col-md-4"><label class="form-label">@def.Name</label></div>
                        <div class="col-md-8">
                            @if (def.InputType == "select" && !string.IsNullOrEmpty(def.Options))
                            {
                                <select class="form-select attr-val">
                                    <option value="">—</option>
                                    @foreach (var opt in def.Options.Split(','))
                                    {
                                        var o = opt.Trim();
                                        <option value="@o" @(val == o ? "selected" : "")>@o</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input class="form-control attr-val" value="@val" />
                            }
                        </div>
                    </div>
                }
                @if (!attrs.Any())
                {
                    <div class="text-muted">برای این گروه خصوصیتی تعریف نشده. از منوی خصوصیات به گروه وصل کنید.</div>
                }
            </div>
            <input type="hidden" name="attrJson" id="attrJson" />
        </div>
        <div class="col-12">
            <button class="btn-store" type="submit" onclick="packAttrs()">ذخیره محصول</button>
            <a class="btn-outline-store" href="@Url.Action("Products","ShopAdmin", new { company })">بازگشت</a>
        </div>
    </div>
}
<script>
var removeIds=[];
function markRemove(id, btn){
  if(!id) return;
  removeIds.push(id);
  document.getElementById('removeImageIds').value=removeIds.join(',');
  btn.closest('[data-img-id]').style.opacity='0.35';
  btn.disabled=true;
  btn.textContent='حذف می‌شود';
}
function packAttrs(){
  var list=[];
  document.querySelectorAll('.attr-row').forEach(function(row){
    var v=row.querySelector('.attr-val').value;
    if(v) list.push({AttributeId:parseInt(row.dataset.id),Name:row.dataset.name,Value:v});
  });
  document.getElementById('attrJson').value=JSON.stringify(list);
}
</script>
