@model PagedList<StoreAttributeDef>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "خصوصیات محصول";
    var cats = ((IEnumerable<StoreCategory>)ViewBag.Categories).ToDictionary(c => c.Id, c => c.Title);
    var inputTypes = new Dictionary<string, string> { ["text"] = "متن", ["number"] = "عدد", ["select"] = "انتخابی" };
}
@Html.PageHeader("خصوصیات محصول", "خصوصیت جدید", "EditAttribute")
<div class="panel-card">
    @Html.GridToolbar("جستجو در نام یا گزینه‌ها…")
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    @Html.SortHeader("name", "نام")
                    @Html.SortHeader("type", "نوع")
                    <th>گروه‌های مرتبط</th>
                    <th>فیلتر</th>
                    @Html.SortHeader("sort", "ترتیب")
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var linked = (a.CategoryIds == null || !a.CategoryIds.Any())
                        ? "همه گروه‌ها"
                        : string.Join("، ", a.CategoryIds.Where(id => cats.ContainsKey(id)).Select(id => cats[id]));
                    <tr>
                        <td>
                            @a.Name
                            @if (a.InputType == "select" && !string.IsNullOrEmpty(a.Options)) { <div class="small text-muted">@a.Options</div> }
                        </td>
                        <td>@(inputTypes.ContainsKey(a.InputType ?? "") ? inputTypes[a.InputType] : a.InputType)</td>
                        <td class="small">@linked</td>
                        <td>@(a.IsFilterable ? "بله" : "خیر")</td>
                        <td>@a.SortOrder</td>
                        <td class="row-actions">
                            @Html.EditLink("EditAttribute", a.Id)
                            @Html.DeleteButton("DeleteAttribute", a.Id, "خصوصیت «" + a.Name + "» حذف شود؟")
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="6"><i class="bi bi-sliders fs-3 d-block mb-1"></i>خصوصیتی پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
