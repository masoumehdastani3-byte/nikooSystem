@model StoreDocumentType
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = Model.Id > 0 ? "ویرایش نوع سند" : "نوع سند جدید";
    var company = (string)ViewBag.CompanyCode;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@ViewBag.Title</h2>
    <a class="btn-outline-store" href="@Url.Action("DocumentTypes","ShopAdmin", new { company })">بازگشت به لیست</a>
</div>
@using (Html.BeginForm("EditDocumentType", "ShopAdmin", new { company }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.IsSystem)
    <div class="panel-card row g-3 m-0">
        <div class="col-md-3">
            <label class="form-label" for="Code">کد</label>
            @Html.TextBoxFor(m => m.Code, new { @class = "form-control", maxlength = "20", dir = "ltr", placeholder = "خودکار", @readonly = Model.IsSystem ? "readonly" : null })
        </div>
        <div class="col-md-5">
            <label class="form-label" for="Title">عنوان</label>
            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", maxlength = "80", required = "required", placeholder = "مثلاً هزینه اجاره" })
        </div>
        <div class="col-md-4 d-flex align-items-end">
            @Html.BoolField("IsActive", Model.IsActive, "فعال")
        </div>
        <div class="col-12">
            <button class="btn-store" type="submit">ذخیره</button>
        </div>
    </div>
}
