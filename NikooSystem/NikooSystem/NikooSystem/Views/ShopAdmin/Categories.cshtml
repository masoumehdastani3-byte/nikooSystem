@model PagedList<TreeRow<StoreCategory>>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    var kind = (SiteKindInfo)ViewBag.Kind;
    var title = kind.IsContent ? "سرویس‌ها و دسته‌بندی مطالب" : "گروه‌های محصول";
    ViewBag.Title = title;
    var company = (string)ViewBag.CompanyCode;
}
@Html.PageHeader(title + " (درختی)", "گروه جدید", "EditCategory")
<div class="panel-card">
    @Html.GridToolbar("جستجو در عنوان گروه…")
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>عنوان</th><th>والد</th><th>اسلاگ</th><th>ترتیب</th><th>وضعیت</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var c = row.Node;
                    <tr>
                        <td style="padding-inline-start:@(12 + row.Depth * 24)px">
                            @if (row.Depth > 0) { <i class="bi bi-arrow-return-left text-muted"></i> }
                            @c.Title
                        </td>
                        <td>@(row.Parent?.Title ?? "—")</td>
                        <td dir="ltr" class="text-end small">@c.Slug</td>
                        <td>@c.SortOrder</td>
                        <td>@(c.IsActive ? "فعال" : "غیرفعال")</td>
                        <td class="row-actions">
                            @Html.IconLink(Url.Action(kind.IsContent ? "Blog" : "Catalog", "Shop", new { company, categoryId = c.Id }), "bi-eye", "مشاهده در سایت", "is-view", true)
                            @Html.EditLink("EditCategory", c.Id)
                            @Html.DeleteButton("DeleteCategory", c.Id, "«" + c.Title + "» و زیرمجموعه‌هایش حذف شوند؟")
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="6"><i class="bi bi-diagram-3 fs-3 d-block mb-1"></i>گروهی پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
