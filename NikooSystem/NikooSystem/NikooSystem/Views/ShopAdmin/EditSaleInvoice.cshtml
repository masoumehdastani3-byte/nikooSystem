@model StoreSalesInvoice
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = Model.Id > 0 ? "ویرایش فاکتور فروش" : "فاکتور فروش";
    var company = (string)ViewBag.CompanyCode;
    var products = (List<StoreProduct>)ViewBag.Products;
    var goods = (List<StoreGoodsItem>)ViewBag.Goods;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    var lines = Model.Lines ?? new List<StoreSaleLine>();
    var parties = (List<StoreParty>)ViewBag.Parties;
    var siteCustomers = (List<StoreCustomer>)ViewBag.SiteCustomers;
    var banks = (List<StoreBankAccount>)ViewBag.Banks;
    var payToken = AccountingText.PayToken(Model.PayWith, Model.BankId);
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@ViewBag.Title</h2>
    <a class="btn-outline-store" href="@Url.Action("SaleInvoices","ShopAdmin", new { company })">بازگشت به لیست</a>
</div>
@using (Html.BeginForm("EditSaleInvoice", "ShopAdmin", new { company }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="panel-card row g-3 m-0 mb-3">
        <div class="col-md-4">
            <label class="form-label" for="party">مشتری</label>
            <select class="form-select" name="party" id="party">
                <option value="">— از فهرست مشتریان انتخاب کنید —</option>
                <optgroup label="مشتریان حسابداری">
                    @foreach (var party in parties)
                    {
                        <option value="t-@party.Id" @(Model.PartyId == party.Id ? "selected" : null)>@(party.Name + (string.IsNullOrWhiteSpace(party.Mobile) ? "" : " — " + party.Mobile) + (party.IsActive ? "" : " (غیرفعال)"))</option>
                    }
                </optgroup>
                @if (siteCustomers.Any())
                {
                    <optgroup label="مشتریان عضو سایت">
                        @foreach (var customer in siteCustomers)
                        {
                            <option value="c-@customer.Id">@(customer.FullName + (string.IsNullOrWhiteSpace(customer.Mobile) ? "" : " — " + customer.Mobile))</option>
                        }
                    </optgroup>
                }
            </select>
            <div class="form-text">
                در فهرست نیست؟
                <a target="_blank" rel="noopener" href="@Url.Action("EditParty","ShopAdmin", new { company, kind = PartyKind.Customer })">تعریف مشتری</a>
                یا نامش را پایین بنویسید تا به فهرست اضافه شود.
            </div>
            <input class="form-control form-control-sm mt-1" name="newParty" maxlength="150" placeholder="نام مشتری تازه" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="invoiceDate">تاریخ</label>
            <input class="form-control" type="date" id="invoiceDate" name="invoiceDate" dir="ltr" value="@Model.InvoiceDate.ToString("yyyy-MM-dd", invariant)" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="payFrom">دریافت در</label>
            <select class="form-select" name="payFrom" id="payFrom">
                @foreach (var option in AccountingText.PayOptions(banks, true, payToken))
                {
                    <option value="@option.Key" @(option.Key == payToken ? "selected" : null)>@option.Value</option>
                }
            </select>
        </div>
        <div class="col-md-12">
            <label class="form-label" for="Note">یادداشت</label>
            @Html.TextBoxFor(m => m.Note, new { @class = "form-control", maxlength = "500" })
        </div>
    </div>
    <div class="panel-card">
        <table class="table align-middle">
            <thead><tr><th>شرح</th><th>کالا</th><th>تعداد</th><th>قیمت واحد</th></tr></thead>
            <tbody>
                @for (var i = 0; i < 8; i++)
                {
                    var line = i < lines.Count ? lines[i] : new StoreSaleLine();
                    var selected = line.ProductId > 0 ? "p-" + line.ProductId.ToString(invariant) : (line.GoodsId > 0 ? "g-" + line.GoodsId.ToString(invariant) : "");
                    <tr>
                        <td><input class="form-control" name="lineTitle" maxlength="150" value="@line.Title" /></td>
                        <td>
                            <select class="form-select" name="lineStock">
                                <option value="">بدون کسر از موجودی</option>
                                @if (products.Any())
                                {
                                    <optgroup label="محصولات فروشگاه">
                                        @foreach (var product in products)
                                        {
                                            var token = "p-" + product.Id.ToString(invariant);
                                            <option value="@token" @(selected == token ? "selected" : null)>@product.Title@(string.IsNullOrWhiteSpace(product.Sku) ? "" : " — " + product.Sku) (@product.Stock.ToFa())</option>
                                        }
                                    </optgroup>
                                }
                                @if (goods.Any())
                                {
                                    <optgroup label="کالاهای انبار">
                                        @foreach (var item in goods)
                                        {
                                            var token = "g-" + item.Id.ToString(invariant);
                                            <option value="@token" @(selected == token ? "selected" : null)>@item.Title@(string.IsNullOrWhiteSpace(item.Code) ? "" : " — " + item.Code) (@item.Qty.ToFa())</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </td>
                        <td><input class="form-control" type="number" min="0" step="1" dir="ltr" name="lineQty" value="@(line.Qty > 0 ? line.Qty.ToString(invariant) : "")" /></td>
                        <td><input class="form-control" inputmode="numeric" data-money dir="ltr" name="linePrice" value="@(line.UnitPrice > 0 ? line.UnitPrice.ToString(invariant) : "")" /></td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="small text-muted">اگر موجودی کافی نباشد فاکتور ثبت نمی‌شود. بهای تمام‌شده از میانگین خریدها به سند می‌رود. ردیف بدون کالا فقط درآمد است و از انبار کم نمی‌شود.</p>
        <button class="btn-store" type="submit">ثبت فاکتور</button>
    </div>
}
