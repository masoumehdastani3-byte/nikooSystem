@model PagedList<StorePage>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "صفحات";
    var company = (string)ViewBag.CompanyCode;
}
@Html.PageHeader("صفحات سایت", "صفحه جدید", "EditPage")
<div class="panel-card">
    @Html.GridToolbar("جستجو در عنوان یا اسلاگ…")
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    @Html.SortHeader("title", "عنوان")
                    @Html.SortHeader("slug", "اسلاگ")
                    <th>وضعیت</th>
                    @Html.SortHeader("updated", "آخرین تغییر")
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Title</td>
                        <td dir="ltr" class="text-end small">@p.Slug</td>
                        <td>
                            @if (p.IsPublished) { <span class="badge bg-success-subtle text-success-emphasis">منتشر</span> }
                            else { <span class="badge bg-secondary">پیش‌نویس</span> }
                        </td>
                        <td class="small text-muted">@p.UpdatedAt.ToShamsi()</td>
                        <td class="row-actions">
                            @Html.IconLink(Url.Action("Page", "Shop", new { company, slug = p.Slug }), "bi-eye", "مشاهده در سایت", "is-view", true)
                            @Html.EditLink("EditPage", p.Id)
                            @Html.DeleteButton("DeletePage", p.Id, "صفحه «" + p.Title + "» حذف شود؟")
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="5"><i class="bi bi-file-earmark-text fs-3 d-block mb-1"></i>صفحه‌ای پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
