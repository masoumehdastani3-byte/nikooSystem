@model IEnumerable<NikooSystem.Models.Store.StorePage>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "صفحات";
    var company = (string)ViewBag.CompanyCode;
}
<div class="d-flex justify-content-between mb-3">
    <h2>صفحات سایت</h2>
    <a class="btn-store" href="@Url.Action("EditPage","ShopAdmin", new { company })">صفحه جدید</a>
</div>
<div class="panel-card">
    <table class="table">
        <thead><tr><th>عنوان</th><th>اسلاگ</th><th>وضعیت</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Title</td>
                <td>@p.Slug</td>
                <td>@(p.IsPublished ? "منتشر" : "پیش‌نویس")</td>
                <td class="text-nowrap">
                    <a href="@Url.Action("EditPage","ShopAdmin", new { company, id = p.Id })">ویرایش</a> |
                    <a href="@Url.Action("Page","Shop", new { company, slug = p.Slug })" target="_blank">مشاهده</a>
                    @using (Html.BeginForm("DeletePage", "ShopAdmin", new { company }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('حذف شود؟');" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />
                        <button class="btn btn-link text-danger p-0" type="submit">حذف</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
