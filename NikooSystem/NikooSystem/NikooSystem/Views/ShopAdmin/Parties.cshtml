@model PagedList<StoreParty>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "تامین‌کنندگان و مشتریان";
    var company = (string)ViewBag.CompanyCode;
    var kinds = new[] { PartyKind.Supplier, PartyKind.Customer };
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">تامین‌کنندگان و مشتریان</h2>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn-store" href="@Url.Action("EditParty","ShopAdmin", new { company, kind = PartyKind.Supplier })"><i class="bi bi-plus-lg"></i> تامین‌کننده جدید</a>
        <a class="btn-outline-store" href="@Url.Action("EditParty","ShopAdmin", new { company, kind = PartyKind.Customer })"><i class="bi bi-plus-lg"></i> مشتری جدید</a>
    </div>
</div>
<div class="panel-card">
    <p class="small text-muted">فاکتور خرید به نام یکی از تامین‌کنندگان و فاکتور فروش به نام یکی از مشتریان این فهرست صادر می‌شود. کسی که هم می‌فروشد و هم می‌خرد را «تامین‌کننده و مشتری» بگذارید.</p>
    @Html.GridToolbar("جستجو در نام، کد، موبایل، تلفن یا نشانی…", new GridSelect("kind", "همه طرف حساب‌ها", GridHtml.Options(kinds, k => k, k => AccountingText.Party(k))))
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    @Html.SortHeader("code", "کد")
                    @Html.SortHeader("name", "نام")
                    @Html.SortHeader("kind", "نوع")
                    @Html.SortHeader("mobile", "موبایل")
                    <th>وضعیت</th>
                    @Html.SortHeader("created", "تاریخ ثبت")
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td dir="ltr">@item.Code</td>
                        <td>
                            <div class="fw-bold">@item.Name</div>
                            @if (!string.IsNullOrWhiteSpace(item.Phone))
                            {
                                <div class="small text-muted" dir="ltr">@item.Phone</div>
                            }
                        </td>
                        <td>@AccountingText.Party(item.Kind)</td>
                        <td dir="ltr" class="text-end">@item.Mobile</td>
                        <td>@(item.IsActive ? "فعال" : "غیرفعال")</td>
                        <td class="small text-muted">@item.CreatedAt.ToShamsi()</td>
                        <td class="row-actions">
                            @Html.IconLink(Url.Action("EditParty", "ShopAdmin", new { company, id = item.Id }), "bi-pencil", "ویرایش", "is-edit")
                            @Html.IconPost("DeleteParty", new { id = item.Id }, "bi-trash", "حذف", "is-delete", "این طرف حساب حذف شود؟")
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="7"><i class="bi bi-people fs-3 d-block mb-1"></i>تامین‌کننده یا مشتری‌ای پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
