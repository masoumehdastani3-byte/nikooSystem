@model PagedList<StoreGalleryItem>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "گالری";
    var company = (string)ViewBag.CompanyCode;
    var albums = (List<string>)ViewBag.Albums;
    var baseUrl = Request.Url.GetLeftPart(UriPartial.Authority).TrimEnd('/');

    Func<string, string> fullUrl = (path) =>
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return path;
        return baseUrl + (path.StartsWith("/") ? path : "/" + path);
    };
}
<h2 class="mb-3">گالری تصاویر</h2>
<p class="text-muted">آدرس کامل هر تصویر را کپی کنید و در ادیتور صفحات (درج تصویر) استفاده کنید.</p>

<div class="panel-card mb-3">
    @using (Html.BeginForm("UploadGallery", "ShopAdmin", new { company }, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label">عنوان</label><input class="form-control" name="title" /></div>
            <div class="col-md-3">
                <label class="form-label">آلبوم</label>
                <input class="form-control" name="album" value="عمومی" list="gallery-albums" />
                <datalist id="gallery-albums">
                    @foreach (var a in albums) { <option value="@a"></option> }
                </datalist>
            </div>
            <div class="col-md-4"><label class="form-label">تصاویر (چندتایی)</label><input class="form-control" type="file" name="imageFiles" accept="image/*" multiple required /></div>
            <div class="col-md-2"><button class="btn-store w-100" type="submit"><i class="bi bi-cloud-arrow-up"></i> آپلود</button></div>
        </div>
    }
</div>

<div class="panel-card">
    @Html.GridToolbar("جستجو در عنوان تصویر…", new GridSelect("album", "همه آلبوم‌ها", GridHtml.Options(albums, a => a, a => a)))
    <div class="row g-3">
        @foreach (var g in Model)
        {
            var largeFull = fullUrl(g.LargeUrl);
            <div class="col-sm-6 col-lg-4 col-xxl-3">
                <div class="gallery-tile">
                    <img src="@(g.ThumbUrl ?? g.LargeUrl)" alt="@g.Title" loading="lazy" />
                    <div class="p-2">
                        <div class="fw-bold text-truncate" title="@g.Title">@g.Title</div>
                        <div class="small text-muted mb-2"><i class="bi bi-folder2"></i> @g.Album</div>
                        <div class="row-actions text-start">
                            <button type="button" class="icon-btn is-edit" title="کپی آدرس تصویر بزرگ" aria-label="کپی آدرس تصویر بزرگ" data-copy="@largeFull"><i class="bi bi-link-45deg"></i></button>
                            <button type="button" class="icon-btn" title="کپی آدرس تصویر کوچک" aria-label="کپی آدرس تصویر کوچک" data-copy="@fullUrl(g.ThumbUrl)"><i class="bi bi-image"></i></button>
                            @Html.IconLink(largeFull, "bi-box-arrow-up-left", "باز کردن", "is-view", true)
                            @Html.DeleteButton("DeleteGalleryItem", g.Id, "این تصویر حذف شود؟")
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (Model.Count == 0)
    {
        <div class="text-center text-muted py-5"><i class="bi bi-images fs-2 d-block mb-2"></i>تصویری پیدا نشد.</div>
    }
    @Html.Pager(Model)
</div>

@section scripts {
<script>
document.addEventListener('click', function (e) {
  var btn = e.target.closest('[data-copy]');
  if (!btn) return;
  var text = btn.getAttribute('data-copy');
  var done = function () {
    var icon = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check2"></i>';
    btn.classList.add('is-ok');
    setTimeout(function () { btn.innerHTML = icon; btn.classList.remove('is-ok'); }, 1200);
  };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(done);
  } else {
    var input = document.createElement('textarea');
    input.value = text;
    document.body.appendChild(input);
    input.select();
    document.execCommand('copy');
    input.remove();
    done();
  }
});
</script>
}
