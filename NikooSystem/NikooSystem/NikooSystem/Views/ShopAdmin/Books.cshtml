@model BooksPage
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = Model.Account == null ? "دفاتر حسابداری" : "دفتر معین " + Model.Account.Title;
    var company = (string)ViewBag.CompanyCode;
}
@if (Model.Account == null)
{
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">تراز آزمایشی</h2>
    </div>
    <div class="panel-card mb-3">
        @Html.GridToolbar("جستجو در کد یا عنوان سرفصل…")
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        @Html.SortHeader("code", "سرفصل")
                        @Html.SortHeader("debit", "بدهکار")
                        @Html.SortHeader("credit", "بستانکار")
                        @Html.SortHeader("balance", "مانده")
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Totals)
                    {
                        var balance = row.Debit - row.Credit;
                        var side = balance == 0 ? "—" : (balance > 0 ? "بد" : "بس");
                        <tr>
                            <td>@row.Account.Code — @row.Account.Title</td>
                            <td>@row.Debit.ToToman()</td>
                            <td>@row.Credit.ToToman()</td>
                            <td>@(Math.Abs(balance).ToToman()) @side</td>
                            <td>@Html.IconLink(Url.Action("Books", "ShopAdmin", new { company, accountId = row.Account.Id }), "bi-journal-text", "دفتر معین", null)</td>
                        </tr>
                    }
                    @if (Model.Totals.Count == 0)
                    {
                        <tr class="admin-empty-row"><td colspan="5"><i class="bi bi-journal-text fs-3 d-block mb-1"></i>گردشی پیدا نشد.</td></tr>
                    }
                    else
                    {
                        <tr>
                            <td class="fw-bold">جمع کل دفاتر</td>
                            <td class="fw-bold">@Model.Debit.ToToman()</td>
                            <td class="fw-bold">@Model.Credit.ToToman()</td>
                            <td colspan="2"></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @Html.Pager(Model.Totals)
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">دفتر معین @Model.Account.Code — @Model.Account.Title</h2>
        <a class="btn-outline-store" href="@Url.Action("Books","ShopAdmin", new { company })">بازگشت به تراز آزمایشی</a>
    </div>
    <div class="panel-card">
        @Html.GridToolbar("جستجو در شماره سند، شرح یا یادداشت…")
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        @Html.SortHeader("date", "تاریخ")
                        @Html.SortHeader("number", "سند")
                        <th>شرح</th>
                        @Html.SortHeader("debit", "بدهکار")
                        @Html.SortHeader("credit", "بستانکار")
                        <th>مانده</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Movements)
                    {
                        <tr>
                            <td>@line.Date.ToShamsi()</td>
                            <td dir="ltr">@line.Number</td>
                            <td>
                                @line.Description
                                @if (!string.IsNullOrWhiteSpace(line.Memo))
                                {
                                    <span class="text-muted">— @line.Memo</span>
                                }
                            </td>
                            <td>@(line.Debit > 0 ? line.Debit.ToToman() : "")</td>
                            <td>@(line.Credit > 0 ? line.Credit.ToToman() : "")</td>
                            <td>@line.Balance.ToToman()</td>
                        </tr>
                    }
                    @if (Model.Movements.Count == 0)
                    {
                        <tr class="admin-empty-row"><td colspan="6">گردشی برای این سرفصل پیدا نشد.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @Html.Pager(Model.Movements)
    </div>
}
