@model StoreCategory
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = Model.Id > 0 ? "ویرایش گروه" : "گروه جدید";
    var company = (string)ViewBag.CompanyCode;
    var cats = (IEnumerable<StoreCategory>)ViewBag.Categories;
}
<h2 class="mb-3">@ViewBag.Title</h2>
@using (Html.BeginForm("SaveCategory", "ShopAdmin", new { company }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="panel-card row g-3">
        <div class="col-md-6"><label class="form-label">عنوان</label>@Html.TextBoxFor(m => m.Title, new { @class = "form-control" })</div>
        <div class="col-md-6"><label class="form-label">اسلاگ</label>@Html.TextBoxFor(m => m.Slug, new { @class = "form-control" })</div>
        <div class="col-md-6">
            <label class="form-label" for="ParentId">گروه والد</label>
            <div class="qm-field">
                <select class="form-select" name="ParentId" id="ParentId" data-qm="categories" data-qm-roots data-qm-except="@Model.Id">
                    <option value="">بدون والد</option>
                    @foreach (var c in cats.Where(x => x.Id != Model.Id && x.ParentId == null))
                    {
                        <option value="@c.Id" @(Model.ParentId == c.Id ? "selected" : "")>@c.Title</option>
                    }
                </select>
                @Html.QuickManage("categories", "گروه‌ها")
            </div>
        </div>
        <div class="col-md-3"><label class="form-label">ترتیب</label>@Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number" })</div>
        <div class="col-md-3 form-check mt-4 pt-3">@Html.BoolField("IsActive", Model.IsActive, "فعال")</div>
        <div class="col-12"><label class="form-label">توضیحات</label>@Html.TextAreaFor(m => m.Description, 3, 1, new { @class = "form-control" })</div>
        <div class="col-12">
            <h5><i class="bi bi-google"></i> نمایش در گوگل</h5>
            @{
                var kind = (SiteKindInfo)ViewBag.Kind;
                var storeName = ((StoreSettings)ViewBag.Settings).StoreName;
                var listAction = kind.IsContent ? "Blog" : "Catalog";
            }
            @Html.Partial("_SeoFields", new SeoFieldsVm
            {
                Title = Model.SeoTitle,
                Description = Model.SeoDescription,
                AutoTitle = SeoPages.ItemTitle(null, string.IsNullOrWhiteSpace(Model.Title) ? "نام گروه" : Model.Title, storeName),
                AutoDescription = SeoPages.CategoryDescription(Model.Id > 0 ? Model : new StoreCategory { Title = "…" }, kind, storeName),
                Url = Model.Id > 0 && !kind.IsBooking ? Html.Seo().Url(Url.Action(listAction, "Shop", new { company }) + "?categoryId=" + Model.Id) : null
            })
        </div>
        <div class="col-12">@Html.FormActions("Categories")</div>
    </div>
}
