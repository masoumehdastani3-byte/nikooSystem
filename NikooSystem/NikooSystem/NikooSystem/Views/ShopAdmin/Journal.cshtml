@model PagedList<StoreJournalEntry>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "اسناد حسابداری";
    var company = (string)ViewBag.CompanyCode;
    var typeList = (List<StoreDocumentType>)ViewBag.Types;
    var types = typeList.ToDictionary(t => t.Id, t => t.Title);
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">اسناد</h2>
    <a class="btn-store" href="@Url.Action("EditJournal","ShopAdmin", new { company })"><i class="bi bi-plus-lg"></i> سند دستی</a>
</div>
<div class="panel-card">
    @Html.GridToolbar("جستجو در شماره یا شرح سند…", new GridSelect("type", "همه نوع‌های سند", GridHtml.Options(typeList, t => t.Id, t => t.Title)))
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    @Html.SortHeader("number", "شماره")
                    @Html.SortHeader("date", "تاریخ")
                    <th>شرح</th>
                    @Html.SortHeader("source", "نوع سند")
                    <th>مبلغ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var amount = (item.Lines ?? new List<StoreJournalLine>()).Sum(l => l.Debit);
                    <tr>
                        <td dir="ltr">@item.Number</td>
                        <td>@item.EntryDate.ToShamsi()</td>
                        <td>@item.Description @(item.Reversed ? "(برگشت‌خورده)" : "")</td>
                        <td>@(item.DocumentTypeId > 0 && types.ContainsKey(item.DocumentTypeId) ? types[item.DocumentTypeId] : AccountingText.Source(item.Source))</td>
                        <td>@amount.ToToman()</td>
                        <td class="row-actions">
                            @if (item.Source == JournalSource.Manual)
                            {
                                @Html.IconLink(Url.Action("EditJournal", "ShopAdmin", new { company, id = item.Id }), "bi-pencil", "ویرایش", "is-edit")
                                @Html.IconPost("DeleteJournal", new { id = item.Id }, "bi-trash", "حذف", "is-delete", "این سند حذف شود؟")
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="6"><i class="bi bi-journal-text fs-3 d-block mb-1"></i>سندی پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
