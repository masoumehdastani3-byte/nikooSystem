@model PagedList<StoreCustomer>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "مشتریان";
    var company = (string)ViewBag.CompanyCode;
    var orderCounts = (Dictionary<int, int>)ViewBag.OrderCounts;
    var kind = (SiteKindInfo)ViewBag.Kind;
    var cols = kind != null && kind.IsDigital ? 6 : 5;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@(kind != null && kind.IsDigital ? "دانشجویان و خریداران" : "مشتریان")</h2>
    @if (kind != null && kind.IsDigital)
    {
        <a class="btn-store" href="@Url.Action("GrantAccess","ShopAdmin", new { company })"><i class="bi bi-key"></i> اعطای دسترسی</a>
    }
</div>
<div class="panel-card">
    @Html.GridToolbar("جستجو در نام، موبایل یا ایمیل…", true)
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    @Html.SortHeader("name", "نام")
                    @Html.SortHeader("mobile", "موبایل")
                    <th>ایمیل</th>
                    <th>سفارش‌ها</th>
                    @Html.SortHeader("created", "تاریخ عضویت")
                    @if (kind != null && kind.IsDigital)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var count = orderCounts.ContainsKey(c.Id) ? orderCounts[c.Id] : 0;
                    <tr>
                        <td>@c.FullName</td>
                        <td dir="ltr" class="text-end">@c.Mobile</td>
                        <td dir="ltr" class="text-end small">@c.Email</td>
                        <td>
                            @if (count > 0)
                            {
                                <a href="@Url.Action("Orders", "ShopAdmin", new { company, q = c.Mobile })">@count سفارش</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="small text-muted">@c.CreatedAt.ToShamsi()</td>
                        @if (kind != null && kind.IsDigital)
                        {
                            <td class="row-actions">
                                @Html.IconLink(Url.Action("GrantAccess", "ShopAdmin", new { company, name = c.FullName, mobile = c.Mobile }), "bi-key", "اعطای دسترسی", "is-view")
                            </td>
                        }
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="@cols"><i class="bi bi-people fs-3 d-block mb-1"></i>مشتری‌ای پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
