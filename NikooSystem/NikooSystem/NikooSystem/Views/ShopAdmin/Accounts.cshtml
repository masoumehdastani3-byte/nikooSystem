@model PagedList<StoreLedgerAccount>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "سرفصل‌های حسابداری";
    var company = (string)ViewBag.CompanyCode;
    var kinds = Enum.GetValues(typeof(AccountKind)).Cast<AccountKind>();
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">سرفصل‌ها</h2>
    <a class="btn-store" href="@Url.Action("EditAccount","ShopAdmin", new { company })"><i class="bi bi-plus-lg"></i> سرفصل جدید</a>
</div>
<div class="panel-card">
    @Html.GridToolbar("جستجو در کد یا عنوان سرفصل…", new GridSelect("kind", "همه نوع‌ها", GridHtml.Options(kinds, k => k, k => AccountingText.Kind(k))))
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    @Html.SortHeader("code", "کد")
                    @Html.SortHeader("title", "عنوان")
                    @Html.SortHeader("kind", "نوع")
                    <th>وضعیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td dir="ltr">@item.Code</td>
                        <td>
                            <div class="fw-bold">@item.Title</div>
                            @if (item.IsSystem)
                            {
                                <div class="small text-muted">سرفصل پیش‌فرض</div>
                            }
                        </td>
                        <td>@AccountingText.Kind(item.Kind)</td>
                        <td>@(item.IsActive ? "فعال" : "غیرفعال")</td>
                        <td class="row-actions">
                            @Html.IconLink(Url.Action("EditAccount", "ShopAdmin", new { company, id = item.Id }), "bi-pencil", "ویرایش", "is-edit")
                            @if (!item.IsSystem)
                            {
                                @Html.IconPost("DeleteAccount", new { id = item.Id }, "bi-trash", "حذف", "is-delete", "این سرفصل حذف شود؟")
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr class="admin-empty-row"><td colspan="5"><i class="bi bi-list-check fs-3 d-block mb-1"></i>سرفصلی پیدا نشد.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @Html.Pager(Model)
</div>
