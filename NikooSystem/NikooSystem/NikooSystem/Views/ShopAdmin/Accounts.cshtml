@model List<StoreLedgerAccount>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "سرفصل‌های حسابداری";
    var company = (string)ViewBag.CompanyCode;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">سرفصل‌ها</h2>
    <a class="btn-store" href="@Url.Action("EditAccount","ShopAdmin", new { company })"><i class="bi bi-plus-lg"></i> سرفصل جدید</a>
</div>
<div class="panel-card">
    <table class="table align-middle">
        <thead><tr><th>کد</th><th>عنوان</th><th>نوع</th><th>وضعیت</th><th></th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td dir="ltr">@item.Code</td>
                    <td>
                        <div class="fw-bold">@item.Title</div>
                        @if (item.IsSystem) { <div class="small text-muted">سرفصل پیش‌فرض</div> }
                    </td>
                    <td>@AccountingText.Kind(item.Kind)</td>
                    <td>@(item.IsActive ? "فعال" : "غیرفعال")</td>
                    <td class="row-actions">
                        @Html.IconLink(Url.Action("EditAccount", "ShopAdmin", new { company, id = item.Id }), "bi-pencil", "ویرایش", "is-edit")
                        @if (!item.IsSystem)
                        {
                            @Html.IconPost("DeleteAccount", new { id = item.Id }, "bi-trash", "حذف", "is-delete", "این سرفصل حذف شود؟")
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
