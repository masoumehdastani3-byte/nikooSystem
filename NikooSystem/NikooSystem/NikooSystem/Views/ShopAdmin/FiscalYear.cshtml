@model StoreSettings
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "سال مالی";
    var company = (string)ViewBag.CompanyCode;
    var current = (FiscalPeriod)ViewBag.CurrentPeriod;
    var closeable = (FiscalPeriod)ViewBag.CloseablePeriod;
    var closeableYear = (int)ViewBag.CloseableYear;
    var closeableClosed = ViewBag.CloseableClosed == true;
    var closed = (List<FiscalPeriod>)ViewBag.ClosedPeriods ?? new List<FiscalPeriod>();
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="admin-page-head">
    <div class="admin-page-head-title">
        <span class="admin-page-head-accent" aria-hidden="true"></span>
        <div>
            <h2>سال مالی</h2>
            <p class="text-muted small mb-0 mt-1">بازه اسناد و تراز به‌صورت پیش‌فرض روی سال مالی جاری است؛ با بستن سال، درآمد و هزینه به «سود و زیان انباشته» منتقل می‌شود.</p>
        </div>
    </div>
</div>

<div class="panel-card mb-3">
    <h5 class="mb-2"><i class="bi bi-calendar3-range"></i> سال جاری</h5>
    <p class="mb-1"><strong>@current.Label</strong> — @current.RangeText</p>
    <p class="small text-muted mb-0">
        ماه شروع: @FiscalPeriod.MonthNames[FiscalPeriod.NormalizeMonth(Model.FiscalStartMonth) - 1]
        @(Model.FiscalLockDates ? "· ثبت سند بیرون از سال‌های باز ممنوع است" : "· قفل تاریخ خاموش است")
    </p>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <a class="btn-store" href="@Url.Action("Books","ShopAdmin", new { company, from = current.Start.ToString("yyyy-MM-dd", invariant), to = current.End.ToString("yyyy-MM-dd", invariant) })">
            <i class="bi bi-file-earmark-text"></i> تراز این سال
        </a>
        <a class="btn-outline-store" href="@Url.Action("Journal","ShopAdmin", new { company, from = current.Start.ToString("yyyy-MM-dd", invariant), to = current.End.ToString("yyyy-MM-dd", invariant) })">
            <i class="bi bi-journal-text"></i> اسناد این سال
        </a>
    </div>
</div>

<div class="panel-card mb-3">
    <h5 class="mb-3"><i class="bi bi-sliders"></i> تنظیم شروع سال، قفل تاریخ و مالیات</h5>
    @using (Html.BeginForm("FiscalYear", "ShopAdmin", new { company }, FormMethod.Post, new { @class = "row g-3" }))
    {
        @Html.AntiForgeryToken()
        <div class="col-md-4">
            <label class="form-label" for="fiscalStartMonth">ماه شروع سال مالی</label>
            <select class="form-select" name="fiscalStartMonth" id="fiscalStartMonth">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m" @(Model.FiscalStartMonth == m ? "selected" : null)>@FiscalPeriod.MonthNames[m - 1]</option>
                }
            </select>
            <div class="form-text">بیشتر کسب‌وکارها از فروردین شروع می‌کنند.</div>
        </div>
        <div class="col-md-8 d-flex align-items-end">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="fiscalLockDates" value="true" id="fiscalLockDates" @(Model.FiscalLockDates ? "checked" : null) />
                <label class="form-check-label" for="fiscalLockDates">قفل تاریخ: سند و فاکتور فقط در سال‌های باز ثبت شود</label>
            </div>
        </div>
        <div class="col-12"><hr class="my-1" /></div>
        <div class="col-md-6">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="enableVat" value="true" id="enableVat" @(Model.EnableVat ? "checked" : null) />
                <label class="form-check-label" for="enableVat">مالیات بر ارزش افزوده روی فاکتور فروش و خرید پیش‌فرض باشد</label>
            </div>
            <div class="form-text">سرفصل «مالیات و عوارض ارزش افزوده» در سند خودکار بستانکار (فروش) یا بدهکار (خرید) می‌شود.</div>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="vatPercent">نرخ پیش‌فرض مالیات (٪)</label>
            <input class="form-control" type="number" min="0" max="100" step="1" dir="ltr" name="vatPercent" id="vatPercent" value="@Model.VatPercent.ToString(invariant)" />
        </div>
        <div class="col-12">
            <button class="btn-store" type="submit"><i class="bi bi-check2"></i> ذخیره تنظیمات</button>
        </div>
    }
</div>

<div class="panel-card mb-3">
    <h5 class="mb-3"><i class="bi bi-lock"></i> بستن سال مالی</h5>
    <ol class="mb-3">
        <li class="mb-2">اسناد و فاکتورهای سال قبل را در تراز و دفاتر مرور کنید.</li>
        <li class="mb-2">با «بستن سال»، مانده حساب‌های درآمد و هزینه صفر و به «سود و زیان انباشته» منتقل می‌شود.</li>
        <li class="mb-0">بعد از بستن، ثبت سند با تاریخ آن سال (اگر قفل روشن باشد) مجاز نیست؛ در صورت نیاز می‌توانید دوباره باز کنید.</li>
    </ol>
    @if (!closeableClosed)
    {
        using (Html.BeginForm("CloseFiscalYear", "ShopAdmin", new { company }, FormMethod.Post, new { @class = "d-flex flex-wrap align-items-center gap-2" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="startYear" value="@closeableYear" />
            <span class="small">@closeable.Label — @closeable.RangeText</span>
            <button class="btn-store" type="submit" onclick="return confirm('سال مالی @(closeableYear.ToString(invariant).ToFaDigits()) بسته شود؟ سند بستن ثبت می‌گردد.');">
                <i class="bi bi-lock"></i> بستن @closeable.Label
            </button>
        }
    }
    else
    {
        <p class="small text-muted mb-0">سال قبل (@closeable.Label) قبلاً بسته شده است.</p>
    }
</div>

@if (closed.Any())
{
    <div class="panel-card mb-3">
        <h5 class="mb-3"><i class="bi bi-archive"></i> سال‌های بسته‌شده</h5>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>سال</th><th>بازه</th><th></th></tr></thead>
                <tbody>
                    @foreach (var period in closed)
                    {
                        <tr>
                            <td>@period.Label</td>
                            <td>@period.RangeText</td>
                            <td class="row-actions">
                                @using (Html.BeginForm("ReopenFiscalYear", "ShopAdmin", new { company }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="startYear" value="@period.StartYear" />
                                    <button class="icon-btn" type="submit" title="باز کردن دوباره" aria-label="باز کردن دوباره"
                                            onclick="return confirm('سال @(period.StartYear.ToString(invariant).ToFaDigits()) دوباره باز شود و سند بستن حذف گردد؟');">
                                        <i class="bi bi-unlock"></i>
                                    </button>
                                }
                                <a class="icon-btn" href="@Url.Action("Books","ShopAdmin", new { company, from = period.Start.ToString("yyyy-MM-dd", invariant), to = period.End.ToString("yyyy-MM-dd", invariant) })" title="تراز" aria-label="تراز">
                                    <i class="bi bi-file-earmark-text"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="panel-card">
    <h5 class="mb-2">راهنمای کوتاه</h5>
    <ul class="mb-0">
        <li class="mb-1">فهرست اسناد، فاکتورها، دریافت و پرداخت و تراز به‌طور پیش‌فرض روی سال جاری فیلتر می‌شوند؛ با «حذف فیلتر / همه تاریخ‌ها» همه را می‌بینید.</li>
        <li class="mb-0">جزئیات بیشتر در <a href="@Url.Action("AccountingGuide","ShopAdmin", new { company })">راهنمای حسابداری</a>.</li>
    </ul>
</div>
