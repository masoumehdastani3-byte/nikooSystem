@model StoreService
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = Model.Id > 0 ? "ویرایش خدمت" : "خدمت جدید";
    var company = (string)ViewBag.CompanyCode;
    var staff = (List<StoreStaff>)ViewBag.Staff;
    var selected = Model.StaffIds ?? new List<int>();
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@ViewBag.Title</h2>
    <a class="btn-outline-store" href="@Url.Action("Services","ShopAdmin", new { company })">بازگشت به لیست</a>
</div>

@using (Html.BeginForm("EditService", "ShopAdmin", new { company }, FormMethod.Post, new { enctype = "multipart/form-data", @class = "svc-edit" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="panel-card">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="Title">عنوان خدمت</label>
            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", maxlength = "150", required = "required", placeholder = "مثلاً ویزیت عمومی" })
        </div>
        <div class="col-md-3">
            <label class="form-label" for="DurationMinutes">مدت (دقیقه)</label>
            @Html.TextBoxFor(m => m.DurationMinutes, new { @class = "form-control", type = "number", min = "5", max = "480", step = "5", dir = "ltr" })
        </div>
        <div class="col-md-3">
            <label class="form-label" for="Price">هزینه (تومان)</label>
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control", inputmode = "numeric", data_money = "true", dir = "ltr" })
            <div class="form-text">۰ یعنی رایگان.</div>
        </div>
        @{
            var kind = (SiteKindInfo)ViewBag.Kind;
            var mode = CampusDelivery.Normalize(Model.Mode);
        }
        @if (kind != null && kind.IsCampus)
        {
            <div class="col-md-6">
                <label class="form-label" for="Mode">نحوه برگزاری</label>
                <select class="form-select" id="Mode" name="Mode">
                    <option value="@CampusDelivery.InPerson" @(mode == CampusDelivery.InPerson ? "selected" : null)>حضوری</option>
                    <option value="@CampusDelivery.Online" @(mode == CampusDelivery.Online ? "selected" : null)>آنلاین</option>
                    <option value="@CampusDelivery.Hybrid" @(mode == CampusDelivery.Hybrid ? "selected" : null)>حضوری یا آنلاین</option>
                </select>
                <div class="form-text">آنلاین یعنی جلسه تصویری است؛ لینک را در توضیح بنویسید تا مشتری ببیند.</div>
            </div>
        }
        <div class="col-12">
            <label class="form-label" for="Description">توضیح کوتاه</label>
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3", maxlength = "1000" })
        </div>
        <div class="col-12">
            <label class="form-label d-block">چه کسانی این خدمت را ارائه می‌دهند؟</label>
            @if (staff.Any())
            {
                <div class="svc-checks">
                    @foreach (var p in staff)
                    {
                        <label class="svc-check">
                            <input type="checkbox" name="StaffIds" value="@p.Id" @(selected.Contains(p.Id) ? "checked" : null) />
                            <span>@p.Name @if (!p.IsActive) { <small>(غیرفعال)</small> }</span>
                        </label>
                    }
                </div>
                <div class="form-text">هیچ‌کدام را نزنید تا همه متخصصان این خدمت را ارائه دهند.</div>
            }
            else
            {
                <div class="small text-muted">هنوز متخصصی ندارید؛ <a href="@Url.Action("EditStaff","ShopAdmin", new { company })">اولین متخصص را اضافه کنید</a>.</div>
            }
        </div>
        <div class="col-md-6">
            <label class="form-label">تصویر (اختیاری)</label>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="d-flex align-items-center gap-3 mb-2">
                    <img src="@Model.ImageUrl" alt="" style="width:120px;height:68px;object-fit:cover;border-radius:8px" />
                    <label class="svc-check">
                        <input type="checkbox" name="removeImage" value="true" />
                        <span>حذف تصویر</span>
                    </label>
                </div>
            }
            <input class="form-control" type="file" name="imageFile" accept=".png,.jpg,.jpeg,.gif" />
        </div>
        <div class="col-md-6">
            <div class="svc-meta">
                <div>
                    <label class="form-label" for="SortOrder">ترتیب نمایش</label>
                    @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number", dir = "ltr" })
                </div>
                <label class="svc-check">
                    <input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : null) />
                    <span>فعال (قابل رزرو آنلاین)</span>
                </label>
                <input type="hidden" name="IsActive" value="false" />
            </div>
        </div>
        <div class="col-12 d-flex gap-2">
            @Html.FormActions("Services")
        </div>
    </div>
    </div>
}
