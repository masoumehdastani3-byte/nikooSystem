@model IEnumerable<NikooSystem.Models.Store.StoreCollection>
@{
    Layout = "~/Views/Shared/_ShopAdminLayout.cshtml";
    ViewBag.Title = "برچسب‌های ویژه";
    var company = (string)ViewBag.CompanyCode;
    var counts = (Dictionary<int, int>)ViewBag.ProductCounts;
    var onHome = (HashSet<int>)ViewBag.OnHome;
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">برچسب‌های ویژه</h2>
        <p class="text-muted mb-0">کالاها را با برچسبی مثل «ویژه روز دختر» یا «حراج یلدا» گروه‌بندی کنید و در صفحه اول یک ردیف جدا برایشان نمایش دهید.</p>
    </div>
    <a class="btn-store" href="@Url.Action("EditCollection","ShopAdmin", new { company })"><i class="bi bi-plus-lg"></i> برچسب جدید</a>
</div>

@if (!Model.Any())
{
    <div class="panel-card admin-empty">
        <i class="bi bi-tags"></i>
        <h4>هنوز برچسبی نساخته‌اید</h4>
        <p>مثلاً برچسب «روز دختر» بسازید، کالاهای مناسب را تیک بزنید و در صفحه اول فروشگاه نمایش دهید.</p>
        <a class="btn-store" href="@Url.Action("EditCollection","ShopAdmin", new { company })">ساخت اولین برچسب</a>
    </div>
}
else
{
    <div class="panel-card">
        <table class="table align-middle">
            <thead><tr><th>برچسب</th><th>تعداد کالا</th><th>صفحه اول</th><th>وضعیت</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>
                        <strong><i class="bi bi-tag text-muted"></i> @c.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(c.Description)) { <div class="small text-muted">@c.Description</div> }
                    </td>
                    <td>@(counts.ContainsKey(c.Id) ? counts[c.Id] : 0)</td>
                    <td>
                        @if (onHome.Contains(c.Id))
                        {
                            <span class="adm-pill is-on">نمایش داده می‌شود</span>
                        }
                        else
                        {
                            <span class="adm-pill">نمایش داده نمی‌شود</span>
                        }
                    </td>
                    <td>@(c.IsActive ? "فعال" : "غیرفعال")</td>
                    <td class="text-nowrap">
                        <a href="@Url.Action("EditCollection","ShopAdmin", new { company, id = c.Id })">ویرایش</a>
                        <span class="text-muted mx-1">|</span>
                        <a href="@Url.Action("Catalog","Shop", new { company, collectionId = c.Id })" target="_blank">مشاهده در سایت</a>
                        <span class="text-muted mx-1">|</span>
                        @using (Html.BeginForm("DeleteCollection", "ShopAdmin", new { company }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('این برچسب حذف شود؟ کالاها حذف نمی‌شوند.');" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button class="btn btn-link text-danger p-0" type="submit">حذف</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<p class="small text-muted mt-3">
    <i class="bi bi-lightbulb"></i> جای ردیف هر برچسب در صفحه اول را از
    <a href="@Url.Action("PageLayout","ShopAdmin", new { company })">چیدمان صفحات</a> تغییر دهید.
</p>
