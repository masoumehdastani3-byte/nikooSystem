@model IReadOnlyList<NikooSystem.Helpers.SiteTool>
@{
    ViewBag.Title = "ابزارهای رایگان";
    ViewBag.Nav = "tools";
}
<link href="@Url.Asset("~/Content/tools.css")" rel="stylesheet" />
<main id="main">
    <div class="page-hero">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">خانه</a></li>
                    <li class="breadcrumb-item active">ابزارهای رایگان</li>
                </ol>
            </nav>
            <h1>ابزارهای رایگان آنلاین</h1>
            <p class="text-muted mb-0">مبدل تاریخ و ارز، محاسبه سن، QR کد و فشرده‌سازی تصویر — بدون ثبت‌نام و در مرورگر شما</p>
        </div>
    </div>
    <section class="pb-5">
        <div class="container">
            <div class="row g-4">
                @foreach (var tool in Model)
                {
                    <div class="col-md-6 col-lg-3">
                        <a class="nk-tool-card" href="@Url.RouteUrl("Tool", new { slug = tool.Slug })">
                            <i class="bi @tool.Icon"></i>
                            <h3>@tool.Name</h3>
                            <p>@tool.Summary</p>
                        </a>
                    </div>
                }
            </div>
            @Html.Partial("_ToolCta")
        </div>
    </section>
</main>
