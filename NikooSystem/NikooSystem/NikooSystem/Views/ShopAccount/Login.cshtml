@model StoreLoginVm
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = "ورود مشتری";
    var company = (string)ViewBag.CompanyCode;
}
<section class="py-5">
    <div class="container" style="max-width:480px;">
        <div class="panel-card">
            <h2 class="section-title">ورود مشتری</h2>
            <p class="small text-muted">این صفحه مخصوص <strong>مشتریان همین فروشگاه</strong> است. اگر فقط سفارش آنلاین داده‌اید و رمز ندارید، موبایل را پایین وارد کنید و «ارسال رمز موقت» را بزنید.</p>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="mb-3"><label class="form-label">موبایل</label>@Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "09121234567" })</div>
                <div class="mb-3"><label class="form-label">رمز عبور</label>@Html.PasswordFor(m => m.Password, new { @class = "form-control" })</div>
                <button class="btn-store w-100" type="submit">ورود</button>
            }
            @using (Html.BeginForm("ForgotPassword", "ShopAccount", new { company, returnUrl = (string)ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "mt-3" }))
            {
                @Html.AntiForgeryToken()
                <div class="small text-muted mb-2">رمز را فراموش کرده‌اید؟ موبایل را وارد کنید تا رمز موقت پیامک شود.</div>
                <div class="input-group">
                    <input type="text" name="mobile" class="form-control" placeholder="09121234567" />
                    <button class="btn btn-outline-secondary" type="submit">ارسال رمز موقت</button>
                </div>
            }
            <p class="mt-3 mb-0 small text-muted">صاحب فروشگاه هستید؟ <a href="@Url.Action("Login","ShopAdmin", new { company })">ورود مدیر فروشگاه</a></p>
            <p class="mt-3 mb-0">حساب ندارید؟ <a href="@Url.Action("Register","ShopAccount", new { company, returnUrl = (string)ViewBag.ReturnUrl })">ثبت‌نام کنید</a></p>
        </div>
    </div>
</section>
