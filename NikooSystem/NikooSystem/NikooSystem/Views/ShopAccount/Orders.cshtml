@model PagedList<StoreOrder>
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = "سفارش‌های من";
    var company = (string)ViewBag.CompanyCode;
    var customer = ViewBag.Customer as StoreCustomer;
    var kind = (SiteKindInfo)ViewBag.Kind;
}
<section class="py-4">
    <div class="container" style="max-width:860px;">
        @Html.Partial("_AccountNav", "Orders")
        <h1 class="section-title">سفارش‌های @(customer?.FullName)</h1>
        @foreach (var o in Model)
        {
            <div class="panel-card mb-2 account-order">
                <div class="d-flex justify-content-between align-items-center">
                    <strong dir="ltr">@o.OrderNumber</strong>
                    @Html.StatusBadge(o.Status)
                </div>
                <div class="text-muted small">@o.CreatedAt.ToShamsiText() · @o.CreatedAt.ToString("HH:mm").ToFaDigits()</div>
                <ul class="mb-0 mt-2">
                    @foreach (var i in o.Items)
                    {
                        <li>@i.Title @(i.Quantity > 1 ? "× " + i.Quantity.ToFa() : "") @if (i.IsDigital) { <i class="bi bi-cloud-arrow-down text-muted" title="دیجیتال"></i> }</li>
                    }
                </ul>
                <div class="d-flex flex-wrap gap-3 mt-2 small">
                    <span>مبلغ: <strong>@o.Amount.ToToman()</strong></span>
                    @if (o.ShippingCost > 0) { <span>هزینه ارسال: @o.ShippingCost.ToToman()</span> }
                    @if (!string.IsNullOrWhiteSpace(o.TrackingCode)) { <span><i class="bi bi-truck"></i> کد رهگیری مرسوله: <strong dir="ltr">@o.TrackingCode</strong></span> }
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="panel-card">هنوز سفارشی ندارید. <a href="@Url.Action("Catalog","Shop", new { company })">مشاهده @kind.ItemsLabel</a></div>
        }
        @Html.Pager(Model, sizes: false)
    </div>
</section>
