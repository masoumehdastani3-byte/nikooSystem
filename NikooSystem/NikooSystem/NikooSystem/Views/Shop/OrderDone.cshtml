@model StoreOrder
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    var ok = ViewBag.Ok as bool? == true;
    ViewBag.Title = ok ? "پرداخت موفق" : "پرداخت ناموفق";
    var company = (string)ViewBag.CompanyCode;
}
<section class="py-5">
    <div class="container text-center" style="max-width:640px;">
        <div class="panel-card">
            @if (ok)
            {
                <div class="display-4 text-success mb-3"><i class="bi bi-check-circle"></i></div>
                <h1>سفارش ثبت شد</h1>
            }
            else
            {
                <div class="display-4 text-danger mb-3"><i class="bi bi-x-circle"></i></div>
                <h1>پرداخت انجام نشد</h1>
            }
            @if (Model != null)
            {
                <p class="text-muted">شماره سفارش: <strong>@Model.OrderNumber</strong></p>
                <p>مبلغ: @Model.Amount.ToToman()</p>
                if (Model.RefId.HasValue) { <p>کد پیگیری: @Model.RefId</p> }
                if (!string.IsNullOrEmpty(Model.PaymentMessage)) { <p class="small">@Model.PaymentMessage</p> }
            }
            @if (ok && Model != null && Model.Items.Any(i => i.IsDigital))
            {
                <p class="mt-3"><i class="bi bi-collection-play"></i> کتاب‌ها، دوره‌ها و فایل‌های این سفارش در «کتابخانه من» آماده‌اند.</p>
                <a class="btn-store mt-2" href="@Url.Action("Library","ShopAccount", new { company })"><i class="bi bi-collection-play"></i> کتابخانه من</a>
            }
            else
            {
                <a class="btn-store mt-3" href="@Url.Action("Index","Shop", new { company })">بازگشت به فروشگاه</a>
            }
            <a class="btn-outline-store mt-3" href="@Url.Action("Orders","ShopAccount", new { company })">سفارش‌های من</a>
            @if (ok && Model != null && !string.IsNullOrWhiteSpace(Model.TrackingCode))
            {
                <p class="mt-3 small">کد رهگیری مرسوله: <strong dir="ltr">@Model.TrackingCode</strong></p>
            }
        </div>
    </div>
</section>
