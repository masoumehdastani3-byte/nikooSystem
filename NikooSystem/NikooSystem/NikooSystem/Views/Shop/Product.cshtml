@model StoreProduct
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = Model.Title;
    var company = (string)ViewBag.CompanyCode;
    var settings = (StoreSettings)ViewBag.Settings;
    var category = ViewBag.Category as StoreCategory;
    var options = HomeSections.LayoutOf(settings);
    var tags = (ViewBag.Collections as List<StoreCollection>) ?? new List<StoreCollection>();
    var related = ((IEnumerable<StoreProduct>)ViewBag.Related ?? Enumerable.Empty<StoreProduct>()).ToList();
    var reviews = ((IEnumerable<StoreProductReview>)ViewBag.Reviews ?? Enumerable.Empty<StoreProductReview>()).OrderByDescending(r => r.CreatedAt).ToList();
    var avg = ViewBag.AvgRating as double? ?? 0;
    var images = (Model.Images ?? new List<StoreProductImage>()).OrderBy(i => i.SortOrder).ToList();
    var attributes = options.ShowSpecifications
        ? (Model.Attributes ?? new List<StoreProductAttribute>()).Where(a => !string.IsNullOrWhiteSpace(a.Name) && !string.IsNullOrWhiteSpace(a.Value)).ToList()
        : new List<StoreProductAttribute>();
    var onSale = Model.IsOnSale();
    var discount = Model.DiscountPercent();
    var kind = (SiteKindInfo)ViewBag.Kind;
    var digital = Model.IsDigital();
    var owned = ViewBag.Owned as bool? == true;
    var course = Model.ProductType == StoreProductType.Course;
    var lessons = Model.Lessons ?? new List<StoreLesson>();
    var files = Model.Files ?? new List<StoreProductFile>();
    var outOfStock = !digital && Model.Stock <= 0;
    var lowStock = !digital && !outOfStock && Model.Stock <= 5;
    var accessUrl = course
        ? Url.Action("Learn", "ShopAccount", new { company, id = Model.Id })
        : Url.Action("Library", "ShopAccount", new { company });
    const string placeholder = "/Assets/img/portfolio/portfolio-1.jpg";
}

<section class="pd-page">
    <div class="container">
        <nav class="cat-breadcrumb" aria-label="مسیر">
            <a href="@Url.Action("Index","Shop", new { company })">خانه</a>
            <i class="bi bi-chevron-left"></i>
            <a href="@Url.Action("Catalog","Shop", new { company })">@kind.ItemsLabel</a>
            @if (category != null)
            {
                <i class="bi bi-chevron-left"></i>
                <a href="@Url.Action("Catalog","Shop", new { company, categoryId = category.Id })">@category.Title</a>
            }
            <i class="bi bi-chevron-left"></i>
            <span>@Model.Title</span>
        </nav>

        <div class="pd-top">
            @* ========== GALLERY ========== *@
            <div class="pd-gallery">
                <div class="pg" id="productGallery">
                    <div class="pg-stage">
                        <div class="pg-track" tabindex="0" aria-label="تصاویر محصول">
                            @if (images.Any())
                            {
                                for (var i = 0; i < images.Count; i++)
                                {
                                    var im = images[i];
                                    <div class="pg-slide">
                                        <img class="pg-img @(im.LargeUrl != null && im.LargeUrl != im.ThumbUrl ? "is-low" : "")"
                                             src="@(im.ThumbUrl ?? im.LargeUrl)"
                                             data-large="@(im.LargeUrl ?? im.ThumbUrl)"
                                             alt="@(string.IsNullOrWhiteSpace(im.Alt) ? Model.Title : im.Alt) - تصویر @(i + 1)"
                                             draggable="false" />
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="pg-slide"><img class="pg-img" src="@placeholder" data-large="@placeholder" alt="@Model.Title" draggable="false" /></div>
                            }
                        </div>
                        @if (onSale && !outOfStock)
                        {
                            <span class="pg-badge">٪@discount تخفیف</span>
                        }
                        @if (images.Count > 1)
                        {
                            <button type="button" class="pg-nav pg-prev" aria-label="تصویر قبلی"><i class="bi bi-chevron-right"></i></button>
                            <button type="button" class="pg-nav pg-next" aria-label="تصویر بعدی"><i class="bi bi-chevron-left"></i></button>
                            <span class="pg-counter"><b>1</b> / @images.Count</span>
                        }
                        <button type="button" class="pg-expand" aria-label="نمایش تمام‌صفحه"><i class="bi bi-arrows-fullscreen"></i></button>
                    </div>
                    @if (images.Count > 1)
                    {
                        <div class="pg-thumbs">
                            @for (var i = 0; i < images.Count; i++)
                            {
                                <button type="button" class="pg-thumb @(i == 0 ? "active" : "")" data-index="@i" aria-label="تصویر @(i + 1)">
                                    <img src="@(images[i].ThumbUrl ?? images[i].LargeUrl)" alt="" loading="lazy" draggable="false" />
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            @* ========== INFO / BUY BOX ========== *@
            <div class="pd-info">
                @if (category != null)
                {
                    <a class="pd-cat" href="@Url.Action("Catalog","Shop", new { company, categoryId = category.Id })">@category.Title</a>
                }
                <h1 class="pd-title">@Model.Title</h1>
                @if (digital)
                {
                    <div class="pd-digital-head">
                        <span class="wm-type is-inline"><i class="bi @Model.ProductType.TypeIcon()"></i> @Model.ProductType.TypeText()</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Author))
                        {
                            <span><i class="bi bi-person-badge"></i> @(course ? "مدرس" : "نویسنده"): <strong>@Model.Author</strong></span>
                        }
                    </div>
                }
                <div class="pd-meta">
                    @if (options.ShowReviews && reviews.Any())
                    {
                        <a class="pd-rating" href="#pdTabs" data-open-tab="tab-reviews">
                            @for (var s = 1; s <= 5; s++)
                            {
                                <i class="bi @(avg >= s ? "bi-star-fill" : (avg >= s - 0.5 ? "bi-star-half" : "bi-star"))"></i>
                            }
                            <span>@avg.ToString("0.0") (@reviews.Count نظر)</span>
                        </a>
                    }
                    else if (options.ShowReviews)
                    {
                        <a class="pd-rating is-empty" href="#pdTabs" data-open-tab="tab-reviews"><i class="bi bi-star"></i> اولین نفری باشید که نظر می‌دهد</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Sku))
                    {
                        <span class="pd-sku">کد کالا: <span dir="ltr">@Model.Sku</span></span>
                    }
                </div>

                @if (tags.Any())
                {
                    <div class="pd-tags">
                        @foreach (var t in tags)
                        {
                            <a href="@Url.Action("Catalog","Shop", new { company, collectionId = t.Id })"><i class="bi bi-tag"></i> @t.Title</a>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p class="pd-lead">@Model.ShortDescription</p>
                }

                @if (digital)
                {
                    <ul class="pd-key-specs">
                        @if (course)
                        {
                            <li><span>تعداد جلسه‌ها</span><strong>@lessons.Count.ToFa() جلسه</strong></li>
                            if (lessons.Any(l => l.IsFree))
                            {
                                <li><span>جلسه رایگان</span><strong>@lessons.Count(l => l.IsFree).ToFa() جلسه</strong></li>
                            }
                        }
                        @if (files.Any() && !course)
                        {
                            <li><span>فایل‌ها</span><strong>@files.Count.ToFa() فایل · @files.Sum(f => f.Size).ToFileSize()</strong></li>
                        }
                        <li><span>دسترسی</span><strong>بلافاصله پس از پرداخت، برای همیشه</strong></li>
                    </ul>
                }
                @if (attributes.Any())
                {
                    <ul class="pd-key-specs">
                        @foreach (var a in attributes.Take(5))
                        {
                            <li><span>@a.Name</span><strong>@a.Value</strong></li>
                        }
                    </ul>
                }

                <div class="pd-buy">
                    <div class="pd-price-row">
                        @if (onSale)
                        {
                            <div class="pd-old">
                                <del>@Model.CompareAtPrice.Value.ToToman()</del>
                                <span class="pd-off">٪@discount</span>
                            </div>
                        }
                        <div class="pd-price">@(Model.Price == 0 ? "رایگان" : Model.Price.ToToman())</div>
                        @if (onSale)
                        {
                            <div class="pd-save">سود شما از این خرید: @((Model.CompareAtPrice.Value - Model.Price).ToToman())</div>
                        }
                    </div>

                    @if (digital)
                    {
                        if (owned)
                        {
                            <div class="pd-stock is-ok"><i class="bi bi-check-circle"></i> <span>این مورد را خریده‌اید و در کتابخانه شما است.</span></div>
                            <a class="btn-wm pd-add" href="@accessUrl"><i class="bi @(course ? "bi-play-circle" : "bi-download")"></i> @(course ? "ادامه یادگیری" : "دانلود از کتابخانه من")</a>
                        }
                        else
                        {
                            <div class="pd-stock is-ok"><i class="bi bi-lightning-charge"></i> <span>دسترسی فوری پس از پرداخت</span></div>
                            using (Html.BeginForm("AddToCart", "Shop", new { company }, FormMethod.Post, new { id = "pdBuyForm", @class = "pd-buy-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button class="btn-wm pd-add" type="submit"><i class="bi bi-cart-plus"></i> @(Model.Price == 0 ? "دریافت رایگان" : course ? "ثبت‌نام در دوره" : "خرید و دانلود")</button>
                            }
                        }
                        if (!string.IsNullOrWhiteSpace(Model.PreviewUrl))
                        {
                            <a class="pd-preview" href="@Model.PreviewUrl" target="_blank" rel="noopener"><i class="bi bi-play-circle"></i> @(course ? "تماشای ویدیوی معرفی" : "دیدن نمونه / پیش‌نمایش")</a>
                        }
                        else if (course && lessons.Any(l => l.IsFree) && !owned)
                        {
                            <a class="pd-preview" href="@accessUrl"><i class="bi bi-play-circle"></i> تماشای جلسه‌های رایگان</a>
                        }
                    }
                    else
                    {
                    <div class="pd-stock @(outOfStock ? "is-out" : (lowStock ? "is-low" : "is-ok"))">
                        @if (outOfStock)
                        {
                            <i class="bi bi-x-circle"></i> <span>ناموجود</span>
                        }
                        else if (lowStock)
                        {
                            <i class="bi bi-exclamation-circle"></i> <span>فقط @Model.Stock عدد در انبار باقی مانده</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i> <span>موجود در انبار</span>
                        }
                    </div>

                    if (!outOfStock)
                    {
                        using (Html.BeginForm("AddToCart", "Shop", new { company }, FormMethod.Post, new { id = "pdBuyForm", @class = "pd-buy-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <div class="pd-qty" data-max="@Model.Stock">
                                <button type="button" data-step="1" aria-label="افزایش تعداد"><i class="bi bi-plus"></i></button>
                                <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" aria-label="تعداد" />
                                <button type="button" data-step="-1" aria-label="کاهش تعداد"><i class="bi bi-dash"></i></button>
                            </div>
                            <button class="btn-wm pd-add" type="submit"><i class="bi bi-bag-plus"></i> افزودن به سبد خرید</button>
                        }
                    }
                    else
                    {
                        <button class="btn-wm pd-add" type="button" disabled>این کالا فعلاً موجود نیست</button>
                    }
                    }

                    @if (options.ShowBuyPerks)
                    {
                        <ul class="pd-perks">
                            @if (settings.EnablePayment)
                            {
                                <li><i class="bi bi-shield-check"></i> پرداخت امن اینترنتی</li>
                            }
                            @if (digital)
                            {
                                <li><i class="bi bi-collection-play"></i> دسترسی دائمی از «کتابخانه من»</li>
                            }
                            else
                            {
                                <li><i class="bi bi-receipt"></i> ثبت سفارش و پیگیری آنلاین</li>
                            }
                            @if (!string.IsNullOrWhiteSpace(settings.Phone))
                            {
                                <li><i class="bi bi-headset"></i> مشاوره خرید: <a href="tel:@settings.Phone" dir="ltr">@settings.Phone</a></li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        @* ========== TABS ========== *@
        <div class="pd-tabs-wrap" id="pdTabs">
            <ul class="nav pd-tabs" role="tablist">
                <li role="presentation"><button class="active" type="button" data-bs-toggle="tab" data-bs-target="#tab-desc" role="tab">توضیحات</button></li>
                @if (course && lessons.Any())
                {
                    <li role="presentation"><button type="button" data-bs-toggle="tab" data-bs-target="#tab-lessons" role="tab">سرفصل‌ها (@lessons.Count.ToFa())</button></li>
                }
                else if (digital && files.Any())
                {
                    <li role="presentation"><button type="button" data-bs-toggle="tab" data-bs-target="#tab-files" role="tab">فایل‌ها (@files.Count.ToFa())</button></li>
                }
                @if (attributes.Any())
                {
                    <li role="presentation"><button type="button" data-bs-toggle="tab" data-bs-target="#tab-specs" role="tab">مشخصات</button></li>
                }
                @if (options.ShowReviews)
                {
                    <li role="presentation"><button type="button" data-bs-toggle="tab" data-bs-target="#tab-reviews" role="tab" id="tab-reviews-btn">نظرات (@reviews.Count)</button></li>
                }
            </ul>
            <div class="tab-content pd-tab-body">
                <div class="tab-pane fade show active" id="tab-desc" role="tabpanel">
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="pd-desc">@Model.Description</div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">توضیحاتی برای این محصول ثبت نشده است.</p>
                    }
                </div>
                @if (course && lessons.Any())
                {
                    <div class="tab-pane fade" id="tab-lessons" role="tabpanel">
                        <div class="pd-curriculum">
                            @foreach (var group in lessons.Select((l, i) => new { Lesson = l, Number = i + 1 }).GroupBy(x => x.Lesson.Section ?? ""))
                            {
                                if (!string.IsNullOrWhiteSpace(group.Key))
                                {
                                    <h4>@group.Key</h4>
                                }
                                <ol>
                                    @foreach (var x in group)
                                    {
                                        var open = owned || x.Lesson.IsFree;
                                        <li class="@(open ? "is-open" : "is-locked")">
                                            <span class="pd-lesson-no">@x.Number.ToFa()</span>
                                            @if (open)
                                            {
                                                <a href="@Url.Action("Learn","ShopAccount", new { company, id = Model.Id, lesson = x.Lesson.Id })">@x.Lesson.Title</a>
                                            }
                                            else
                                            {
                                                <span>@x.Lesson.Title</span>
                                            }
                                            @if (x.Lesson.IsFree && !owned) { <em class="pd-free">رایگان</em> }
                                            @if (!string.IsNullOrWhiteSpace(x.Lesson.Duration)) { <small>@x.Lesson.Duration.ToFaDigits()</small> }
                                            <i class="bi @(open ? "bi-play-circle" : "bi-lock")"></i>
                                        </li>
                                    }
                                </ol>
                            }
                        </div>
                    </div>
                }
                else if (digital && files.Any())
                {
                    <div class="tab-pane fade" id="tab-files" role="tabpanel">
                        <ul class="pd-files">
                            @foreach (var f in files)
                            {
                                <li>
                                    <i class="bi bi-file-earmark-arrow-down"></i>
                                    <span>@f.Title</span>
                                    <small>@System.IO.Path.GetExtension(f.FileName).TrimStart('.').ToUpperInvariant() · @f.Size.ToFileSize()</small>
                                    <i class="bi @(owned ? "bi-unlock" : "bi-lock")"></i>
                                </li>
                            }
                        </ul>
                        @if (!owned)
                        {
                            <p class="text-muted small mb-0 mt-2"><i class="bi bi-shield-lock"></i> فایل‌ها پس از خرید در «کتابخانه من» قابل دانلود هستند.</p>
                        }
                    </div>
                }
                @if (attributes.Any())
                {
                    <div class="tab-pane fade" id="tab-specs" role="tabpanel">
                        <table class="pd-spec-table">
                            @foreach (var a in attributes)
                            {
                                <tr><th>@a.Name</th><td>@a.Value</td></tr>
                            }
                        </table>
                    </div>
                }
                @if (options.ShowReviews)
                {
                <div class="tab-pane fade" id="tab-reviews" role="tabpanel">
                    <div class="pd-reviews">
                        <div class="pd-review-list">
                            @if (reviews.Any())
                            {
                                <div class="pd-review-summary">
                                    <strong>@avg.ToString("0.0")</strong>
                                    <span>از ۵ — بر اساس @reviews.Count نظر</span>
                                </div>
                                foreach (var r in reviews)
                                {
                                    <div class="pd-review">
                                        <div class="pd-review-head">
                                            <strong>@r.AuthorName</strong>
                                            <span class="pd-review-stars">
                                                @for (var s = 1; s <= 5; s++)
                                                {
                                                    <i class="bi @(r.Rating >= s ? "bi-star-fill" : "bi-star")"></i>
                                                }
                                            </span>
                                        </div>
                                        <div class="pd-review-date">@r.CreatedAt.ToShamsi()</div>
                                        <p>@r.Comment</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">هنوز نظری ثبت نشده است. تجربه خود را با دیگران به اشتراک بگذارید.</p>
                            }
                        </div>
                        <div class="pd-review-form">
                            <h3>نظر شما درباره این محصول</h3>
                            @using (Html.BeginForm("AddReview", "Shop", new { company }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <div class="mb-2"><label class="form-label">نام</label><input class="form-control" name="authorName" required maxlength="60" /></div>
                                <div class="mb-2">
                                    <label class="form-label">امتیاز</label>
                                    <select class="form-select" name="rating">
                                        <option value="5">۵ — عالی</option>
                                        <option value="4">۴ — خوب</option>
                                        <option value="3">۳ — متوسط</option>
                                        <option value="2">۲ — ضعیف</option>
                                        <option value="1">۱ — خیلی ضعیف</option>
                                    </select>
                                </div>
                                <div class="mb-3"><label class="form-label">نظر شما</label><textarea class="form-control" name="comment" rows="4" required maxlength="1000"></textarea></div>
                                <button class="btn-wm" type="submit">ثبت نظر</button>
                            }
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>

        @if (related.Any())
        {
            <div class="pd-related">
                <div class="pd-related-head">
                    <h2>محصولات مشابه</h2>
                    @if (category != null)
                    {
                        <a href="@Url.Action("Catalog","Shop", new { company, categoryId = category.Id })">مشاهده همه <i class="bi bi-arrow-left"></i></a>
                    }
                </div>
                <div class="cat-grid">
                    @foreach (var p in related)
                    {
                        @Html.Partial("_StoreProductCard", p)
                    }
                </div>
            </div>
        }
    </div>
</section>

@if (!outOfStock && !owned)
{
    <div class="pd-sticky">
        <div>
            <div class="pd-sticky-title">@Model.Title</div>
            <div class="pd-sticky-price">@(Model.Price == 0 ? "رایگان" : Model.Price.ToToman())</div>
        </div>
        <button class="btn-wm" type="submit" form="pdBuyForm"><i class="bi @(digital ? "bi-cart-plus" : "bi-bag-plus")"></i> @(digital ? "خرید" : "افزودن به سبد")</button>
    </div>
}

<div class="pg-lightbox" id="pgLightbox" hidden>
    <div class="pg-lb-top">
        <span class="pg-counter"><b>1</b> / @Math.Max(1, images.Count)</span>
        <button type="button" class="pg-lb-close" aria-label="بستن"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="pg-track" aria-label="تصاویر محصول در اندازه بزرگ">
        @if (images.Any())
        {
            for (var i = 0; i < images.Count; i++)
            {
                <div class="pg-slide">
                    <img class="pg-img is-low" data-low="@(images[i].ThumbUrl ?? images[i].LargeUrl)" data-large="@(images[i].LargeUrl ?? images[i].ThumbUrl)" alt="@Model.Title - تصویر @(i + 1)" draggable="false" />
                </div>
            }
        }
        else
        {
            <div class="pg-slide"><img class="pg-img" data-low="@placeholder" data-large="@placeholder" alt="@Model.Title" draggable="false" /></div>
        }
    </div>
    @if (images.Count > 1)
    {
        <button type="button" class="pg-nav pg-prev" aria-label="تصویر قبلی"><i class="bi bi-chevron-right"></i></button>
        <button type="button" class="pg-nav pg-next" aria-label="تصویر بعدی"><i class="bi bi-chevron-left"></i></button>
    }
</div>

@section scripts {
<script src="~/Content/product-gallery.js"></script>
}
