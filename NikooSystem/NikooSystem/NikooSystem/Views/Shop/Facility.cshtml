@model StoreFacility
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    var company = (string)ViewBag.CompanyCode;
    var day = ViewBag.Day as DateTime?;
    var days = (List<KeyValuePair<string, string>>)ViewBag.Days;
    var slots = (List<DateTime>)ViewBag.Slots;
    var dayKey = day.HasValue ? day.Value.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : "";
    Func<DateTime, string> clock = t => t.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);
}
<section class="bk-book">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="bk-panel h-100">
                    <div class="bk-kicker"><i class="bi bi-trophy"></i> رزرو ساعتی</div>
                    <h1>@Model.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    <ul class="bk-hero-facts">
                        <li><i class="bi bi-clock"></i> هر نوبت @BookingTime.Duration(Model.SlotMinutes)</li>
                        @if (!string.IsNullOrWhiteSpace(Model.Place))
                        {
                            <li><i class="bi bi-geo-alt"></i> @Model.Place</li>
                        }
                        <li><i class="bi bi-cash"></i> @(Model.Price > 0 ? Model.Price.ToToman() + " برای هر نوبت" : "رایگان")</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="bk-panel">
                    <label class="form-label" for="facilityDay">روز</label>
                    <select class="form-select mb-3" id="facilityDay" onchange="if (this.value) location = this.value;">
                        @foreach (var option in days)
                        {
                            var url = Url.Action("Facility", "Shop", new { company, id = Model.Id, date = option.Key });
                            <option value="@url" @(option.Key == dayKey ? "selected" : null)>@option.Value</option>
                        }
                    </select>
                    @if (!days.Any())
                    {
                        <p class="text-muted mb-0">در روزهای پیش رو ساعتی برای این سالن باز نیست.</p>
                    }
                    else if (!slots.Any())
                    {
                        <p class="text-muted mb-0">در این روز ساعت خالی نیست. روز دیگری را انتخاب کنید.</p>
                    }
                    else
                    {
                        using (Html.BeginForm("BookFacility", "Shop", new { company }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="facilityId" value="@Model.Id" />
                            <input type="hidden" name="date" value="@dayKey" />
                            <input class="d-none" name="website" tabindex="-1" autocomplete="off" />
                            <div class="mb-3">
                                <div class="form-label">ساعت</div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var slot in slots)
                                    {
                                        <label class="btn btn-outline-secondary">
                                            <input type="radio" name="time" value="@clock(slot)" required />
                                            @BookingTime.Clock(slot)
                                        </label>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="fbName">نام و نام خانوادگی</label>
                                <input class="form-control" id="fbName" name="customerName" maxlength="80" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="fbMobile">موبایل</label>
                                <input class="form-control" id="fbMobile" name="customerMobile" dir="ltr" maxlength="14" required inputmode="tel" placeholder="09121234567" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="fbEmail">ایمیل (اختیاری)</label>
                                <input class="form-control" id="fbEmail" name="customerEmail" type="email" maxlength="120" dir="ltr" />
                            </div>
                            <button class="btn-wm w-100" type="submit"><i class="bi bi-calendar-check"></i> رزرو این ساعت</button>
                        }
                    }
                    <div class="mt-3 small"><a href="@Url.Action("CampusTrack","Shop", new { company })">رزرو قبلی دارید؟ پیگیری</a></div>
                </div>
            </div>
        </div>
    </div>
</section>
