@model List<StoreFacility>
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    var company = (string)ViewBag.CompanyCode;
    var sports = string.Equals(((TenantInfo)ViewBag.Tenant)?.StoreType, "club", StringComparison.OrdinalIgnoreCase);
}
<section class="cn-section bk-section">
    <div class="container">
        <h1 class="cn-block-title">@(sports ? "رزرو سالن و زمین" : "اجاره اتاق و کلاس")</h1>
        <p class="text-muted">@(sports ? "سالن فوتبال، میز پینگ‌پونگ یا هر فضای دیگری را ساعتی رزرو کنید. فقط ساعت‌های خالی نمایش داده می‌شوند." : "اتاق تمرین یا کلاس خالی را ساعتی رزرو کنید. فقط ساعت‌های خالی نمایش داده می‌شوند.")</p>
        @if (Model.Any())
        {
            <div class="bk-services">
                @foreach (var item in Model)
                {
                    @Html.Partial("_CampusFacilityCard", item)
                }
            </div>
        }
        else
        {
            <div class="bk-panel">هنوز سالنی برای رزرو تعریف نشده است.</div>
        }
    </div>
</section>
