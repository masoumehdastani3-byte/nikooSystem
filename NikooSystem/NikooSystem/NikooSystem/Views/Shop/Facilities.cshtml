@model List<StoreFacility>
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    var company = (string)ViewBag.CompanyCode;
}
<section class="cn-section bk-section">
    <div class="container">
        <h1 class="cn-block-title">رزرو سالن و زمین</h1>
        <p class="text-muted">سالن فوتبال، میز پینگ‌پونگ یا هر فضای دیگری را ساعتی رزرو کنید. فقط ساعت‌های خالی نمایش داده می‌شوند.</p>
        @if (Model.Any())
        {
            <div class="bk-services">
                @foreach (var item in Model)
                {
                    @Html.Partial("_CampusFacilityCard", item)
                }
            </div>
        }
        else
        {
            <div class="bk-panel">هنوز سالنی برای رزرو تعریف نشده است.</div>
        }
    </div>
</section>
