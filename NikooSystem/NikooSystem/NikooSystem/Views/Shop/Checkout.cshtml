@using NikooSystem.Helpers
@using NikooSystem.Models.Store
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = "تسویه حساب";
    var company = (string)ViewBag.CompanyCode;
    var cart = (IEnumerable<StoreCartItem>)ViewBag.Cart;
    var customer = ViewBag.Customer as StoreCustomer;
    var total = cart.Sum(x => x.UnitPrice * x.Quantity);
}
<section class="py-4">
    <div class="container">
        <h1 class="section-title">تسویه حساب</h1>
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="panel-card">
                    <h5>خلاصه سفارش</h5>
                    @foreach (var item in cart)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span>@item.Title × @item.Quantity</span>
                            <strong>@((item.UnitPrice * item.Quantity).ToToman())</strong>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between"><span>مبلغ قابل پرداخت</span><strong class="price">@total.ToToman()</strong></div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="panel-card">
                    @using (Html.BeginForm("Checkout", "Shop", new { company }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">نام و نام خانوادگی</label>
                                <input class="form-control" name="customerName" value="@(customer?.FullName)" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">موبایل</label>
                                <input class="form-control" name="customerMobile" value="@(customer?.Mobile)" placeholder="09121234567" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ایمیل</label>
                                <input class="form-control" name="customerEmail" value="@(customer?.Email)" type="email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">آدرس</label>
                                <input class="form-control" name="customerAddress" value="@(customer?.Address)" />
                            </div>
                            <div class="col-12">
                                <button class="btn-store" type="submit"><i class="bi bi-credit-card"></i> پرداخت آنلاین</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
