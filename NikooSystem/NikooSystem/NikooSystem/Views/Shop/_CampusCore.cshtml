@{
    var company = (string)ViewBag.CompanyCode;
    var classes = (List<StoreClass>)ViewBag.Classes ?? new List<StoreClass>();
    var facilities = (List<StoreFacility>)ViewBag.Facilities ?? new List<StoreFacility>();
    var sports = string.Equals(((TenantInfo)ViewBag.Tenant)?.StoreType, "club", StringComparison.OrdinalIgnoreCase);
}
@if (classes.Any())
{
    <section class="cn-section bk-section">
        <div class="container">
            <div class="cn-head">
                <h2 class="cn-block-title">@(sports ? "کلاس‌ها و دوره‌ها" : "دوره‌های عمومی")</h2>
                <a class="hs-more" href="@Url.Action("Classes","Shop", new { company })">@(sports ? "همه کلاس‌ها" : "همه دوره‌های عمومی") <i class="bi bi-arrow-left"></i></a>
            </div>
            <div class="bk-services">
                @foreach (var item in classes.Take(6))
                {
                    @Html.Partial("_CampusClassCard", item)
                }
            </div>
        </div>
    </section>
}

@if (facilities.Any())
{
    <section class="cn-section bk-section bk-section-alt">
        <div class="container">
            <div class="cn-head">
                <h2 class="cn-block-title">@(sports ? "سالن‌ها و زمین‌ها" : "اتاق‌ها و کلاس‌ها")</h2>
                <a class="hs-more" href="@Url.Action("Facilities","Shop", new { company })">رزرو ساعتی <i class="bi bi-arrow-left"></i></a>
            </div>
            <div class="bk-services">
                @foreach (var item in facilities.Take(6))
                {
                    @Html.Partial("_CampusFacilityCard", item)
                }
            </div>
        </div>
    </section>
}
