@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    var company = (string)ViewBag.CompanyCode;
}
<section class="rp-page">
    <div class="container rp-wrap-narrow">
        <div class="rp-card">
            <h1 class="h3">پیگیری تعمیر</h1>
            <p class="text-muted">کد پنج‌رقمی و همان شماره موبایلی را که موقع درخواست دادید بنویسید.</p>
            @using (Html.BeginForm("RepairTrack", "Shop", new { company }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label" for="rpCode">کد پیگیری</label>
                    <input class="form-control text-center font-monospace" id="rpCode" name="code" value="@ViewBag.Code" dir="ltr" maxlength="12" required autocomplete="off" inputmode="numeric" placeholder="48219" style="letter-spacing:.15em" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="rpMobile">شماره موبایل</label>
                    <input class="form-control text-center" id="rpMobile" name="mobile" dir="ltr" maxlength="14" required inputmode="tel" placeholder="09121234567" />
                </div>
                <button class="btn-wm w-100" type="submit">مشاهده وضعیت</button>
            }
            <div class="mt-3"><a href="@Url.Action("RepairRequest","Shop", new { company })">هنوز درخواستی ندارید؟</a></div>
        </div>
    </div>
</section>
