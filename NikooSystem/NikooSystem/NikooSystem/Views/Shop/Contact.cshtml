@model StoreContactMessage
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    var company = (string)ViewBag.CompanyCode;
    var settings = (StoreSettings)ViewBag.Settings;
    ViewBag.Title = "تماس با ما";
}

<section class="cn-contact py-5">
    <div class="container">
        <nav class="cat-breadcrumb" aria-label="مسیر">
            <a href="@Url.Action("Index","Shop", new { company })">خانه</a>
            <i class="bi bi-chevron-left"></i>
            <span>تماس با ما</span>
        </nav>
        <h1 class="mb-4">تماس با @settings.StoreName</h1>
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="cn-contact-info">
                    @if (!string.IsNullOrWhiteSpace(settings.Phone))
                    {
                        <a href="tel:@settings.Phone"><i class="bi bi-telephone"></i><span><small>تلفن</small><strong dir="ltr">@settings.Phone</strong></span></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(settings.Email))
                    {
                        <a href="mailto:@settings.Email"><i class="bi bi-envelope"></i><span><small>ایمیل</small><strong>@settings.Email</strong></span></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(settings.Address))
                    {
                        <div><i class="bi bi-geo-alt"></i><span><small>نشانی</small><strong>@settings.Address</strong></span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(settings.About))
                    {
                        <p class="mt-3 mb-0 text-muted">@settings.About</p>
                    }
                </div>
            </div>
            <div class="col-lg-8">
                <div class="cn-contact-form">
                    <h2>ارسال پیام</h2>
                    <p class="text-muted">پیام شما مستقیم به صندوق پیام‌های مدیر سایت می‌رسد.</p>
                    @using (Html.BeginForm("Contact", "Shop", new { company }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="cn-hp" aria-hidden="true">
                            <label>وب‌سایت <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="FullName">نام و نام خانوادگی *</label>
                                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", maxlength = 80, required = "required" })
                                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="Mobile">شماره تماس</label>
                                @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control", dir = "ltr", placeholder = "09xxxxxxxxx", maxlength = 11 })
                                @Html.ValidationMessageFor(m => m.Mobile, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="Email">ایمیل</label>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", dir = "ltr", maxlength = 120 })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="Subject">موضوع</label>
                                @Html.TextBoxFor(m => m.Subject, new { @class = "form-control", maxlength = 120 })
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="Message">متن پیام *</label>
                                @Html.TextAreaFor(m => m.Message, new { @class = "form-control", rows = 6, maxlength = 4000, required = "required" })
                                @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <button class="btn-wm mt-3" type="submit"><i class="bi bi-envelope"></i> ارسال پیام</button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
