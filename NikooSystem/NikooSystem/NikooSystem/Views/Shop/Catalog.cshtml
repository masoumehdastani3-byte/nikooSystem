@model PagedList<StoreProduct>
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    var company = (string)ViewBag.CompanyCode;
    var kind = (SiteKindInfo)ViewBag.Kind;
    var query = (CatalogQuery)ViewBag.Query;
    var cats = ((IEnumerable<StoreCategory>)ViewBag.Categories).OrderBy(c => c.SortOrder).ToList();
    var counts = (Dictionary<int, int>)ViewBag.CategoryCounts;
    var category = ViewBag.Category as StoreCategory;
    int? categoryId = category?.Id;
    var collection = ViewBag.Collection as StoreCollection;
    var q = query.Q;
    var sort = string.IsNullOrEmpty(query.Sort) ? "newest" : query.Sort;
    long? minPrice = query.MinPrice;
    long? maxPrice = query.MaxPrice;
    var inStock = query.InStock;
    var onSale = query.OnSale;
    var type = query.Type;
    var totalCount = Model.TotalCount;
    var fa = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
    var allLabel = kind.IsDigital ? "همه دوره‌ها و کتاب‌ها" : "همه محصولات";

    ViewBag.Title = collection != null ? collection.Title : category != null ? category.Title : type.HasValue ? type.Value.TypeText() : allLabel;
    ViewBag.MetaDescription = collection != null && !string.IsNullOrWhiteSpace(collection.Description)
        ? collection.Description
        : collection != null || category != null
            ? "خرید " + ViewBag.Title + " از " + ((StoreSettings)ViewBag.Settings).StoreName
            : allLabel + " " + ((StoreSettings)ViewBag.Settings).StoreName;

    var sorts = new[]
    {
        new { Id = "newest", Title = "جدیدترین" },
        new { Id = "bestseller", Title = "پرفروش‌ترین" },
        new { Id = "popular", Title = "پربازدیدترین" },
        new { Id = "price_asc", Title = "ارزان‌ترین" },
        new { Id = "price_desc", Title = "گران‌ترین" },
        new { Id = "rating", Title = "بیشترین امتیاز" }
    };
    var hasFilters = categoryId.HasValue || collection != null || !string.IsNullOrWhiteSpace(q) || minPrice.HasValue || maxPrice.HasValue || inStock || onSale || type.HasValue;
    var roots = cats.Where(c => c.ParentId == null).ToList();
}
@functions {
    /// <summary>آدرس همین صفحه با فیلترهای فعلی؛ مقدار null یک فیلتر را حذف می‌کند</summary>
    string CatalogUrl(object overrides)
    {
        var query = (CatalogQuery)ViewBag.Query;
        var values = new System.Web.Routing.RouteValueDictionary
        {
            { "company", ViewBag.CompanyCode },
            { "categoryId", ViewBag.Category == null ? null : (object)((StoreCategory)ViewBag.Category).Id },
            { "collectionId", ViewBag.Collection == null ? null : (object)((StoreCollection)ViewBag.Collection).Id },
            { "q", query.Q },
            { "sort", query.Sort },
            { "minPrice", query.MinPrice },
            { "maxPrice", query.MaxPrice },
            { "inStock", query.InStock ? (object)true : null },
            { "onSale", query.OnSale ? (object)true : null },
            { "type", query.Type },
            { "previewTemplate", ViewBag.PreviewTemplate }
        };
        foreach (var kv in new System.Web.Routing.RouteValueDictionary(overrides))
            values[kv.Key] = kv.Value;
        if (!values.ContainsKey("page")) values["page"] = null;
        if ((values["sort"] as string) == "newest") values["sort"] = null;
        foreach (var key in values.Keys.ToList())
        {
            var v = values[key];
            if (v == null || (v is string && string.IsNullOrWhiteSpace((string)v)) || (v is int && (int)v == 1 && key == "page"))
                values.Remove(key);
        }
        return Url.Action("Catalog", "Shop", values);
    }
}

<div class="cat-hero">
    <div class="container">
        <nav class="cat-breadcrumb" aria-label="مسیر">
            <a href="@Url.Action("Index","Shop", new { company })">خانه</a>
            <i class="bi bi-chevron-left"></i>
            @if (category != null || collection != null)
            {
                <a href="@CatalogUrl(new { categoryId = (int?)null, collectionId = (int?)null })">@kind.ItemsLabel</a>
                <i class="bi bi-chevron-left"></i>
                <span>@ViewBag.Title</span>
            }
            else
            {
                <span>@kind.ItemsLabel</span>
            }
        </nav>
        <h1>@ViewBag.Title</h1>
        @if (collection != null && !string.IsNullOrWhiteSpace(collection.Description))
        {
            <p class="cat-hero-desc">@collection.Description</p>
        }
        <p>@totalCount.ToString("N0", fa) مورد@(string.IsNullOrWhiteSpace(q) ? "" : " برای «" + q + "»")</p>
    </div>
</div>

<section class="pb-5">
    <div class="container">
        <div class="cat-layout">
            <aside class="cat-filters" id="catFilters">
                <div class="cat-filters-head">
                    <strong><i class="bi bi-funnel"></i> فیلترها</strong>
                    <button type="button" class="cat-filters-close" data-cat-toggle aria-label="بستن"><i class="bi bi-x-lg"></i></button>
                </div>

                <form method="get" action="@Url.Action("Catalog","Shop", new { company })">
                    @if (categoryId.HasValue) { <input type="hidden" name="categoryId" value="@categoryId" /> }
                    @if (collection != null) { <input type="hidden" name="collectionId" value="@collection.Id" /> }
                    @if (sort != "newest") { <input type="hidden" name="sort" value="@sort" /> }
                    @if (ViewBag.PreviewTemplate != null) { <input type="hidden" name="previewTemplate" value="@ViewBag.PreviewTemplate" /> }

                    <div class="cat-block">
                        <div class="cat-search">
                            <i class="bi bi-search"></i>
                            <input type="search" name="q" value="@q" placeholder="@(kind.IsDigital ? "جستجو در عنوان، نویسنده یا مدرس..." : "جستجو در محصولات...")" />
                        </div>
                    </div>

                    @if (kind.IsDigital)
                    {
                        <div class="cat-block">
                            <h3>نوع</h3>
                            <ul class="cat-tree">
                                <li><a class="@(type == null ? "active" : "")" href="@CatalogUrl(new { type = (StoreProductType?)null })">همه</a></li>
                                @foreach (var t in kind.ProductTypes())
                                {
                                    <li><a class="@(type == t ? "active" : "")" href="@CatalogUrl(new { type = t })"><i class="bi @t.TypeIcon()"></i> @t.TypeText()</a></li>
                                }
                            </ul>
                            @if (type.HasValue) { <input type="hidden" name="type" value="@type" /> }
                        </div>
                    }

                    <div class="cat-block">
                        <h3>دسته‌بندی</h3>
                        <ul class="cat-tree">
                            <li><a class="@(categoryId == null ? "active" : "")" href="@CatalogUrl(new { categoryId = (int?)null })">@allLabel</a></li>
                            @foreach (var root in roots)
                            {
                                var children = cats.Where(c => c.ParentId == root.Id).ToList();
                                <li>
                                    <a class="@(categoryId == root.Id ? "active" : "")" href="@CatalogUrl(new { categoryId = root.Id })">
                                        @root.Title <span class="cat-count">@(counts.ContainsKey(root.Id) ? counts[root.Id].ToString("N0", fa) : "۰")</span>
                                    </a>
                                    @if (children.Any())
                                    {
                                        <ul>
                                            @foreach (var ch in children)
                                            {
                                                <li>
                                                    <a class="@(categoryId == ch.Id ? "active" : "")" href="@CatalogUrl(new { categoryId = ch.Id })">
                                                        @ch.Title <span class="cat-count">@(counts.ContainsKey(ch.Id) ? counts[ch.Id].ToString("N0", fa) : "۰")</span>
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="cat-block">
                        <h3>محدوده قیمت (تومان)</h3>
                        <div class="cat-price">
                            <input type="number" name="minPrice" min="0" step="1000" value="@minPrice" placeholder="از" dir="ltr" />
                            <span>تا</span>
                            <input type="number" name="maxPrice" min="0" step="1000" value="@maxPrice" placeholder="تا" dir="ltr" />
                        </div>
                    </div>

                    <div class="cat-block">
                        @if (kind.IsShop)
                        {
                            <label class="cat-switch">
                                <input type="checkbox" name="inStock" value="true" @(inStock ? "checked" : null) />
                                <span>فقط کالاهای موجود</span>
                            </label>
                        }
                        <label class="cat-switch">
                            <input type="checkbox" name="onSale" value="true" @(onSale ? "checked" : null) />
                            <span>فقط تخفیف‌دار</span>
                        </label>
                    </div>

                    <button class="btn-wm w-100" type="submit">اعمال فیلتر</button>
                    @if (hasFilters)
                    {
                        <a class="cat-clear" href="@Url.Action("Catalog","Shop", new { company, previewTemplate = ViewBag.PreviewTemplate })">حذف همه فیلترها</a>
                    }
                </form>
            </aside>
            <div class="cat-backdrop" data-cat-toggle></div>

            <div class="cat-main">
                <div class="cat-toolbar">
                    <button type="button" class="cat-filter-btn" data-cat-toggle><i class="bi bi-funnel"></i> فیلترها</button>
                    <div class="cat-sort">
                        <span class="cat-sort-label"><i class="bi bi-sort-down"></i> مرتب‌سازی:</span>
                        @foreach (var s in sorts)
                        {
                            <a class="@(sort == s.Id ? "active" : "")" href="@CatalogUrl(new { sort = s.Id })">@s.Title</a>
                        }
                    </div>
                    <select class="cat-sort-select" onchange="location.href=this.value" aria-label="مرتب‌سازی">
                        @foreach (var s in sorts)
                        {
                            <option value="@CatalogUrl(new { sort = s.Id })" @(sort == s.Id ? "selected" : null)>@s.Title</option>
                        }
                    </select>
                </div>

                @if (hasFilters)
                {
                    <div class="cat-chips">
                        @if (collection != null)
                        {
                            <a href="@CatalogUrl(new { collectionId = (int?)null })"><i class="bi bi-tag"></i> @collection.Title <i class="bi bi-x"></i></a>
                        }
                        @if (type.HasValue)
                        {
                            <a href="@CatalogUrl(new { type = (StoreProductType?)null })">@type.Value.TypeText() <i class="bi bi-x"></i></a>
                        }
                        @if (category != null)
                        {
                            <a href="@CatalogUrl(new { categoryId = (int?)null })">@category.Title <i class="bi bi-x"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(q))
                        {
                            <a href="@CatalogUrl(new { q = (string)null })">«@q» <i class="bi bi-x"></i></a>
                        }
                        @if (minPrice.HasValue)
                        {
                            <a href="@CatalogUrl(new { minPrice = (long?)null })">از @minPrice.Value.ToString("N0", fa) تومان <i class="bi bi-x"></i></a>
                        }
                        @if (maxPrice.HasValue)
                        {
                            <a href="@CatalogUrl(new { maxPrice = (long?)null })">تا @maxPrice.Value.ToString("N0", fa) تومان <i class="bi bi-x"></i></a>
                        }
                        @if (inStock)
                        {
                            <a href="@CatalogUrl(new { inStock = (bool?)null })">فقط موجود <i class="bi bi-x"></i></a>
                        }
                        @if (onSale)
                        {
                            <a href="@CatalogUrl(new { onSale = (bool?)null })">فقط تخفیف‌دار <i class="bi bi-x"></i></a>
                        }
                    </div>
                }

                @if (Model.Any())
                {
                    if (Model.Page > 1)
                    {
                        <a class="infinite-prev" href="@CatalogUrl(new { page = (int?)null })"><i class="bi bi-arrow-up"></i> از ابتدای فهرست</a>
                    }
                    <div class="cat-grid" data-infinite>
                        @Html.Partial("_CatalogItems", Model)
                    </div>
                }
                else
                {
                    <div class="cat-empty">
                        <i class="bi bi-search"></i>
                        <h3>موردی با این مشخصات پیدا نشد</h3>
                        <p>فیلترها را تغییر دهید یا عبارت دیگری جستجو کنید.</p>
                        <a class="btn-wm" href="@Url.Action("Catalog","Shop", new { company, previewTemplate = ViewBag.PreviewTemplate })">@allLabel</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section scripts {
<script src="@Url.Asset("~/Content/infinite-scroll.js")"></script>
<script>
(function () {
  document.querySelectorAll('[data-cat-toggle]').forEach(function (el) {
    el.addEventListener('click', function () {
      document.body.classList.toggle('cat-filters-open');
    });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') document.body.classList.remove('cat-filters-open');
  });
})();
</script>
}
