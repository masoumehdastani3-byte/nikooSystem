@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = "پیگیری ثبت‌نام و رزرو";
    var company = (string)ViewBag.CompanyCode;
}
<section class="bk-book">
    <div class="container">
        <div class="bk-track">
            <span class="bk-track-icon"><i class="bi bi-search"></i></span>
            <h1>پیگیری</h1>
            <p class="text-muted">کد پیگیری ثبت‌نام کلاس، رزرو سالن یا کلاس خصوصی را همراه با شماره موبایل وارد کنید.</p>
            @using (Html.BeginForm("CampusTrack", "Shop", new { company }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="mb-3 text-start">
                    <label class="form-label" for="trCode">کد پیگیری</label>
                    <input class="form-control text-center font-monospace" id="trCode" name="code" value="@ViewBag.Code" dir="ltr" maxlength="12" required autocomplete="off" style="letter-spacing:.2em;text-transform:uppercase" />
                </div>
                <div class="mb-3 text-start">
                    <label class="form-label" for="trMobile">شماره موبایل</label>
                    <input class="form-control text-center" id="trMobile" name="mobile" dir="ltr" maxlength="14" required inputmode="tel" placeholder="09121234567" />
                </div>
                <button class="btn-wm w-100" type="submit"><i class="bi bi-arrow-left-circle"></i> مشاهده</button>
            }
        </div>
    </div>
</section>
