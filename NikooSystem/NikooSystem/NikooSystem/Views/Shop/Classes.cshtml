@model List<StoreClass>
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    var company = (string)ViewBag.CompanyCode;
    var school = string.Equals(((TenantInfo)ViewBag.Tenant)?.StoreType, "school", StringComparison.OrdinalIgnoreCase);
}
<section class="cn-section bk-section">
    <div class="container">
        <h1 class="cn-block-title">@(school ? "دوره‌های عمومی" : "کلاس‌ها و دوره‌ها")</h1>
        <p class="text-muted">@(school ? "دوره عمومی را انتخاب کنید و ثبت‌نام کنید. برای جلسه یک‌نفره با مدرس، " : "کلاس گروهی را انتخاب کنید و ثبت‌نام کنید. برای جلسه با مدرس خصوصی، ")<a href="@Url.Action("Book","Shop", new { company })">@(school ? "دوره خصوصی" : "رزرو کلاس خصوصی")</a> را ببینید.</p>
        @if (Model.Any())
        {
            <div class="bk-services">
                @foreach (var item in Model)
                {
                    @Html.Partial("_CampusClassCard", item)
                }
            </div>
        }
        else
        {
            <div class="bk-panel">هنوز کلاسی برای ثبت‌نام باز نشده است.</div>
        }
    </div>
</section>
