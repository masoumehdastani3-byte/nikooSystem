@model StorePage
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = Model.Title;
}
<section class="py-4">
    <div class="container" style="max-width:860px;">
        <h1 class="section-title">@Model.Title</h1>
        <div class="panel-card rich-text">
            @Html.Raw(Model.BodyHtml)
        </div>
    </div>
</section>
