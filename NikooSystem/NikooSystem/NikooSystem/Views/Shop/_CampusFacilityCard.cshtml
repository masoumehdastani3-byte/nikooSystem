@model StoreFacility
@{
    var company = (string)ViewBag.CompanyCode;
}
<article class="bk-service">
    <span class="bk-service-icon"><i class="bi bi-trophy"></i></span>
    <div class="bk-service-body">
        <h3>@Model.Title</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
        <div class="bk-service-meta">
            <span><i class="bi bi-clock"></i> هر نوبت @BookingTime.Duration(Model.SlotMinutes)</span>
            @if (Model.Capacity > 1)
            {
                <span><i class="bi bi-people"></i> @Model.Capacity.ToFa() نفر همزمان</span>
            }
            <span class="bk-price">@(Model.Price > 0 ? Model.Price.ToToman() : "رایگان")</span>
        </div>
    </div>
    <a class="btn-wm bk-service-cta" href="@Url.Action("Facility","Shop", new { company, id = Model.Id })"><i class="bi bi-calendar-plus"></i> رزرو</a>
</article>
