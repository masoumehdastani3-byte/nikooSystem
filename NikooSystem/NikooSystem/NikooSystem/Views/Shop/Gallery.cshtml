@model IEnumerable<NikooSystem.Models.Store.StoreGalleryItem>
@{
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
    ViewBag.Title = "گالری";
    var company = (string)ViewBag.CompanyCode;
    var albums = (IEnumerable<string>)ViewBag.Albums ?? Enumerable.Empty<string>();
    var album = ViewBag.Album as string;
}
<section class="py-4">
    <div class="container">
        <h1 class="section-title">گالری تصاویر</h1>
        <div class="mb-4">
            <a class="cat-chip @(string.IsNullOrEmpty(album)?"active":"")" href="@Url.Action("Gallery","Shop", new { company })">همه</a>
            @foreach (var a in albums)
            {
                <a class="cat-chip @(album==a?"active":"")" href="@Url.Action("Gallery","Shop", new { company, album = a })">@a</a>
            }
        </div>
        <div class="gallery-grid">
            @foreach (var g in Model)
            {
                <a class="gallery-item" href="@(g.LargeUrl ?? g.ThumbUrl)" target="_blank" rel="noopener">
                    <img src="@(g.ThumbUrl ?? g.LargeUrl)" alt="@g.Title" loading="lazy" />
                </a>
            }
        </div>
    </div>
</section>
