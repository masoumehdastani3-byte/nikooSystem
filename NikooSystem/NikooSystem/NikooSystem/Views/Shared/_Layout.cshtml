<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewBag.Title - نیکو سیستم آفرین</title>
    <meta name="description" content="نیکو سیستم آفرین | فروشگاه‌های آنلاین آماده — از دمو تا پرداخت آنلاین">
    <link href="~/Assets/img/favicon.png" rel="icon">
    <link href="~/Assets/vendor/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/Assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/Assets/vendor/remixicon/remixicon.css" rel="stylesheet">
    <link href="~/Assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <link href="~/Assets/css/style.css" rel="stylesheet">
    <link href="~/Content/shop.css" rel="stylesheet">
    <link href="~/Content/landing.css" rel="stylesheet">
    <style>
      /* جلوگیری از مخفی ماندن محتوا اگر AOS دیر لود شود */
      [data-aos] { opacity: 1 !important; transform: none !important; }
      body, h1, h2, h3, h4, h5, h6, button, input, textarea, select {
        font-family: 'Far_Yekan', Tahoma !important;
      }
    </style>
</head>
<body class="@(ViewBag.Nav as string == "home" ? "lf-home" : null)">
    <header id="header" class="header fixed-top">
        <div class="container-fluid container-xl d-flex align-items-center justify-content-between">
            <a href="@Url.Action("Index","Home")" class="logo d-flex align-items-center">
                <img src="~/Assets/img/logo.png" alt="نیکو سیستم آفرین">
                <span>نیکو سیستم آفرین</span>
            </a>
            <nav id="navbar" class="navbar">
                <ul>
                    <li><a class="nav-link @(ViewBag.Nav=="home"?"active":"")" href="@Url.Action("Index","Home")">خانه</a></li>
                    <li><a class="nav-link @(ViewBag.Nav=="products"?"active":"")" href="@Url.Action("Index","Products")">محصولات</a></li>
                    <li><a class="nav-link @(ViewBag.Nav=="about"?"active":"")" href="@Url.Action("About","Home")">درباره ما</a></li>
                    <li><a class="nav-link @(ViewBag.Nav=="contact"?"active":"")" href="@Url.Action("Contact","Home")">تماس با ما</a></li>
                    <li><a class="nav-link" href="@Url.Action("Login","Signup")">ورود فروشندگان</a></li>
                    <li><a class="getstarted" href="@Url.Action("Index","Signup")"><i class="bi bi-rocket-takeoff"></i> ساخت فروشگاه رایگان</a></li>
                </ul>
                <i class="bi bi-list mobile-nav-toggle"></i>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer id="footer" class="footer">
        <div class="footer-newsletter lf-social lf-social-footer">
            <div class="container">
                <a class="lf-social-card" href="http://labkhandfarda.ir/" target="_blank" rel="noopener noreferrer">
                    <div class="lf-social-media">
                        <img src="~/Assets/img/labkhand-farda.png" alt="فعالیت های اجتماعی لبخند فردا" />
                    </div>
                    <div class="lf-social-body">
                        <span class="lf-social-eyebrow"><i class="bi bi-heart-fill"></i> مسئولیت اجتماعی</span>
                        <h2>فعالیت های اجتماعی</h2>
                        <p>
                            نیکو سیستم آفرین در کنار فعالیت‌های تخصصی، از طرح‌های خیریه و قرض‌الحسنه
                            «لبخند فردا» حمایت می‌کند؛ جایی برای کمک به نیازمندان، وام بدون بهره و همراهی اجتماعی.
                        </p>
                        <span class="lf-btn lf-btn-warm">
                            ورود به لبخند فردا <i class="bi bi-box-arrow-up-left"></i>
                        </span>
                    </div>
                </a>
            </div>
        </div>
        <div class="footer-top">
            <div class="container">
                <div class="row gy-4">
                    <div class="col-lg-5 col-md-12 footer-info">
                        <a href="@Url.Action("Index","Home")" class="logo d-flex align-items-center">
                            <img src="~/Assets/img/logo_full.png" alt="نیکو سیستم آفرین">
                            <span class="ms-2">نیکو سیستم آفرین</span>
                        </a>
                        <p class="mt-3">نیکو سیستم آفرین؛ فروشگاه‌های آنلاین آماده. دمو را ببینید، سفارش دهید و آنلاین پرداخت کنید.</p>
                    </div>
                    <div class="col-lg-2 col-6 footer-links">
                        <h4>لینک‌های مفید</h4>
                        <ul>
                            <li><i class="bi bi-chevron-left"></i> <a href="@Url.Action("Index","Home")">خانه</a></li>
                            <li><i class="bi bi-chevron-left"></i> <a href="@Url.Action("Index","Products")">محصولات</a></li>
                            <li><i class="bi bi-chevron-left"></i> <a href="@Url.Action("Terms","Home")">شرایط استفاده</a></li>
                            <li><i class="bi bi-chevron-left"></i> <a href="@Url.Action("Privacy","Home")">حریم خصوصی</a></li>
                            <li><i class="bi bi-chevron-left"></i> <a href="@Url.Action("Guide","Pay")">راهنمای پرداخت</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-2 col-6 footer-links">
                        <h4>محصولات</h4>
                        <ul>
                            <li><i class="bi bi-chevron-left"></i> <a href="@Url.Action("Index","Signup")">ساخت فروشگاه رایگان</a></li>
                            <li><i class="bi bi-chevron-left"></i> <a href="@Url.Action("Login","Signup")">ورود فروشندگان</a></li>
                            <li><i class="bi bi-chevron-left"></i> <a href="@Url.Action("Index","Products", new { category = "فروشگاه آنلاین" })">فروشگاه‌های نمونه</a></li>
                            <li><i class="bi bi-chevron-left"></i> <a href="@Url.Action("Index","Products")">همه محصولات</a></li>
                            <li><i class="bi bi-chevron-left"></i> <a href="@Url.Action("Login","Admin")">ورود پنل</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-3 col-md-12 footer-contact text-center text-md-start">
                        <h4>تماس با ما</h4>in
                        <p>
                            تهران، نارمک<br>
                            خیابان شهید نیلفروشان ، پلاک 679<br><br>
                            <strong>تلفن:</strong> 021-77458550<br>
                            <strong>ایمیل:</strong> info@nikoooo.ir
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="copyright">
                &copy; @DateTime.Now.Year <strong><span>نیکو سیستم آفرین</span></strong> — همه حقوق محفوظ است
            </div>
        </div>
    </footer>

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <script src="~/Assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Assets/vendor/aos/aos.js"></script>
    <script src="~/Assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/Assets/vendor/purecounter/purecounter.js"></script>
    <script src="~/Assets/js/main.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>