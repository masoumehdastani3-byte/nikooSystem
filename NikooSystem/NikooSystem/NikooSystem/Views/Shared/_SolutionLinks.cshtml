@model IEnumerable<ProductLanding>
<div class="lf-land-links">
    @foreach (var p in Model)
    {
        <a class="lf-land-link" href="@Url.RouteUrl("Solution", new { slug = p.Slug })">
            <i class="bi @p.Icon" aria-hidden="true"></i>
            <span>
                <strong>@p.Name</strong>
                <em>@p.Summary</em>
            </span>
            <i class="bi bi-arrow-left lf-land-link-go" aria-hidden="true"></i>
        </a>
    }
</div>
