@using System.Linq
@using NikooSystem.Helpers
@{
    var settings = (NikooSystem.Models.Store.StoreSettings)ViewBag.Settings;
    var company = (string)ViewBag.CompanyCode;
    var menus = (IEnumerable<NikooSystem.Models.Store.StoreMenuItem>)ViewBag.Menus
        ?? Enumerable.Empty<NikooSystem.Models.Store.StoreMenuItem>();
    var cartCount = (int)(ViewBag.CartCount ?? 0);
    var template = StoreTemplates.Get(settings.LayoutStyle);
    var primary = string.IsNullOrWhiteSpace(settings.PrimaryColor) ? template.PrimaryColor : settings.PrimaryColor;
    var secondary = string.IsNullOrWhiteSpace(settings.SecondaryColor) ? template.SecondaryColor : settings.SecondaryColor;
    var themeClass = "theme-" + template.Id;
    var layoutId = template.Id;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - @settings.StoreName</title>
    @if (ViewBag.MetaDescription != null)
    {
        <meta name="description" content="@ViewBag.MetaDescription" />
    }
    @if (ViewBag.PreviewTemplate != null)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <link href="~/Assets/vendor/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/Assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/Content/storefront.css" rel="stylesheet" />
    <link href="~/Content/storefront-themes.css" rel="stylesheet" />
    <link href="~/Content/storefront-product.css" rel="stylesheet" />
    <style>
        :root {
            --store-primary: @primary;
            --store-accent: @secondary;
            --store-price: @primary;
            --store-font: 'Far_Yekan', Tahoma, sans-serif;
        }
        body.store-body, body.store-body h1, body.store-body h2, body.store-body h3 {
            font-family: 'Far_Yekan', Tahoma, sans-serif !important;
        }
    </style>
</head>
<body class="store-body layout-woomen @themeClass layout-@layoutId" data-layout="@layoutId">

@* ========== TOP BAR (per layout) ========== *@
@if (layoutId == "organic" || layoutId == "marketplace")
{
    <div class="wm-topbar">
        <div class="container">
            <div>@(layoutId == "marketplace" ? "ارسال سریع گجت‌ها · گارانتی اصالت · پشتیبانی تخصصی" : "ارسال رایگان محصولات تازه برای سفارش‌های بالای ۵۰۰ هزار تومان")</div>
            <div>پشتیبانی: @(settings.Phone ?? "۰۲۱-۷۷۰۰۰۰۰۰")</div>
        </div>
    </div>
}
else if (layoutId == "fashion")
{
    <div class="wm-topbar fashion-topbar">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span><i class="bi bi-telephone"></i> @(settings.Phone ?? "۰۲۱-۷۷۰۰۰۰۰۰")</span>
            <span><i class="bi bi-envelope"></i> @(settings.Email ?? "info@shop.ir")</span>
            <span>به فروشگاه آنلاین ما خوش آمدید</span>
        </div>
    </div>
}

@* ========== HEADER ========== *@
@if (layoutId == "fashion")
{
    <header class="wm-header fashion-header">
        <div class="container">
            <div class="fashion-header-grid">
                <a class="wm-brand fashion-brand" href="@Url.Action("Index","Shop", new { company })">
                    @if (!string.IsNullOrEmpty(settings.LogoUrl))
                    {
                        <img src="@settings.LogoUrl" alt="@settings.StoreName" />
                    }
                    <strong>@settings.StoreName</strong>
                </a>
                <nav class="fashion-nav" style="border:0;margin:0;padding:0;justify-content:center;">
                    @foreach (var item in NikooSystem.Helpers.StoreMenuHelper.Roots(menus, "main").Take(4))
                    {
                        <a href="@item.Url">@item.Title</a>
                    }
                    <a href="@Url.Action("Catalog","Shop", new { company })">محصولات</a>
                </nav>
                <div class="fashion-side fashion-side-end">
                    <a class="wm-icon-link" href="tel:@(settings.Phone)" title="تماس"><i class="bi bi-telephone"></i></a>
                    <a class="wm-icon-link" href="@Url.Action("Orders","ShopAccount", new { company })" title="حساب"><i class="bi bi-person"></i></a>
                    <a class="wm-icon-link cart-link" href="@Url.Action("Cart","Shop", new { company })" title="سبد">
                        <i class="bi bi-cart3"></i>
                        @if (cartCount > 0) { <em>@cartCount</em> }
                    </a>
                </div>
            </div>
        </div>
    </header>
}
else if (layoutId == "minimal")
{
    <header class="wm-header minimal-header">
        <div class="container">
            <div class="minimal-header-row">
                <a class="wm-brand" href="@Url.Action("Index","Shop", new { company })">
                    @if (!string.IsNullOrEmpty(settings.LogoUrl))
                    {
                        <img src="@settings.LogoUrl" alt="@settings.StoreName" />
                    }
                    <strong>@settings.StoreName</strong>
                </a>
                <nav class="minimal-nav">
                    @foreach (var item in NikooSystem.Helpers.StoreMenuHelper.Roots(menus, "main").Take(5))
                    {
                        <a href="@item.Url">@item.Title</a>
                    }
                    <a href="@Url.Action("Catalog","Shop", new { company })">محصولات</a>
                </nav>
                <div class="minimal-actions">
                    <a href="@Url.Action("Orders","ShopAccount", new { company })"><i class="bi bi-person"></i></a>
                    <a href="@Url.Action("Cart","Shop", new { company })"><i class="bi bi-bag"></i> @cartCount</a>
                </div>
            </div>
        </div>
    </header>
}
else if (layoutId == "boutique")
{
    <header class="wm-header boutique-header">
        <div class="container text-center">
            <a class="wm-brand boutique-brand" href="@Url.Action("Index","Shop", new { company })">
                @if (!string.IsNullOrEmpty(settings.LogoUrl))
                {
                    <img src="@settings.LogoUrl" alt="@settings.StoreName" />
                }
                <span>
                    <strong>@settings.StoreName</strong>
                    <small>@settings.Tagline</small>
                </span>
            </a>
            <nav class="boutique-nav">
                @foreach (var item in NikooSystem.Helpers.StoreMenuHelper.Roots(menus, "main"))
                {
                    <a href="@item.Url">@item.Title</a>
                }
                <a href="@Url.Action("Catalog","Shop", new { company })">کاتالوگ</a>
                <a href="@Url.Action("Cart","Shop", new { company })">سبد (@cartCount)</a>
                <a href="@Url.Action("Orders","ShopAccount", new { company })">حساب</a>
            </nav>
            <form class="boutique-search" method="get" action="@Url.Action("Catalog","Shop", new { company })">
                <input type="search" name="q" placeholder="جستجو در بوتیک..." />
                <button type="submit"><i class="bi bi-search"></i></button>
            </form>
        </div>
    </header>
}
else if (layoutId == "marketplace")
{
    <header class="wm-header marketplace-header">
        <div class="container">
            <div class="marketplace-header-row">
                <a class="wm-brand" href="@Url.Action("Index","Shop", new { company })">
                    @if (!string.IsNullOrEmpty(settings.LogoUrl))
                    {
                        <img src="@settings.LogoUrl" alt="@settings.StoreName" />
                    }
                    <strong>@settings.StoreName</strong>
                </a>
                <form class="wm-search marketplace-search" method="get" action="@Url.Action("Catalog","Shop", new { company })">
                    <input type="search" name="q" placeholder="جستجو در هزاران محصول..." autocomplete="off" />
                    <button type="submit" aria-label="جستجو"><i class="bi bi-search"></i><span>جستجو</span></button>
                </form>
                <div class="marketplace-actions">
                    <a href="@Url.Action("Orders","ShopAccount", new { company })"><i class="bi bi-person"></i> حساب</a>
                    <a class="mp-cart" href="@Url.Action("Cart","Shop", new { company })"><i class="bi bi-cart3"></i> سبد <b>@cartCount</b></a>
                </div>
            </div>
        </div>
    </header>
    <nav class="wm-nav marketplace-nav">
        <div class="container">
            <div class="wm-nav-row">
                <a class="wm-cats-btn" href="@Url.Action("Catalog","Shop", new { company })"><i class="bi bi-grid"></i> دسته‌ها</a>
                <div class="wm-menu">
                    @foreach (var item in NikooSystem.Helpers.StoreMenuHelper.Roots(menus, "main"))
                    {
                        <a href="@item.Url">@item.Title</a>
                    }
                </div>
                <div class="wm-nav-right">
                    <a href="@Url.Action("Catalog","Shop", new { company, sort = "bestseller" })">پرفروش</a>
                    <a href="@Url.Action("Catalog","Shop", new { company, sort = "price_asc" })">ارزان‌ترین</a>
                    <a href="@Url.Action("Login","ShopAdmin", new { company })">مدیریت</a>
                </div>
            </div>
        </div>
    </nav>
}
else
{
    @* organic (default) *@
    <header class="wm-header">
        <div class="container">
            <div class="wm-header-row">
                <a class="wm-brand" href="@Url.Action("Index","Shop", new { company })">
                    @if (!string.IsNullOrEmpty(settings.LogoUrl))
                    {
                        <img src="@settings.LogoUrl" alt="@settings.StoreName" />
                    }
                    <span>
                        <strong>@settings.StoreName</strong>
                        <small>@settings.Tagline</small>
                    </span>
                </a>
                <form class="wm-search" method="get" action="@Url.Action("Catalog","Shop", new { company })">
                    <input type="search" name="q" placeholder="جستجوی محصول..." />
                    <button type="submit" aria-label="جستجو"><i class="bi bi-search"></i></button>
                </form>
                <div class="wm-actions">
                    <a class="wm-action" href="tel:@(settings.Phone)">
                        <i class="bi bi-telephone"></i>
                        <span><span>تماس</span><strong>@(settings.Phone ?? "—")</strong></span>
                    </a>
                    <a class="wm-action" href="@Url.Action("Orders","ShopAccount", new { company })">
                        <i class="bi bi-person"></i>
                        <span><span>حساب کاربری</span><strong>ورود / ثبت‌نام</strong></span>
                    </a>
                    <a class="wm-action" href="@Url.Action("Cart","Shop", new { company })">
                        <i class="bi bi-bag"></i>
                        <span><span>سبد خرید (@cartCount)</span><strong>مشاهده سبد</strong></span>
                    </a>
                </div>
            </div>
        </div>
    </header>
    <nav class="wm-nav">
        <div class="container">
            <div class="wm-nav-row">
                <a class="wm-cats-btn" href="@Url.Action("Catalog","Shop", new { company })">
                    <i class="bi bi-list"></i> همه دسته‌بندی‌ها
                </a>
                <div class="wm-menu">
                    @foreach (var item in NikooSystem.Helpers.StoreMenuHelper.Roots(menus, "main"))
                    {
                        var children = NikooSystem.Helpers.StoreMenuHelper.Children(menus, item.Id).ToList();
                        if (children.Any())
                        {
                            <div class="wm-drop">
                                <a href="@item.Url">@item.Title <i class="bi bi-chevron-down"></i></a>
                                <div class="wm-drop-menu">
                                    @foreach (var c in children)
                                    {
                                        <a href="@c.Url">@c.Title</a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <a href="@item.Url">@item.Title</a>
                        }
                    }
                </div>
                <div class="wm-nav-right">
                    <a href="@Url.Action("Catalog","Shop", new { company, sort = "bestseller" })"><i class="bi bi-lightning-charge-fill"></i> پیشنهاد ویژه</a>
                    <a href="@Url.Action("Catalog","Shop", new { company, sort = "price_asc" })"><i class="bi bi-percent"></i> تخفیف هفته</a>
                    <a href="@Url.Action("Login","ShopAdmin", new { company })">مدیریت</a>
                </div>
            </div>
        </div>
    </nav>
}

@if (TempData["Ok"] != null)
{
    <div class="container mt-3"><div class="alert alert-success">@TempData["Ok"]</div></div>
}
@if (TempData["Error"] != null)
{
    <div class="container mt-3"><div class="alert alert-danger">@TempData["Error"]</div></div>
}

@RenderBody()

@* Features strip — organic & marketplace only before footer; fashion after; minimal/boutique different *@
@if (layoutId == "organic")
{
    <div class="container">
        <div class="wm-features">
            <div class="wm-feature"><i class="bi bi-truck"></i><div><strong>ارسال سریع</strong><span>تحویل تازه تا درب منزل</span></div></div>
            <div class="wm-feature"><i class="bi bi-leaf"></i><div><strong>۱۰۰٪ طبیعی</strong><span>محصولات ارگانیک منتخب</span></div></div>
            <div class="wm-feature"><i class="bi bi-shield-check"></i><div><strong>ضمانت کیفیت</strong><span>۷ روز بازگشت آسان</span></div></div>
            <div class="wm-feature"><i class="bi bi-headset"></i><div><strong>پشتیبانی</strong><span>شنبه تا پنجشنبه ۹ تا ۲۱</span></div></div>
        </div>
    </div>
}
else if (layoutId == "marketplace")
{
    <div class="mp-features-bar">
        <div class="container">
            <div class="mp-features">
                <span><i class="bi bi-truck"></i> ارسال سریع</span>
                <span><i class="bi bi-shield-check"></i> ضمانت اصالت</span>
                <span><i class="bi bi-credit-card"></i> پرداخت امن</span>
                <span><i class="bi bi-arrow-repeat"></i> مرجوعی آسان</span>
                <span><i class="bi bi-headset"></i> پشتیبانی ۲۴/۷</span>
            </div>
        </div>
    </div>
}
else if (layoutId == "fashion")
{
    <div class="fashion-promo-strip">
        <div class="container">ارسال سریع · کیفیت تضمینی · پشتیبانی واقعی</div>
    </div>
}

<footer class="wm-footer store-footer footer-@layoutId">
    <div class="container py-5">
        @if (layoutId == "minimal")
        {
            <div class="minimal-footer text-center">
                <h4>@settings.StoreName</h4>
                <p class="opacity-75 mx-auto" style="max-width:520px">@settings.About</p>
                <div class="minimal-footer-links">
                    @foreach (var item in NikooSystem.Helpers.StoreMenuHelper.Roots(menus, "footer"))
                    {
                        <a href="@item.Url">@item.Title</a>
                    }
                    <a href="@Url.Action("Catalog","Shop", new { company })">محصولات</a>
                    <a href="@Url.Action("Gallery","Shop", new { company })">گالری</a>
                </div>
                <div class="small opacity-75 mt-3">@settings.Phone · @settings.Email</div>
                @if (!string.IsNullOrWhiteSpace(settings.EnamadHtml))
                {
                    <div class="wm-enamad mt-3 d-inline-block">@Html.Raw(settings.EnamadHtml)</div>
                }
                <div class="pt-3 mt-3 small opacity-50">@(settings.FooterText)</div>
            </div>
        }
        else if (layoutId == "boutique")
        {
            <div class="row g-4 align-items-start">
                <div class="col-md-6">
                    <h4>@settings.StoreName</h4>
                    <p class="opacity-75">@settings.About</p>
                    <div>@settings.Address</div>
                </div>
                <div class="col-md-3">
                    <h5>کاوش</h5>
                    @foreach (var item in NikooSystem.Helpers.StoreMenuHelper.Roots(menus, "footer"))
                    {
                        <div><a href="@item.Url">@item.Title</a></div>
                    }
                </div>
                <div class="col-md-3">
                    <h5>ارتباط</h5>
                    <div>@settings.Phone</div>
                    <div>@settings.Email</div>
                    @if (!string.IsNullOrWhiteSpace(settings.EnamadHtml))
                    {
                        <div class="wm-enamad mt-2">@Html.Raw(settings.EnamadHtml)</div>
                    }
                </div>
            </div>
            <div class="pt-4 mt-4 border-top small opacity-75 text-center">@(settings.FooterText)</div>
        }
        else
        {
            <div class="row g-4">
                <div class="@(layoutId == "marketplace" ? "col-md-3" : "col-md-4")">
                    <h4>@settings.StoreName</h4>
                    <p class="opacity-75">@settings.About</p>
                    @{
                        var socials = new[]
                        {
                            new { Url = settings.InstagramUrl, Icon = "bi-instagram", Title = "اینستاگرام" },
                            new { Url = settings.TelegramUrl, Icon = "bi-telegram", Title = "تلگرام" },
                            new { Url = settings.WhatsAppUrl, Icon = "bi-whatsapp", Title = "واتساپ" },
                            new { Url = settings.LinkedInUrl, Icon = "bi-linkedin", Title = "لینکدین" },
                            new { Url = settings.TwitterUrl, Icon = "bi-twitter", Title = "توییتر" },
                            new { Url = settings.FacebookUrl, Icon = "bi-facebook", Title = "فیسبوک" },
                            new { Url = settings.AparatUrl, Icon = "bi-play-btn", Title = "آپارات" },
                            new { Url = settings.YouTubeUrl, Icon = "bi-youtube", Title = "یوتیوب" }
                        }.Where(s => !string.IsNullOrWhiteSpace(s.Url)).ToList();
                    }
                    @if (socials.Any())
                    {
                        <div class="wm-socials mt-3">
                            @foreach (var s in socials)
                            {
                                <a href="@s.Url" target="_blank" rel="noopener noreferrer" title="@s.Title"><i class="bi @s.Icon"></i></a>
                            }
                        </div>
                    }
                </div>
                <div class="col-md-3">
                    <h5>لینک‌ها</h5>
                    @foreach (var item in NikooSystem.Helpers.StoreMenuHelper.Roots(menus, "footer"))
                    {
                        <div><a href="@item.Url">@item.Title</a></div>
                    }
                    <div><a href="@Url.Action("Catalog","Shop", new { company })">محصولات</a></div>
                    <div><a href="@Url.Action("Gallery","Shop", new { company })">گالری</a></div>
                </div>
                <div class="col-md-3">
                    <h5>تماس با ما</h5>
                    <div>@settings.Phone</div>
                    <div>@settings.Email</div>
                    <div>@settings.Address</div>
                </div>
                <div class="@(layoutId == "marketplace" ? "col-md-3" : "col-md-2")">
                    <h5>نماد اعتماد</h5>
                    @if (!string.IsNullOrWhiteSpace(settings.EnamadHtml))
                    {
                        <div class="wm-enamad">@Html.Raw(settings.EnamadHtml)</div>
                    }
                    else
                    {
                        <div class="small opacity-50">هنوز تنظیم نشده</div>
                    }
                </div>
            </div>
            <div class="pt-4 mt-4 border-top border-success border-opacity-25 small opacity-75">@(settings.FooterText)</div>
        }
    </div>
</footer>
<script src="~/Assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
@if (ViewBag.PreviewTemplate != null)
{
    <script>
    (function () {
      var id = '@ViewBag.PreviewTemplate';
      document.querySelectorAll('a[href]').forEach(function (a) {
        if (a.origin !== location.origin) return;
        var url = new URL(a.href);
        url.searchParams.set('previewTemplate', id);
        a.href = url.toString();
      });
    })();
    </script>
}
@RenderSection("scripts", required: false)
</body>
</html>
