@model StoreProduct
@{
    var company = (string)ViewBag.CompanyCode;
    var p = Model;
    var images = (p.Images ?? new List<StoreProductImage>()).OrderBy(i => i.SortOrder).ToList();
    var img = images.FirstOrDefault();
    var hoverImg = images.Skip(1).FirstOrDefault();
    var rating = StoreRatings.For(company).Of(p.Id);
    var onSale = p.IsOnSale();
    var digital = p.IsDigital();
    var outOfStock = !digital && p.Stock <= 0;
    var url = Url.Action("Product", "Shop", new { company, slug = p.Slug });
}
<article class="wm-product @(outOfStock ? "is-out" : "") @(digital ? "is-digital" : "")">
    @if (onSale && !outOfStock)
    {
        <span class="wm-badge">٪@p.DiscountPercent() تخفیف</span>
    }
    @if (outOfStock)
    {
        <span class="wm-badge wm-badge-out">ناموجود</span>
    }
    <a class="thumb @(hoverImg != null ? "has-alt" : "")" href="@url">
        <img src="@(img?.ThumbUrl ?? img?.LargeUrl ?? "/Assets/img/portfolio/portfolio-1.jpg")" alt="@p.Title" loading="lazy" />
        @if (hoverImg != null)
        {
            <img class="alt" src="@(hoverImg.ThumbUrl ?? hoverImg.LargeUrl)" alt="" loading="lazy" aria-hidden="true" />
        }
        @if (digital)
        {
            <span class="wm-type"><i class="bi @p.ProductType.TypeIcon()"></i> @p.ProductType.TypeText()</span>
        }
    </a>
    <div class="body">
        <h3><a href="@url">@p.Title</a></h3>
        @if (digital && !string.IsNullOrWhiteSpace(p.Author))
        {
            <div class="wm-meta"><i class="bi bi-person"></i> @p.Author</div>
        }
        else if (!string.IsNullOrWhiteSpace(p.ShortDescription))
        {
            <div class="wm-meta">@p.ShortDescription</div>
        }
        @if (rating.Count > 0)
        {
            <div class="wm-rating"><i class="bi bi-star-fill"></i> @rating.Average.ToString("0.0") <span class="wm-rating-count">(@rating.Count)</span></div>
        }
        <div class="wm-price">
            @if (onSale)
            {
                <del>@p.CompareAtPrice.Value.ToToman()</del>
            }
            @(p.Price == 0 ? "رایگان" : p.Price.ToToman())
        </div>
        @if (outOfStock)
        {
            <a class="btn-wm-cart is-disabled mt-2" href="@url"><i class="bi bi-bell"></i> <span>ناموجود</span></a>
        }
        else
        {
            using (Html.BeginForm("AddToCart", "Shop", new { company }, FormMethod.Post, new { @class = "mt-2 product-cart-form" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@p.Id" />
                <input type="hidden" name="quantity" value="1" />
                <button class="btn-wm-cart" type="submit"><i class="bi @(digital ? "bi-cart-plus" : "bi-bag")"></i> <span>@(digital ? "خرید" : "افزودن به سبد")</span></button>
            }
        }
    </div>
</article>
