@{
    Layout = null;
    var product = (NikooSystem.Models.Product)ViewBag.Product;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>دمو سوپرمارکت آنلاین - @product.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Far_Yekan', Tahoma, sans-serif; background: #f3faf4; }
        .demo-banner { background: #146c43; color: #fff; padding: .7rem 1rem; position: sticky; top: 0; z-index: 50; }
        .cat { background: #fff; border-radius: 50px; padding: .4rem 1rem; margin: .25rem; display: inline-block; border: 1px solid #cfe8d5; }
        .item-card { background: #fff; border-radius: 12px; padding: 1rem; height: 100%; box-shadow: 0 4px 14px rgba(20,108,67,.08); }
        .item-card img { height: 140px; object-fit: cover; width: 100%; border-radius: 8px; }
        .price { color: #146c43; font-weight: 700; }
    </style>
</head>
<body>
    <div class="demo-banner d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>دمو <strong>فروشگاه مواد غذایی</strong> — @product.Title</span>
        <div>
            <a class="btn btn-sm btn-light" href="@Url.Action("Details","Products", new { id = product.Id })">جزئیات</a>
            <a class="btn btn-sm btn-warning" href="@Url.Action("Buy","Checkout", new { productId = product.Id })">درخواست دمو</a>
        </div>
    </div>
    <div class="container py-4">
        <h2 class="mb-3">فروشگاه تازه</h2>
        <div class="mb-4">
            <span class="cat">لبنیات</span><span class="cat">نان و غلات</span><span class="cat">میوه</span><span class="cat">نوشیدنی</span>
        </div>
        <div class="row g-3">
            @{
                var items = new[] {
                    new { t = "شیر کم‌چرب ۱ لیتری", p = "۴۵٬۰۰۰", img = "/Assets/img/portfolio/portfolio-2.jpg" },
                    new { t = "نان سنگک تازه", p = "۱۸٬۰۰۰", img = "/Assets/img/portfolio/portfolio-3.jpg" },
                    new { t = "سیب قرمز کیلویی", p = "۶۵٬۰۰۰", img = "/Assets/img/portfolio/portfolio-4.jpg" },
                    new { t = "آبمیوه طبیعی", p = "۸۵٬۰۰۰", img = "/Assets/img/portfolio/portfolio-5.jpg" }
                };
            }
            @foreach (var item in items)
            {
                <div class="col-md-3 col-6">
                    <div class="item-card">
                        <img src="@item.img" alt="@item.t">
                        <h6 class="mt-2">@item.t</h6>
                        <div class="price">@item.p تومان</div>
                        <button class="btn btn-sm btn-success mt-2 w-100" type="button">سفارش (دمو)</button>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-5">
            <a class="btn btn-lg btn-success" href="@Url.Action("Buy","Checkout", new { productId = product.Id })">درخواست دمو این فروشگاه</a>
        </div>
    </div>
</body>
</html>
