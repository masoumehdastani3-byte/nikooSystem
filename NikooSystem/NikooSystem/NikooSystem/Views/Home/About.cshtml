@{
    ViewBag.Title = "درباره ما";
    ViewBag.Nav = "about";
    var site = NikooSystem.Services.SiteContentStore.Settings;
}
<main id="main" class="lf-about-page">
    <section class="lf-about-hero">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-5">
                    <div class="lf-about-photo lf-anim-float">
                        <span class="lf-about-photo-glow" aria-hidden="true"></span>
                        <img src="~/Assets/img/about-masoumeh.png" alt="معصومه داستانی — مهندس نرم‌افزار" />
                    </div>
                </div>
                <div class="col-lg-7 lf-anim-rise">
                    <p class="lf-eyebrow">درباره ما</p>
                    <h1>معصومه داستانی</h1>
                    <p class="lf-about-role">مهندس نرم‌افزار | ۲۰ سال تجربه در پروژه‌های بزرگ ملی و خصوصی</p>
                    <p>
                        من معصومه داستانی هستم، مهندس نرم‌افزار با نزدیک به دو دهه تجربه کار در شرکت‌ها و پروژه‌های بزرگ.
                        در این سال‌ها روی سیستم‌هایی کار کرده‌ام که حجم داده بالا، حساسیت زیاد و نیاز به پایداری و امنیت جدی داشته‌اند.
                        حالا با تجربه‌ای که اندوخته‌ام، کسب‌وکار شخصی خودم را راه‌اندازی کرده‌ام تا سایت‌های فروشگاهی، آموزشی و شرکتی آماده را
                        به صورت آنلاین به شما ارائه بدهم.
                    </p>
                    <p class="lf-about-goal">
                        هدف من ساده است: <strong>شما کسب‌وکارتان را بچرخانید، من زیرساخت دیجیتال‌تان را حرفه‌ای و بدون دردسر آماده می‌کنم.</strong>
                    </p>
                    <div class="lf-about-cta">
                        <a class="lf-btn lf-btn-warm" href="@Url.Action("Contact","Home")"><i class="bi bi-chat-dots"></i> مشاوره رایگان</a>
                        <a class="lf-btn lf-btn-primary" href="@Url.Action("Index","Products", new { category = "فروشگاه آنلاین" })"><i class="bi bi-shop"></i> مشاهده محصولات</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="lf-about-section">
        <div class="container">
            <header class="lf-section-head lf-anim-in">
                <h2>خدمات</h2>
                <p>چه کاری برای شما انجام می‌دهم؟</p>
            </header>
            <div class="lf-about-grid lf-anim-stagger">
                <article>
                    <i class="bi bi-cart3"></i>
                    <h3>فروشگاه اینترنتی آماده</h3>
                    <p>سایت فروشگاهی با طراحی مدرن، درگاه پرداخت، مدیریت محصولات و سفارش‌ها</p>
                </article>
                <article>
                    <i class="bi bi-easel"></i>
                    <h3>سایت آموزشی آماده</h3>
                    <p>پلتفرم برای فروش دوره، ثبت‌نام دانشجو، پخش ویدیو و مدیریت محتوا</p>
                </article>
                <article>
                    <i class="bi bi-building"></i>
                    <h3>سایت شرکتی آماده</h3>
                    <p>معرفی شرکت، خدمات، نمونه‌کارها، فرم تماس و پنل مدیریت</p>
                </article>
                <article>
                    <i class="bi bi-lightning-charge"></i>
                    <h3>راه‌اندازی سریع</h3>
                    <p>بدون نیاز به ماه‌ها انتظار؛ سایت شما در کوتاه‌ترین زمان آماده تحویل است</p>
                </article>
                <article>
                    <i class="bi bi-headset"></i>
                    <h3>پشتیبانی و آموزش</h3>
                    <p>بعد از تحویل هم کنارتان هستم تا خودتان بتوانید مدیریت کنید</p>
                </article>
            </div>
        </div>
    </section>

    <section class="lf-about-section lf-about-section-alt">
        <div class="container">
            <header class="lf-section-head">
                <h2>اعتماد</h2>
                <p>چرا به من اعتماد کنید؟</p>
            </header>
            <ul class="lf-about-trust">
                <li><i class="bi bi-award"></i><div><strong>۲۰ سال تجربه واقعی</strong><span>کار در پروژه‌های بزرگ ملی و خصوصی با داده‌های حجیم و حساس</span></div></li>
                <li><i class="bi bi-cpu"></i><div><strong>تخصص فنی بالا</strong><span>تسلط بر معماری نرم‌افزار، امنیت، پایگاه داده و مقیاس‌پذیری</span></div></li>
                <li><i class="bi bi-briefcase"></i><div><strong>تجربه صنعتی متنوع</strong><span>همکاری با شرکت‌ها و تیم‌های مختلف در سطوح ملی و خصوصی</span></div></li>
                <li><i class="bi bi-graph-up-arrow"></i><div><strong>تمرکز بر کسب‌وکار شما</strong><span>فقط کد نمی‌نویسم؛ دنبال این هستم که سایت‌تان فروش و اعتبار بیاورد</span></div></li>
                <li><i class="bi bi-chat-square-text"></i><div><strong>شفافیت و سادگی</strong><span>حرف فنی پیچیده نمی‌زنم؛ با زبان ساده توضیح می‌دهم چه چیزی می‌گیرید</span></div></li>
            </ul>
        </div>
    </section>

    <section class="lf-about-section">
        <div class="container">
            <header class="lf-section-head">
                <h2>توانمندی‌ها</h2>
                <p>نمونه‌ای از توانمندی‌ها</p>
            </header>
            <ul class="lf-about-skills">
                <li>طراحی و پیاده‌سازی سیستم‌های نرم‌افزاری بزرگ‌مقیاس</li>
                <li>کار با پایگاه داده‌های حجیم و بهینه‌سازی عملکرد</li>
                <li>پیاده‌سازی لایه‌های امنیتی و کنترل دسترسی</li>
                <li>توسعه سامانه‌های تحت وب برای سازمان‌ها و کسب‌وکارها</li>
                <li>مدیریت پروژه و همکاری با تیم‌های چندتخصصی</li>
            </ul>
        </div>
    </section>

    <section class="lf-about-section lf-about-section-alt">
        <div class="container">
            <header class="lf-section-head">
                <h2>راه‌حل‌ها</h2>
                <p>خدمات من به زبان ساده</p>
            </header>
            <div class="table-responsive">
                <table class="lf-about-table">
                    <thead>
                        <tr>
                            <th>نیاز شما</th>
                            <th>راه‌حل من</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>می‌خواهم آنلاین بفروشم</td>
                            <td>فروشگاه اینترنتی آماده با درگاه پرداخت</td>
                        </tr>
                        <tr>
                            <td>می‌خواهم دوره بفروشم</td>
                            <td>سایت آموزشی با پنل مدیریت دوره</td>
                        </tr>
                        <tr>
                            <td>می‌خواهم شرکت را آنلاین معرفی کنم</td>
                            <td>سایت شرکتی حرفه‌ای و سریع</td>
                        </tr>
                        <tr>
                            <td>نمی‌خواهم درگیر مسائل فنی شوم</td>
                            <td>تحویل کامل + آموزش + پشتیبانی</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="lf-about-cta-band">
        <div class="container">
            <h2>آماده همکاری با شما هستم</h2>
            <p>
                اگر به دنبال یک سایت حرفه‌ای، امن و آماده برای کسب‌وکارتان هستید، با من تماس بگیرید.
                با تجربه ۲۰ ساله‌ام در کنار شما هستم تا حضور آنلاین‌تان را قدرتمند شروع کنید.
            </p>
            <div class="lf-about-contacts">
                @if (!string.IsNullOrWhiteSpace(site.Phone))
                {
                    <a href="tel:@site.Phone.Replace("-", "").Replace(" ", "")"><i class="bi bi-telephone"></i> <span dir="ltr">@site.Phone</span></a>
                }
                @if (!string.IsNullOrWhiteSpace(site.Email))
                {
                    <a href="mailto:@site.Email"><i class="bi bi-envelope"></i> @site.Email</a>
                }
                <a href="@Url.Action("Contact","Home")"><i class="bi bi-send"></i> فرم تماس با ما</a>
            </div>
            <a class="lf-btn lf-btn-warm" href="@Url.Action("Contact","Home")"><i class="bi bi-chat-dots"></i> درخواست مشاوره رایگان</a>
        </div>
    </section>
</main>
