@model List<NikooSystem.Models.Product>
@using NikooSystem.Helpers
@{
    ViewBag.Title = "خانه";
    ViewBag.Nav = "home";
    var storeDemos = Model.Where(p => !string.IsNullOrEmpty(p.DemoSlug)).Take(4).ToList();
}

<section class="lf-hero">
    <div class="lf-hero-wave" aria-hidden="true"></div>
    <div class="container">
        <div class="row align-items-center g-4 lf-hero-row">
            <div class="col-lg-6 lf-hero-copy">
                <p class="lf-eyebrow">نیکو سیستم آفرین</p>
                <h1>فروشگاه‌های آنلاین آماده برای کسب‌وکار شما</h1>
                <p class="lf-hero-lead">
                    دمو را ببینید، سفارش دهید و آنلاین پرداخت کنید.
                    راه‌اندازی سریع، پشتیبانی واقعی و فروشگاه آمادهٔ فروش.
                </p>
                <div class="lf-hero-cta">
                    <a class="lf-btn lf-btn-warm" href="#stores">
                        <i class="bi bi-cart3"></i> مشاهده فروشگاه‌های آماده
                    </a>
                    <a class="lf-btn lf-btn-ghost" href="#steps">
                        <i class="bi bi-list-check"></i> از دمو تا پرداخت
                    </a>
                </div>
            </div>
            <div class="col-lg-6 lf-hero-visual">
                <div class="lf-hero-devices">
                    <img src="~/Assets/img/hero-img.png" alt="تیم توسعه و فروشگاه آنلاین نیکو سیستم آفرین" />
                    <span class="lf-float lf-float-a"><i class="bi bi-bag-check"></i> آماده برای فروش</span>
                    <span class="lf-float lf-float-b"><i class="bi bi-shield-check"></i> پشتیبانی و آموزش</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="lf-trust">
    <div class="container">
        <div class="lf-trust-grid">
            <div class="lf-trust-item">
                <i class="bi bi-lightning-charge"></i>
                <div>
                    <strong>راه‌اندازی سریع</strong>
                    <span>از دمو تا فروش در کوتاه‌ترین زمان</span>
                </div>
            </div>
            <div class="lf-trust-item">
                <i class="bi bi-shield-check"></i>
                <div>
                    <strong>کیفیت بالا</strong>
                    <span>فروشگاه واقعی با پنل مدیریت کامل</span>
                </div>
            </div>
            <div class="lf-trust-item">
                <i class="bi bi-tag"></i>
                <div>
                    <strong>قیمت منصفانه</strong>
                    <span>هزینه شفاف بدون پیچیدگی اضافه</span>
                </div>
            </div>
            <div class="lf-trust-item">
                <i class="bi bi-headset"></i>
                <div>
                    <strong>پشتیبانی تخصصی</strong>
                    <span>همراهی از خرید تا راه‌اندازی</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="stores" class="lf-stores">
    <div class="container">
        <div class="lf-stores-head">
            <div>
                <h2><i class="bi bi-shop-window"></i> فروشگاه‌های آنلاین آماده</h2>
                <p>دموهای واقعی را ببینید و همان تجربه را برای کسب‌وکار خود سفارش دهید.</p>
            </div>
            <a class="lf-btn lf-btn-primary" href="@Url.Action("Index","Products", new { category = "فروشگاه آنلاین" })">
                مشاهده همه دموها <i class="bi bi-arrow-left"></i>
            </a>
        </div>
        <div class="lf-store-grid">
            @foreach (var p in storeDemos)
            {
                <article class="lf-store-card">
                    <div class="lf-store-thumb">
                        @if (p.IsFeatured)
                        {
                            <span class="lf-badge lf-badge-warm">پیشنهادی</span>
                        }
                        <img src="@p.ImageUrl" alt="@p.Title" />
                    </div>
                    <div class="lf-store-body">
                        <h3>@p.Title</h3>
                        <p>@p.ShortDescription</p>
                        <div class="lf-store-foot">
                            <span class="lf-price">@p.Price.ToToman()</span>
                            <a class="lf-link-demo" href="@Url.Action("Index","Demo", new { slug = p.DemoSlug })">
                                مشاهده دمو <i class="bi bi-arrow-left"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="lf-why">
    <div class="container">
        <div class="row align-items-stretch g-4 lf-why-row">
            <div class="col-lg-6 d-flex flex-column">
                <h2>چرا نیکو سیستم آفرین؟</h2>
                <p class="lf-why-lead">تمرکز ما روی فروشگاه آماده، تجربه واقعی خرید و مسیر شفاف از دمو تا پرداخت است.</p>
                <ul class="lf-why-list">
                    <li><i class="bi bi-people"></i><span><strong>مشتریان وفادار</strong> راه‌حل پایدار برای رشد فروش آنلاین</span></li>
                    <li><i class="bi bi-cash-coin"></i><span><strong>قیمت منصفانه</strong> بدون هزینه پنهان و پیچیدگی اضافه</span></li>
                    <li><i class="bi bi-headset"></i><span><strong>پشتیبانی دائمی</strong> از راه‌اندازی تا استفاده روزمره</span></li>
                    <li><i class="bi bi-award"></i><span><strong>تجربه و تخصص</strong> فروشگاه واقعی با پنل مدیریت کامل</span></li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="lf-why-media">
                    <img src="~/Assets/img/why-nikoo.png" alt="چرا نیکو سیستم آفرین" />
                </div>
            </div>
        </div>
    </div>
</section>

<section id="steps" class="lf-steps">
    <div class="container">
        <header class="lf-section-head">
            <h2>فرآیند خرید</h2>
            <p>از دمو تا پرداخت در چند قدم</p>
        </header>
        <div class="row align-items-center g-4">
            <div class="col-lg-5">
                <img class="lf-steps-img" src="~/Assets/img/features.png" alt="فرآیند خرید" />
            </div>
            <div class="col-lg-7">
                <div class="lf-steps-grid">
                    <div class="lf-step"><span>۱</span><div><strong>انتخاب محصول</strong><em>فروشگاه مناسب کسب‌وکار خود را انتخاب کنید</em></div></div>
                    <div class="lf-step"><span>۲</span><div><strong>مشاهده دمو</strong><em>نمونه واقعی فروشگاه را آنلاین ببینید</em></div></div>
                    <div class="lf-step"><span>۳</span><div><strong>ثبت اطلاعات</strong><em>مشخصات سفارش را وارد کنید</em></div></div>
                    <div class="lf-step"><span>۴</span><div><strong>پرداخت آنلاین</strong><em>پرداخت امن و ثبت سفارش</em></div></div>
                    <div class="lf-step"><span>۵</span><div><strong>تأیید سفارش</strong><em>وضعیت سفارش را پیگیری کنید</em></div></div>
                    <div class="lf-step"><span>۶</span><div><strong>تحویل و پشتیبانی</strong><em>راه‌اندازی و همراهی پس از فروش</em></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="lf-stats">
    <div class="container">
        <div class="lf-stats-wrap">
            <div class="lf-stats-grid">
                <div class="lf-stat">
                    <i class="bi bi-emoji-smile"></i>
                    <strong><span data-purecounter-start="0" data-purecounter-end="98" data-purecounter-duration="1" class="purecounter"></span>%</strong>
                    <span>رضایت مشتریان</span>
                </div>
                <div class="lf-stat">
                    <i class="bi bi-shop"></i>
                    <strong>+<span data-purecounter-start="0" data-purecounter-end="100" data-purecounter-duration="1" class="purecounter"></span></strong>
                    <span>دموی فروشگاه</span>
                </div>
                <div class="lf-stat">
                    <i class="bi bi-people"></i>
                    <strong>+<span data-purecounter-start="0" data-purecounter-end="500" data-purecounter-duration="1" class="purecounter"></span></strong>
                    <span>مشتری راضی</span>
                </div>
                <div class="lf-stat">
                    <i class="bi bi-headset"></i>
                    <strong>+<span data-purecounter-start="0" data-purecounter-end="1500" data-purecounter-duration="1" class="purecounter"></span></strong>
                    <span>ساعت پشتیبانی</span>
                </div>
            </div>
            <aside class="lf-stats-cta">
                <h3>آماده شروع هستید؟</h3>
                <p>دمو را ببینید و در چند قدم سفارش خود را ثبت کنید.</p>
                <a class="lf-btn lf-btn-warm" href="@Url.Action("Index","Products", new { category = "فروشگاه آنلاین" })">
                    شروع خرید <i class="bi bi-arrow-left"></i>
                </a>
            </aside>
        </div>
    </div>
</section>
