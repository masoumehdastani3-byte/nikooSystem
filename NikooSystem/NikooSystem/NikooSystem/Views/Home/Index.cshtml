@model List<NikooSystem.Models.Product>
@{
    ViewBag.Title = "خانه";
    ViewBag.Nav = "home";
    var storeDemos = Model.Where(p => !string.IsNullOrEmpty(p.DemoSlug)).Take(6).ToList();
    var site = NikooSystem.Services.SiteContentStore.Settings;
    var trialDays = NikooSystem.Services.TenantProvisioningService.TrialDays;
    var faqs = (ViewBag.Faqs as List<NikooSystem.Models.SiteFaq>) ?? new List<NikooSystem.Models.SiteFaq>();
    var testimonials = (ViewBag.Testimonials as List<NikooSystem.Models.SiteTestimonial>) ?? new List<NikooSystem.Models.SiteTestimonial>();
    var posts = (ViewBag.Posts as List<NikooSystem.Models.SitePost>) ?? new List<NikooSystem.Models.SitePost>();
}

<section class="lf-hero">
    <div class="lf-hero-wave" aria-hidden="true"></div>
    <div class="container">
        <div class="row align-items-center g-4 lf-hero-row">
            <div class="col-lg-6 lf-hero-copy">
                @if (!string.IsNullOrWhiteSpace(site.HeroEyebrow))
                {
                    <p class="lf-eyebrow">@site.HeroEyebrow</p>
                }
                <h1>@site.HeroTitle</h1>
                @if (!string.IsNullOrWhiteSpace(site.HeroLead))
                {
                    <p class="lf-hero-lead">@site.HeroLead.Replace("{TrialDays}", trialDays.ToString())</p>
                }
                <div class="lf-hero-cta">
                    <a class="lf-btn lf-btn-warm" href="@Url.Action("Index","Signup")">
                        <i class="bi bi-rocket-takeoff"></i> ساخت فروشگاه رایگان
                    </a>
                    <a class="lf-btn lf-btn-ghost" href="#stores">
                        <i class="bi bi-eye"></i> دیدن فروشگاه‌های نمونه
                    </a>
                </div>
            </div>
            <div class="col-lg-6 lf-hero-visual">
                <div class="lf-hero-devices">
                    <img src="~/Assets/img/hero-img.jpg" alt="تیم توسعه و فروشگاه آنلاین نیکو سیستم آفرین" fetchpriority="high" />
                    <span class="lf-float lf-float-a"><i class="bi bi-bag-check"></i> آماده برای فروش</span>
                    <span class="lf-float lf-float-b"><i class="bi bi-shield-check"></i> پشتیبانی و آموزش</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="lf-trust">
    <div class="container">
        <div class="lf-trust-grid">
            <div class="lf-trust-item">
                <i class="bi bi-lightning-charge"></i>
                <div>
                    <strong>راه‌اندازی سریع</strong>
                    <span>از دمو تا فروش در کوتاه‌ترین زمان</span>
                </div>
            </div>
            <div class="lf-trust-item">
                <i class="bi bi-shield-check"></i>
                <div>
                    <strong>کیفیت بالا</strong>
                    <span>فروشگاه واقعی با پنل مدیریت کامل</span>
                </div>
            </div>
            <div class="lf-trust-item">
                <i class="bi bi-tag"></i>
                <div>
                    <strong>قیمت منصفانه</strong>
                    <span>هزینه شفاف بدون پیچیدگی اضافه</span>
                </div>
            </div>
            <div class="lf-trust-item">
                <i class="bi bi-headset"></i>
                <div>
                    <strong>پشتیبانی تخصصی</strong>
                    <span>همراهی از خرید تا راه‌اندازی</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="solutions" class="lf-land-section lf-home-solutions">
    <div class="container">
        <header class="lf-section-head">
            <h2>راهکارهای @site.SiteName</h2>
            <p>برای هر کسب‌وکار، سایت مخصوص خودش</p>
        </header>
        @Html.Partial("_SolutionLinks", ProductLandings.All)
    </div>
</section>

<section id="stores" class="lf-stores">
    <div class="container">
        <div class="lf-stores-head">
            <div>
                <h2><i class="bi bi-shop-window"></i> @site.StoresTitle</h2>
                <p>@site.StoresSubtitle</p>
            </div>
            <a class="lf-btn lf-btn-primary" href="@Url.Action("Index","Products")">
                مشاهده همه دموها <i class="bi bi-arrow-left"></i>
            </a>
        </div>
        <div class="lf-store-grid">
            @foreach (var p in storeDemos)
            {
                <article class="lf-store-card">
                    <div class="lf-store-thumb">
                        @if (p.IsFeatured)
                        {
                            <span class="lf-badge lf-badge-warm">پیشنهادی</span>
                        }
                        <img src="@p.ImageUrl" alt="@p.Title" loading="lazy" decoding="async" />
                    </div>
                    <div class="lf-store-body">
                        <h3>@p.Title</h3>
                        <p>@p.ShortDescription</p>
                        <div class="lf-store-foot">
                            <span class="lf-price">@p.Price.ToToman()@if (!string.IsNullOrEmpty(p.DemoSlug)) {<small class="text-muted fw-normal"> / سه ماه</small>}</span>
                            <a class="lf-link-demo" href="@Url.Action("Index","Demo", new { slug = p.DemoSlug })">
                                مشاهده دمو <i class="bi bi-arrow-left"></i>
                            </a>
                        </div>
                        <a class="lf-btn lf-btn-primary w-100 mt-2" href="@Url.Action("Index","Signup", new { type = p.DemoSlug })">
                            <i class="bi bi-rocket-takeoff"></i> مثل این بساز
                        </a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="lf-why">
    <div class="container">
        <div class="row align-items-stretch g-4 lf-why-row">
            <div class="col-lg-6 d-flex flex-column">
                <h2>چرا نیکو سیستم آفرین؟</h2>
                <p class="lf-why-lead">تمرکز ما روی فروشگاه آماده، تجربه واقعی خرید و مسیر شفاف از دمو تا پرداخت است.</p>
                <ul class="lf-why-list">
                    <li><i class="bi bi-people"></i><span><strong>مشتریان وفادار</strong> راه‌حل پایدار برای رشد فروش آنلاین</span></li>
                    <li><i class="bi bi-cash-coin"></i><span><strong>قیمت منصفانه</strong> بدون هزینه پنهان و پیچیدگی اضافه</span></li>
                    <li><i class="bi bi-headset"></i><span><strong>پشتیبانی دائمی</strong> از راه‌اندازی تا استفاده روزمره</span></li>
                    <li><i class="bi bi-award"></i><span><strong>تجربه و تخصص</strong> فروشگاه واقعی با پنل مدیریت کامل</span></li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="lf-why-media">
                    <img src="~/Assets/img/why-nikoo.jpg" alt="چرا نیکو سیستم آفرین" loading="lazy" decoding="async" />
                </div>
            </div>
        </div>
    </div>
</section>

<section id="modules" class="lf-modules">
    <div class="container">
        <header class="lf-section-head">
            <h2>ماژول‌ها و امکانات</h2>
            <p>محصولات @site.SiteName این ماژول‌ها را آماده و فعال دارند</p>
        </header>
        @Html.Partial("_ModuleGrid", PlatformModules.All, new ViewDataDictionary { ["ShowOnly"] = true })
    </div>
</section>

<section id="steps" class="lf-steps">
    <div class="container">
        <header class="lf-section-head">
            <h2>از ثبت‌نام تا اولین فروش</h2>
            <p>همه مراحل را خودتان و بدون نیاز به پشتیبان انجام می‌دهید</p>
        </header>
        <div class="row align-items-center g-4">
            <div class="col-lg-5">
                <img class="lf-steps-img" src="~/Assets/img/features.png" alt="فرآیند خرید" loading="lazy" decoding="async" />
            </div>
            <div class="col-lg-7">
                <div class="lf-steps-grid">
                    <div class="lf-step"><span>۱</span><div><strong>ثبت‌نام رایگان</strong><em>نوع فروشگاه و آدرس آن را انتخاب کنید</em></div></div>
                    <div class="lf-step"><span>۲</span><div><strong>نام و لوگو</strong><em>فروشگاه بلافاصله با محتوای نمونه ساخته می‌شود</em></div></div>
                    <div class="lf-step"><span>۳</span><div><strong>انتخاب قالب</strong><em>ظاهر و رنگ‌ها را با یک کلیک عوض کنید</em></div></div>
                    <div class="lf-step"><span>۴</span><div><strong>افزودن محصولات</strong><em>عکس، قیمت و موجودی را وارد کنید</em></div></div>
                    <div class="lf-step"><span>۵</span><div><strong>درگاه و دامنه</strong><em>زرین‌پال و دامنه خودتان را وصل کنید</em></div></div>
                    <div class="lf-step"><span>۶</span><div><strong>اشتراک دلخواه</strong><em>سه‌ماهه، شش‌ماهه یا یک‌ساله؛ تمدید آنلاین از داخل پنل</em></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="lf-stats">
    <div class="container">
        <div class="lf-stats-wrap">
            <div class="lf-stats-grid">
                <div class="lf-stat">
                    <i class="bi bi-emoji-smile"></i>
                    <strong><span data-purecounter-start="0" data-purecounter-end="@site.StatSatisfaction" data-purecounter-duration="1" class="purecounter"></span>%</strong>
                    <span>رضایت مشتریان</span>
                </div>
                <div class="lf-stat">
                    <i class="bi bi-shop"></i>
                    <strong>+<span data-purecounter-start="0" data-purecounter-end="@site.StatDemos" data-purecounter-duration="1" class="purecounter"></span></strong>
                    <span>دموی فروشگاه</span>
                </div>
                <div class="lf-stat">
                    <i class="bi bi-people"></i>
                    <strong>+<span data-purecounter-start="0" data-purecounter-end="@site.StatCustomers" data-purecounter-duration="1" class="purecounter"></span></strong>
                    <span>مشتری راضی</span>
                </div>
                <div class="lf-stat">
                    <i class="bi bi-headset"></i>
                    <strong>+<span data-purecounter-start="0" data-purecounter-end="@site.StatSupportHours" data-purecounter-duration="1" class="purecounter"></span></strong>
                    <span>ساعت پشتیبانی</span>
                </div>
            </div>
            <aside class="lf-stats-cta">
                <h3>آماده شروع هستید؟</h3>
                <p>فروشگاهت را همین حالا بساز و @trialDays روز رایگان امتحانش کن.</p>
                <a class="lf-btn lf-btn-warm" href="@Url.Action("Index","Signup")">
                    ساخت فروشگاه رایگان <i class="bi bi-arrow-left"></i>
                </a>
            </aside>
        </div>
    </div>
</section>

@if (testimonials.Any())
{
    <section id="testimonials" class="lf-testimonials">
        <div class="container">
            <header class="lf-section-head">
                <h2>مشتریان ما چه می‌گویند</h2>
                <p>تجربه صاحبان فروشگاه‌هایی که با @site.SiteName شروع کردند</p>
            </header>
            <div class="row g-4">
                @foreach (var t in testimonials)
                {
                    <div class="col-md-6 col-lg-4">
                        <figure class="lf-quote">
                            <div class="lf-quote-stars" aria-label="امتیاز @t.Rating از ۵">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= t.Rating ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </div>
                            <blockquote>@t.Text</blockquote>
                            <figcaption>
                                @if (!string.IsNullOrEmpty(t.ImageUrl))
                                {
                                    <img src="@t.ImageUrl" alt="" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span class="lf-quote-avatar">@t.Name.Substring(0, 1)</span>
                                }
                                <span>
                                    <strong>@t.Name</strong>
                                    <em>@t.Role</em>
                                </span>
                            </figcaption>
                        </figure>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (posts.Any())
{
    <section id="blog" class="lf-blog-section">
        <div class="container">
            <header class="lf-section-head">
                <h2>تازه‌ترین مقاله‌ها</h2>
                <p>آموزش راه‌اندازی و رشد فروش آنلاین</p>
            </header>
            <div class="lf-store-grid">
                @foreach (var post in posts)
                {
                    @Html.Partial("~/Views/Blog/_BlogCard.cshtml", post)
                }
            </div>
            <p class="text-center mt-4 mb-0">
                <a class="lf-btn lf-btn-primary" href="@Url.RouteUrl("Blog")">همه مقاله‌ها <i class="bi bi-arrow-left"></i></a>
            </p>
        </div>
    </section>
}

@if (faqs.Any())
{
    <section id="faq" class="lf-faq">
        <div class="container">
            <header class="lf-section-head">
                <h2>سوالات متداول</h2>
                <p>پاسخ سوال‌هایی که بیشتر از ما می‌پرسند</p>
            </header>
            <div class="lf-faq-list">
                @foreach (var f in faqs)
                {
                    <details class="lf-faq-item">
                        <summary>@f.Question <i class="bi bi-chevron-down"></i></summary>
                        <div class="lf-faq-answer">@Html.TextBlocks(f.Answer)</div>
                    </details>
                }
            </div>
            <p class="text-center mt-4 mb-0">
                جواب سوالتان را پیدا نکردید؟ <a href="@Url.Action("Contact","Home")">با ما تماس بگیرید</a>
            </p>
        </div>
    </section>
}
