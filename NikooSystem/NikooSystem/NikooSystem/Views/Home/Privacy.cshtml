@{
    ViewBag.Title = "حریم خصوصی";
    ViewBag.Nav = "privacy";
    var site = NikooSystem.Services.SiteContentStore.Settings;
}
<main id="main">
    <div class="page-hero">
        <div class="container">
            <h1>سیاست حفظ حریم خصوصی</h1>
            <p class="text-muted mb-0">آخرین به‌روزرسانی: @site.UpdatedAt.ToShamsiText()</p>
        </div>
    </div>
    <section>
        <div class="container">
            <article class="inner-card legal-text">
                @Html.TextBlocks(site.PrivacyText)
            </article>
            @Html.Partial("_LegalContact")
        </div>
    </section>
</main>
