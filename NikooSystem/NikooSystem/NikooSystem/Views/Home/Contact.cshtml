@model NikooSystem.Models.ContactViewModel
@{
    ViewBag.Title = "تماس با ما";
    ViewBag.Nav = "contact";
    var site = NikooSystem.Services.SiteContentStore.Settings;
}
<main id="main">
    <div class="page-hero">
        <div class="container">
            <h1>تماس با ما</h1>
            <p class="text-muted">سوالی دارید؟ پیام بگذارید</p>
        </div>
    </div>
    <section class="contact">
        <div class="container">
            @Html.FlashMessages()
            <div class="row gy-4">
                <div class="col-lg-5">
                    @if (!string.IsNullOrWhiteSpace(site.Address))
                    {
                        <div class="info-box mb-3"><i class="bi bi-geo-alt"></i><h3>آدرس</h3><p>@Html.Lines(site.Address)@if (!string.IsNullOrWhiteSpace(site.PostalCode)) {<br /><span>کد پستی: <span dir="ltr">@site.PostalCode</span></span>}</p></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(site.Phone))
                    {
                        <div class="info-box mb-3"><i class="bi bi-telephone"></i><h3>تلفن</h3><p><a href="tel:@site.Phone.Replace("-", "").Replace(" ", "")" dir="ltr">@site.Phone</a></p></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(site.Email))
                    {
                        <div class="info-box mb-3"><i class="bi bi-envelope"></i><h3>ایمیل</h3><p><a href="mailto:@site.Email">@site.Email</a></p></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(site.WorkingHours))
                    {
                        <div class="info-box"><i class="bi bi-clock"></i><h3>ساعات پاسخگویی</h3><p>@site.WorkingHours</p></div>
                    }
                </div>
                <div class="col-lg-7">
                    <div class="inner-card">
                        @using (Html.BeginForm("Contact", "Home", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                            <div class="d-none" aria-hidden="true">
                                <label for="Website">وب‌سایت</label>
                                @Html.TextBoxFor(m => m.Website, new { tabindex = "-1", autocomplete = "off" })
                            </div>
                            <div class="row gy-3">
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.Name)
                                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "نام و نام خانوادگی" })
                                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.Email)
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "ایمیل", dir = "ltr" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.Phone)
                                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "مثلاً 09121234567", dir = "ltr", inputmode = "tel" })
                                    @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.Subject)
                                    @Html.TextBoxFor(m => m.Subject, new { @class = "form-control", placeholder = "موضوع" })
                                    @Html.ValidationMessageFor(m => m.Subject, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-12">
                                    @Html.LabelFor(m => m.Message)
                                    @Html.TextAreaFor(m => m.Message, 5, 1, new { @class = "form-control", placeholder = "پیام" })
                                    @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn-primary-shop">ارسال پیام</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
@section scripts {
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
